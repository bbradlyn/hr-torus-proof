/-!
# Fermion-model pilot, model (b): an abstract C⋆-algebra carrying the CAR

Written by Claude Opus 5.5 (an AI model), 2026-10-23. **A pilot.** The definitions and the twenty
statements were written first and reviewed against the paper (phase (a)) and are unchanged; phase (b)
added the proofs and the proof devices of the section `ProofDevices`. **Every theorem is proved; there is no
`sorry`.** The paper: the HR paper,
`papers/hr/sections/03-slot-frame.tex` (Definition 3.7 `def:slotfock`, Lemma 3.8 `lem:embedding`(iii)
for the gauge transformations), `papers/hr/sections/02-setting.tex` (Definition 2.5 `def:fock`: the
CAR, "even") and `papers/hr/sections/05-locality.tex` (Lemma 5.1 `lem:condexp` and its proof).
The companion file `HRTorus/Fermion/Pilot/JW.lean` states the same lemma in a concrete model.
The namespace is `HRTorus.Fermion.Pilot.Abstract` (not `…CAR`, which would repeat the name of the
definition `CARSystem.CAR`).

## The model

* Slots: any finite type `S`; spins `Spin = {up, dn}`; modes `S × Spin`.
* `CARSystem S A`: the slot annihilators `ĉ_{sσ}` as elements `c (s, σ)` of a C⋆-algebra `A`
  (Mathlib's `CStarAlgebra`), with the canonical anticommutation relations for the basis modes
  as fields, and the field `generates`: `A` is the C⋆-algebra generated by them — in the paper,
  "$\CAR(\Slots)$ is the algebra of all operators on $\FockS$" (proof of Lemma 5.1, eq. (5.1)
  for `Y = 𝒮`). No Hilbert space, no trace and no matrix units are assumed.
* `CAR Y`, `Alg Y`, the number operators: as in the paper. The parity `(-1)^{N̂↑+N̂↓}` is
  `e^{iπ(N̂↑+N̂↓)}` and the gauge unitaries are `e^{i(φ↑N̂↑+φ↓N̂↓)}`, both by Mathlib's exponential
  in the Banach algebra `A` (`NormedSpace.exp`).
* **The conditional expectation is defined without a Hilbert space, as a twirl** (the route of
  eq. (5.2) `eq:loc-twirl` of the paper's proof, an average of conjugations by unitaries). For one
  mode `μ`, with the Majorana operators `γ_μ = ĉ_μ + ĉ_μ^*`, `γ'_μ = i(ĉ_μ − ĉ_μ^*)`, the local
  parity `z_μ = 1 − 2ĉ_μ^*ĉ_μ` and the parity `P = (-1)^{N̂}`, the four unitaries
  `1, Pγ_μ, Pγ'_μ, z_μ` commute with every `ĉ_ν`, `ν ≠ μ` (the factor `P` makes the Majorana
  operators commute with the other modes), and
  `𝔼^{(μ)}(a) = ¼ (a + (Pγ_μ) a (Pγ_μ)^* + (Pγ'_μ) a (Pγ'_μ)^* + z_μ a z_μ^*)`
  removes the mode `μ`. `condExp Y` is the composition of the `𝔼^{(μ)}` over the modes `μ = (s, σ)`
  with `s ∉ Y` (in a fixed order; they commute). In the adapted numbering of the paper's proof, this
  is the paper's formula `\CE_Y(A)=4^{-(n-n_Y)}\sum_{\alpha\in\{0,1,2,3\}^{n-n_Y}}(\one\otimes\mathsf p_\alpha)\,A\,(\one\otimes\mathsf p_\alpha)^*`
  up to the choice of the four unitaries per mode (which leaves the average unchanged).
* The trace is not assumed either: `condExp ∅` is the normalized trace (times `1`), and the
  paper's defining property of `𝔼_Y` — "the orthogonal projection onto $\CAR(Y)$ for the
  Hilbert--Schmidt inner product" — is stated in terms of it (`condExp_empty_eq_smul_one`,
  `condExp_empty_mul_comm`, `condExp_empty_star_mul_self`, `condExp_empty_star_mul_sub`).
-/

open Complex
open scoped ComplexOrder

noncomputable section

namespace HRTorus.Fermion.Pilot.Abstract

/-- The spin label `σ ∈ {↑, ↓}`. -/
inductive Spin
  | up
  | dn
  deriving DecidableEq, Inhabited

/-- `Spin` is finite (written out: Mathlib's `deriving Fintype` handler fails on this toolchain). -/
instance : Fintype Spin where
  elems := {Spin.up, Spin.dn}
  complete := by intro x; cases x <;> simp

/-- A mode `(s, σ)`: a slot and a spin. -/
abbrev Mode (S : Type*) := S × Spin

/-- **Definition 3.7 (abstractly)**: the slot annihilators `ĉ_{sσ}` in a C⋆-algebra `A`, with the
canonical anticommutation relations of Definition 2.5 (`$\{c(f),c(g)^*\}=\ip fg$`,
`$\{c(f),c(g)\}=0$`) for the basis modes, generating `A`. -/
structure CARSystem (S : Type*) [Fintype S] [DecidableEq S] (A : Type*) [CStarAlgebra A] where
  /-- the annihilator `ĉ_{sσ}` of the mode `(s, σ)` -/
  c : Mode S → A
  /-- `{ĉ_μ, ĉ_ν} = 0` -/
  anticomm : ∀ μ ν, c μ * c ν + c ν * c μ = 0
  /-- `{ĉ_μ, ĉ_ν^*} = δ_{μν}` -/
  anticomm_star : ∀ μ ν, c μ * star (c ν) + star (c ν) * c μ = if μ = ν then 1 else 0
  /-- `A = CAR(𝒮)`: the annihilators generate `A` as a unital star algebra -/
  generates : StarAlgebra.adjoin ℂ (Set.range c) = ⊤

namespace CARSystem

variable {S : Type*} [Fintype S] [DecidableEq S] {A : Type*} [CStarAlgebra A]
variable (F : CARSystem S A)

/-! ## Number operators, parity, gauge, the local algebras -/

/-- **Definition 3.7**: `$\Nhat\sigma:=\sum_s\chat_{s\sigma}^*\chat_{s\sigma}$`. -/
def numberOp (σ : Spin) : A :=
  ∑ s : S, star (F.c (s, σ)) * F.c (s, σ)

/-- The parity `(-1)^{\Nhat\up+\Nhat\dn}`, as `e^{iπ(N̂↑+N̂↓)}`. -/
def parityU : A :=
  NormedSpace.exp (((Real.pi : ℂ) * I) • (F.numberOp .up + F.numberOp .dn))

/-- The gauge unitary `e^{\iu(\varphi_\up\Nhat\up+\varphi_\dn\Nhat\dn)}` for `φ = (φ↑, φ↓)` (here a
function `Spin → ℝ`). -/
def gaugeU (φ : Spin → ℝ) : A :=
  NormedSpace.exp ((I * (φ .up : ℂ)) • F.numberOp .up + (I * (φ .dn : ℂ)) • F.numberOp .dn)

/-- The parity automorphism (proof of Lemma 5.1): `A\mapsto(-1)^{\widehat N}A(-1)^{\widehat N}`. -/
def parity (a : A) : A :=
  F.parityU * a * F.parityU

/-- The gauge transformation of **Lemma 3.8(iii)** on `𝔉_𝒮`:
`e^{\iu(\varphi_\up\Nhat\up+\varphi_\dn\Nhat\dn)}\iota(A)e^{-\iu(\varphi_\up\Nhat\up+\varphi_\dn\Nhat\dn)}`
with `ι(A)` replaced by an arbitrary element `a`. -/
def gauge (φ : Spin → ℝ) (a : A) : A :=
  F.gaugeU φ * a * F.gaugeU (-φ)

/-- **Definition 2.5/3.7**: an element is even if it commutes with the parity
(`\emph{even} if it commutes with the parity $(-1)^{\Nup+\Ndn}$`). -/
def IsEven (a : A) : Prop :=
  Commute a F.parityU

/-- **Definition 3.7**: "For $X\subset\Slots$, $\CAR(X)$ is the unital $*$-algebra generated by the
$\chat_{s\sigma}$ with $s\in X$". -/
def CAR (Y : Finset S) : StarSubalgebra ℂ A :=
  StarAlgebra.adjoin ℂ {a | ∃ s ∈ Y, ∃ σ : Spin, a = F.c (s, σ)}

/-- **Definition 3.7**: "$\Alg(X)$ is its even part, the elements commuting with
$(-1)^{\Nhat\up+\Nhat\dn}$". -/
def Alg (Y : Finset S) : Set A :=
  {a | a ∈ F.CAR Y ∧ F.IsEven a}

/-! ## The conditional expectation, as a twirl -/

/-- The Majorana operator `γ_μ = ĉ_μ + ĉ_μ^*`. -/
def majorana (μ : Mode S) : A :=
  F.c μ + star (F.c μ)

/-- The Majorana operator `γ'_μ = i(ĉ_μ − ĉ_μ^*)`. -/
def majorana' (μ : Mode S) : A :=
  I • (F.c μ - star (F.c μ))

/-- The local parity `z_μ = 1 − 2ĉ_μ^*ĉ_μ` of the mode `μ` (the paper's `\mathsf z_{(j)}=\one-2a_j^*a_j`). -/
def localParity (μ : Mode S) : A :=
  1 - (2 : ℂ) • (star (F.c μ) * F.c μ)

/-- The twirl removing one mode `μ`:
`𝔼^{(μ)}(a) = ¼ (a + (Pγ_μ) a (Pγ_μ)^* + (Pγ'_μ) a (Pγ'_μ)^* + z_μ a z_μ^*)`, `P = (-1)^{N̂}`. -/
def twirl (μ : Mode S) (a : A) : A :=
  (4 : ℂ)⁻¹ • (a + (F.parityU * F.majorana μ) * a * star (F.parityU * F.majorana μ)
    + (F.parityU * F.majorana' μ) * a * star (F.parityU * F.majorana' μ)
    + F.localParity μ * a * star (F.localParity μ))

/-- The modes outside `Y`, in a fixed order. -/
def outsideModes (Y : Finset S) : List (Mode S) :=
  (Finset.univ.filter fun μ : Mode S => μ.1 ∉ Y).toList

/-- **Lemma 5.1** (the object): the conditional expectation onto `CAR(Y)`, defined as the
composition of the one-mode twirls over the modes outside `Y` (proof of Lemma 5.1: "an average of
conjugations by unitaries"). -/
def condExp (Y : Finset S) : A → A :=
  (outsideModes Y).foldr (fun μ f => F.twirl μ ∘ f) id

/-! ## Proof devices (phase (b))

Lemmas and auxiliary definitions used by the proofs below; none of them is a statement of the
paper. `HRTorus.IndexCore.exp_two_pi_I_smul_of_isIdempotentElem` (T-0051) is reused for `P² = 1`. -/

section ProofDevices

variable {F}

/-! ### Proof devices: the CAR relations in the forms used below -/

theorem c_mul_self (μ : Mode S) : F.c μ * F.c μ = 0 := by
  have h2 : (2 : ℂ) • (F.c μ * F.c μ) = 0 := by rw [two_smul]; exact F.anticomm μ μ
  exact (smul_eq_zero.mp h2).resolve_left two_ne_zero

theorem star_c_mul_star_c (μ : Mode S) : star (F.c μ) * star (F.c μ) = 0 := by
  rw [← star_mul, c_mul_self, star_zero]

theorem c_mul_star_c (μ : Mode S) : F.c μ * star (F.c μ) = 1 - star (F.c μ) * F.c μ := by
  have h := F.anticomm_star μ μ
  rw [ite_eq_left rfl] at h
  rw [← h, add_sub_cancel_right]

theorem c_mul_c_swap (μ ν : Mode S) : F.c μ * F.c ν = -(F.c ν * F.c μ) :=
  eq_neg_of_add_eq_zero_left (F.anticomm μ ν)

theorem c_mul_star_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    F.c μ * star (F.c ν) = -(star (F.c ν) * F.c μ) := by
  have := F.anticomm_star μ ν
  rw [ite_eq_right h] at this
  exact eq_neg_of_add_eq_zero_left this

theorem star_c_mul_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    star (F.c μ) * F.c ν = -(F.c ν * star (F.c μ)) := by
  have := F.anticomm_star ν μ
  rw [ite_eq_right (Ne.symm h)] at this
  exact eq_neg_of_add_eq_zero_right this

theorem star_c_mul_star_c_swap (μ ν : Mode S) :
    star (F.c μ) * star (F.c ν) = -(star (F.c ν) * star (F.c μ)) := by
  have := congrArg star (c_mul_c_swap (F := F) ν μ)
  simpa only [star_mul, star_neg] using this

/-- The occupation number `n_μ = ĉ_μ^* ĉ_μ` (a proof device). -/
def nOp (F : CARSystem S A) (μ : Mode S) : A :=
  star (F.c μ) * F.c μ

theorem nOp_mul_c_self (μ : Mode S) : F.nOp μ * F.c μ = 0 := by
  rw [nOp, mul_assoc, c_mul_self, mul_zero]

theorem c_mul_nOp_self (μ : Mode S) : F.c μ * F.nOp μ = F.c μ := by
  rw [nOp, ← mul_assoc, c_mul_star_c, sub_mul, one_mul, mul_assoc, c_mul_self, mul_zero, sub_zero]

theorem nOp_mul_c_of_ne {ν μ : Mode S} (h : ν ≠ μ) : F.nOp ν * F.c μ = F.c μ * F.nOp ν := by
  rw [nOp, mul_assoc, c_mul_c_swap ν μ, mul_neg, ← mul_assoc, star_c_mul_c_of_ne h, neg_mul,
    neg_neg, mul_assoc]

theorem nOp_mul_c (ν μ : Mode S) :
    F.nOp ν * F.c μ = F.c μ * F.nOp ν - (if ν = μ then F.c μ else 0) := by
  by_cases h : ν = μ
  · subst h; rw [ite_eq_left rfl, nOp_mul_c_self, c_mul_nOp_self, sub_self]
  · rw [ite_eq_right h, sub_zero, nOp_mul_c_of_ne h]

theorem isSelfAdjoint_nOp (μ : Mode S) : IsSelfAdjoint (F.nOp μ) :=
  IsSelfAdjoint.star_mul_self _

theorem nOp_mul_nOp (μ : Mode S) : F.nOp μ * F.nOp μ = F.nOp μ := by
  rw [nOp, mul_assoc, ← mul_assoc (F.c μ), c_mul_star_c, sub_mul, one_mul, mul_assoc,
    c_mul_self, mul_zero, sub_zero]

theorem nOp_mul_star_c_of_ne {ν μ : Mode S} (h : ν ≠ μ) :
    F.nOp ν * star (F.c μ) = star (F.c μ) * F.nOp ν := by
  have := congrArg star (nOp_mul_c_of_ne (F := F) h)
  simpa only [star_mul, (isSelfAdjoint_nOp ν).star_eq] using this.symm

theorem commute_nOp (ν μ : Mode S) : Commute (F.nOp ν) (F.nOp μ) := by
  by_cases h : ν = μ
  · subst h; exact Commute.refl _
  · show F.nOp ν * (star (F.c μ) * F.c μ) = star (F.c μ) * F.c μ * F.nOp ν
    rw [← mul_assoc, nOp_mul_star_c_of_ne h, mul_assoc, nOp_mul_c_of_ne h, mul_assoc]

/-! ### The number operators and the exponentials -/

theorem numberOp_eq_sum (σ : Spin) : F.numberOp σ = ∑ s : S, F.nOp (s, σ) := rfl

theorem numberOp_mul_c (σ : Spin) (μ : Mode S) :
    F.numberOp σ * F.c μ = F.c μ * F.numberOp σ - (if μ.2 = σ then F.c μ else 0) := by
  obtain ⟨t, τ⟩ := μ
  rw [numberOp_eq_sum, Finset.sum_mul, Finset.mul_sum]
  simp_rw [nOp_mul_c]
  rw [Finset.sum_sub_distrib]
  congr 1
  by_cases hτ : τ = σ
  · subst hτ
    simp only [Prod.mk.injEq, and_true, ite_true]
    rw [Finset.sum_ite_eq']
    simp
  · simp only [Prod.mk.injEq, Ne.symm hτ, and_false, ite_false, Finset.sum_const_zero, hτ]

theorem isSelfAdjoint_numberOp (σ : Spin) : IsSelfAdjoint (F.numberOp σ) :=
  isSelfAdjoint_sum _ fun s _ => isSelfAdjoint_nOp (s, σ)

/-- `e^X x = e^t x e^X` when `[X, x] = t x` (a proof device). -/
theorem exp_mul_of_commutator {X x : A} {t : ℂ} (h : X * x = x * X + t • x) :
    NormedSpace.exp X * x = Complex.exp t • (x * NormedSpace.exp X) := by
  let _ : NormedAlgebra ℚ A := NormedAlgebra.restrictScalars ℚ ℂ A
  have hs : SemiconjBy x (X + algebraMap ℂ A t) X := by
    show x * (X + algebraMap ℂ A t) = X * x
    rw [mul_add, h, Algebra.algebraMap_eq_smul_one, mul_smul_comm, mul_one]
  have := hs.exp_right
  rw [NormedSpace.exp_add_of_commute (Algebra.commute_algebraMap_right t X),
    ← NormedSpace.algebraMap_exp_comm] at this
  calc NormedSpace.exp X * x = x * (NormedSpace.exp X * algebraMap ℂ A (NormedSpace.exp t)) :=
        this.symm
    _ = Complex.exp t • (x * NormedSpace.exp X) := by
        rw [← mul_assoc, Algebra.algebraMap_eq_smul_one, mul_smul_comm, mul_one,
          Complex.exp_eq_exp_ℂ]

/-- The exponent of the gauge unitary. -/
def gaugeX (F : CARSystem S A) (φ : Spin → ℝ) : A :=
  (I * (φ .up : ℂ)) • F.numberOp .up + (I * (φ .dn : ℂ)) • F.numberOp .dn

theorem gaugeU_eq (φ : Spin → ℝ) : F.gaugeU φ = NormedSpace.exp (F.gaugeX φ) := rfl

theorem gaugeX_mul_c (φ : Spin → ℝ) (μ : Mode S) :
    F.gaugeX φ * F.c μ = F.c μ * F.gaugeX φ + (-(I * (φ μ.2 : ℂ))) • F.c μ := by
  obtain ⟨t, τ⟩ := μ
  simp only [gaugeX, add_mul, mul_add, smul_mul_assoc, mul_smul_comm, numberOp_mul_c]
  cases τ <;> simp [smul_sub] <;> abel

theorem parityX_mul_c (μ : Mode S) :
    (((Real.pi : ℂ) * I) • (F.numberOp .up + F.numberOp .dn)) * F.c μ =
      F.c μ * (((Real.pi : ℂ) * I) • (F.numberOp .up + F.numberOp .dn)) +
        (-((Real.pi : ℂ) * I)) • F.c μ := by
  obtain ⟨t, τ⟩ := μ
  simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, numberOp_mul_c, smul_add]
  cases τ <;> simp [smul_sub] <;> abel

theorem parityU_mul_c (μ : Mode S) : F.parityU * F.c μ = -(F.c μ * F.parityU) := by
  rw [parityU, exp_mul_of_commutator (parityX_mul_c μ)]
  rw [show -((Real.pi : ℂ) * I) = -(Real.pi * I) from rfl, Complex.exp_neg, Complex.exp_pi_mul_I]
  simp

theorem parityU_mem_unitary : F.parityU ∈ unitary A := by
  let _ : NormedAlgebra ℚ A := NormedAlgebra.restrictScalars ℚ ℂ A
  apply NormedSpace.exp_mem_unitary_of_mem_skewAdjoint
  refine ((isSelfAdjoint_numberOp .up).add (isSelfAdjoint_numberOp .dn)).smul_mem_skewAdjoint ?_
  rw [skewAdjoint.mem_iff, star_mul']
  simp only [Complex.star_def, Complex.conj_ofReal, Complex.conj_I]
  ring

/-! ### Gauge and parity -/

theorem gaugeX_neg (φ : Spin → ℝ) : F.gaugeX (-φ) = -F.gaugeX φ := by
  simp only [gaugeX, Pi.neg_apply, Complex.ofReal_neg, mul_neg, neg_smul, neg_add]

theorem gaugeU_mul_gaugeU_neg (φ : Spin → ℝ) : F.gaugeU φ * F.gaugeU (-φ) = 1 := by
  let _ : NormedAlgebra ℚ A := NormedAlgebra.restrictScalars ℚ ℂ A
  rw [gaugeU_eq, gaugeU_eq, gaugeX_neg,
    ← NormedSpace.exp_add_of_commute (Commute.neg_right (Commute.refl _)), add_neg_cancel,
    NormedSpace.exp_zero]

theorem gauge_c_dev (φ : Spin → ℝ) (s : S) (σ : Spin) :
    F.gauge φ (F.c (s, σ)) = Complex.exp (-(I * (φ σ : ℂ))) • F.c (s, σ) := by
  rw [gauge, gaugeU_eq φ, exp_mul_of_commutator (gaugeX_mul_c φ (s, σ)), smul_mul_assoc, mul_assoc,
    ← gaugeU_eq, gaugeU_mul_gaugeU_neg, mul_one]

theorem parityU_mul_star_c (μ : Mode S) :
    F.parityU * star (F.c μ) = -(star (F.c μ) * F.parityU) := by
  have h1 := congrArg star (parityU_mul_c (F := F) μ)
  simp only [star_mul, star_neg] at h1
  have hu := parityU_mem_unitary (F := F)
  have e1 := Unitary.star_mul_self_of_mem hu
  have e2 := Unitary.mul_star_self_of_mem hu
  calc F.parityU * star (F.c μ) = F.parityU * (star (F.c μ) * star F.parityU) * F.parityU := by
        rw [mul_assoc, mul_assoc, e1, mul_one]
    _ = F.parityU * (-(star F.parityU * star (F.c μ))) * F.parityU := by rw [h1]
    _ = -(star (F.c μ) * F.parityU) := by
        rw [mul_neg, neg_mul, ← mul_assoc, e2, one_mul]

theorem star_parityU_mul_c (μ : Mode S) : star F.parityU * F.c μ = -(F.c μ * star F.parityU) := by
  have h1 := congrArg star (parityU_mul_star_c (F := F) μ)
  simp only [star_mul, star_neg, star_star] at h1
  rw [h1, neg_neg]

/-! ### Majorana operators and local parities -/

theorem star_majorana (μ : Mode S) : star (F.majorana μ) = F.majorana μ := by
  rw [majorana, star_add, star_star, add_comm]

theorem majorana_mul_majorana (μ : Mode S) : F.majorana μ * F.majorana μ = 1 := by
  have h := F.anticomm_star μ μ
  rw [ite_eq_left rfl] at h
  rw [majorana, add_mul, mul_add, mul_add, c_mul_self, star_c_mul_star_c, zero_add, add_zero, h]

theorem star_majorana' (μ : Mode S) : star (F.majorana' μ) = F.majorana' μ := by
  rw [majorana', star_smul, star_sub, star_star, Complex.star_def, Complex.conj_I, neg_smul,
    ← smul_neg, neg_sub]

theorem majorana'_mul_majorana' (μ : Mode S) : F.majorana' μ * F.majorana' μ = 1 := by
  have h := F.anticomm_star μ μ
  rw [ite_eq_left rfl] at h
  have hX : (F.c μ - star (F.c μ)) * (F.c μ - star (F.c μ)) = -1 := by
    rw [sub_mul, mul_sub, mul_sub, c_mul_self, star_c_mul_star_c, ← h]; abel
  rw [majorana', smul_mul_smul_comm, hX, Complex.I_mul_I, smul_neg, neg_smul, one_smul, neg_neg]

theorem star_localParity (μ : Mode S) : star (F.localParity μ) = F.localParity μ := by
  rw [localParity, star_sub, star_one, star_smul, star_mul, star_star]
  congr 2
  simp

theorem localParity_mul_localParity (μ : Mode S) : F.localParity μ * F.localParity μ = 1 := by
  have hn : star (F.c μ) * F.c μ * (star (F.c μ) * F.c μ) = star (F.c μ) * F.c μ := nOp_mul_nOp μ
  rw [localParity, sub_mul, one_mul, mul_sub, mul_one, smul_mul_smul_comm, hn,
    show ((2 : ℂ) * 2) = 2 + 2 by norm_num, add_smul]
  abel

theorem majorana_mul_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    F.majorana μ * F.c ν = -(F.c ν * F.majorana μ) := by
  rw [majorana, add_mul, mul_add, c_mul_c_swap μ ν, star_c_mul_c_of_ne h, neg_add]

theorem majorana'_mul_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    F.majorana' μ * F.c ν = -(F.c ν * F.majorana' μ) := by
  rw [majorana', smul_mul_assoc, mul_smul_comm, sub_mul, mul_sub, c_mul_c_swap μ ν,
    star_c_mul_c_of_ne h, ← smul_neg]
  congr 1
  abel

theorem localParity_mul_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    F.localParity μ * F.c ν = F.c ν * F.localParity μ := by
  have hn : star (F.c μ) * F.c μ * F.c ν = F.c ν * (star (F.c μ) * F.c μ) := nOp_mul_c_of_ne h
  rw [localParity, sub_mul, mul_sub, one_mul, mul_one, smul_mul_assoc, mul_smul_comm, hn]

/-! ### The twirl unitaries -/

theorem majorana_mem_unitary (μ : Mode S) : F.majorana μ ∈ unitary A :=
  Unitary.mem_iff.mpr ⟨by rw [star_majorana, majorana_mul_majorana],
    by rw [star_majorana, majorana_mul_majorana]⟩

theorem majorana'_mem_unitary (μ : Mode S) : F.majorana' μ ∈ unitary A :=
  Unitary.mem_iff.mpr ⟨by rw [star_majorana', majorana'_mul_majorana'],
    by rw [star_majorana', majorana'_mul_majorana']⟩

theorem localParity_mem_unitary (μ : Mode S) : F.localParity μ ∈ unitary A :=
  Unitary.mem_iff.mpr ⟨by rw [star_localParity, localParity_mul_localParity],
    by rw [star_localParity, localParity_mul_localParity]⟩

theorem u1_mem_unitary (μ : Mode S) : F.parityU * F.majorana μ ∈ unitary A :=
  mul_mem parityU_mem_unitary (majorana_mem_unitary μ)

theorem u2_mem_unitary (μ : Mode S) : F.parityU * F.majorana' μ ∈ unitary A :=
  mul_mem parityU_mem_unitary (majorana'_mem_unitary μ)

theorem u1_mul_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    F.parityU * F.majorana μ * F.c ν = F.c ν * (F.parityU * F.majorana μ) := by
  rw [mul_assoc, majorana_mul_c_of_ne h, mul_neg, ← mul_assoc, parityU_mul_c, neg_mul, neg_neg,
    mul_assoc]

theorem u2_mul_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    F.parityU * F.majorana' μ * F.c ν = F.c ν * (F.parityU * F.majorana' μ) := by
  rw [mul_assoc, majorana'_mul_c_of_ne h, mul_neg, ← mul_assoc, parityU_mul_c, neg_mul, neg_neg,
    mul_assoc]

theorem star_u1_mul_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    star (F.parityU * F.majorana μ) * F.c ν = F.c ν * star (F.parityU * F.majorana μ) := by
  rw [star_mul, star_majorana, mul_assoc, star_parityU_mul_c, mul_neg, ← mul_assoc,
    majorana_mul_c_of_ne h, neg_mul, neg_neg, mul_assoc]

theorem star_u2_mul_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    star (F.parityU * F.majorana' μ) * F.c ν = F.c ν * star (F.parityU * F.majorana' μ) := by
  rw [star_mul, star_majorana', mul_assoc, star_parityU_mul_c, mul_neg, ← mul_assoc,
    majorana'_mul_c_of_ne h, neg_mul, neg_neg, mul_assoc]

/-! ### Averages of four conjugations -/

/-- The average of four conjugations (a proof device). -/
def avg4 (u₁ u₂ u₃ a : A) : A :=
  (4 : ℂ)⁻¹ • (a + u₁ * a * star u₁ + u₂ * a * star u₂ + u₃ * a * star u₃)

theorem twirl_eq_avg4 (μ : Mode S) (a : A) :
    F.twirl μ a = avg4 (F.parityU * F.majorana μ) (F.parityU * F.majorana' μ) (F.localParity μ) a :=
  rfl

section avg4

variable {u₁ u₂ u₃ : A}

theorem avg4_add (a b : A) : avg4 u₁ u₂ u₃ (a + b) = avg4 u₁ u₂ u₃ a + avg4 u₁ u₂ u₃ b := by
  simp only [avg4, mul_add, add_mul, ← smul_add]
  congr 1
  abel

theorem avg4_smul (r : ℂ) (a : A) : avg4 u₁ u₂ u₃ (r • a) = r • avg4 u₁ u₂ u₃ a := by
  simp only [avg4, mul_smul_comm, smul_mul_assoc, ← smul_add]
  rw [smul_comm]

theorem avg4_star (a : A) : avg4 u₁ u₂ u₃ (star a) = star (avg4 u₁ u₂ u₃ a) := by
  simp only [avg4, star_smul, star_add, star_mul, star_star, mul_assoc]
  congr 1
  simp

theorem conj_of_commute {u a : A} (hu : u * star u = 1) (h : Commute u a) : u * a * star u = a := by
  rw [h.eq, mul_assoc, hu, mul_one]

theorem avg4_of_commute (h₁ : u₁ * star u₁ = 1) (h₂ : u₂ * star u₂ = 1) (h₃ : u₃ * star u₃ = 1)
    {a : A} (c₁ : Commute u₁ a) (c₂ : Commute u₂ a) (c₃ : Commute u₃ a) : avg4 u₁ u₂ u₃ a = a := by
  rw [avg4, conj_of_commute h₁ c₁, conj_of_commute h₂ c₂, conj_of_commute h₃ c₃,
    show a + a + a + a = (4 : ℂ) • a by
      rw [show (4 : ℂ) = 1 + 1 + 1 + 1 by norm_num, add_smul, add_smul, add_smul, one_smul],
    smul_smul, inv_mul_cancel₀ (by norm_num : (4 : ℂ) ≠ 0), one_smul]

theorem norm_conj_unitary {u : A} (hu : u ∈ unitary A) (a : A) : ‖u * a * star u‖ = ‖a‖ :=
  (CStarRing.norm_mul_coe_unitary (u * a) ⟨star u, Unitary.star_mem hu⟩).trans
    (CStarRing.norm_coe_unitary_mul ⟨u, hu⟩ a)

theorem norm_avg4_le (h₁ : u₁ ∈ unitary A) (h₂ : u₂ ∈ unitary A) (h₃ : u₃ ∈ unitary A) (a : A) :
    ‖avg4 u₁ u₂ u₃ a‖ ≤ ‖a‖ := by
  have hs : ‖a + u₁ * a * star u₁ + u₂ * a * star u₂ + u₃ * a * star u₃‖ ≤ 4 * ‖a‖ := by
    calc ‖a + u₁ * a * star u₁ + u₂ * a * star u₂ + u₃ * a * star u₃‖
        ≤ ‖a + u₁ * a * star u₁ + u₂ * a * star u₂‖ + ‖u₃ * a * star u₃‖ := norm_add_le _ _
      _ ≤ ‖a + u₁ * a * star u₁‖ + ‖u₂ * a * star u₂‖ + ‖u₃ * a * star u₃‖ := by
          gcongr; exact norm_add_le _ _
      _ ≤ ‖a‖ + ‖u₁ * a * star u₁‖ + ‖u₂ * a * star u₂‖ + ‖u₃ * a * star u₃‖ := by
          gcongr; exact norm_add_le _ _
      _ = 4 * ‖a‖ := by rw [norm_conj_unitary h₁, norm_conj_unitary h₂, norm_conj_unitary h₃]; ring
  rw [avg4, norm_smul]
  have h4 : ‖(4 : ℂ)⁻¹‖ = 4⁻¹ := by norm_num
  rw [h4]
  linarith [norm_nonneg a]

theorem avg4_nonneg [PartialOrder A] [StarOrderedRing A] {a : A} (ha : 0 ≤ a) :
    0 ≤ avg4 u₁ u₂ u₃ a := by
  have hs : 0 ≤ a + u₁ * a * star u₁ + u₂ * a * star u₂ + u₃ * a * star u₃ :=
    add_nonneg (add_nonneg (add_nonneg ha (star_right_conjugate_nonneg ha _))
      (star_right_conjugate_nonneg ha _)) (star_right_conjugate_nonneg ha _)
  have e : avg4 u₁ u₂ u₃ a = star ((2 : ℂ)⁻¹ • (1 : A)) *
      (a + u₁ * a * star u₁ + u₂ * a * star u₂ + u₃ * a * star u₃) * ((2 : ℂ)⁻¹ • (1 : A)) := by
    rw [avg4, star_smul, star_one, smul_mul_assoc, one_mul, mul_smul_comm, mul_one, smul_smul]
    congr 1
    simp only [star_inv₀, Complex.star_def, map_ofNat]
    norm_num
  rw [e]
  exact star_left_conjugate_nonneg hs _

end avg4

/-! ### The twirl fixes the algebras of the other modes -/

theorem CAR_le_centralizer {μ : Mode S} {Y : Finset S} (hμ : μ.1 ∉ Y) :
    F.CAR Y ≤ StarSubalgebra.centralizer ℂ
      {F.parityU * F.majorana μ, F.parityU * F.majorana' μ, F.localParity μ} := by
  apply StarAlgebra.adjoin_le
  rintro x ⟨s, hs, σ, rfl⟩
  have hne : μ ≠ (s, σ) := fun h => hμ (by rw [h]; exact hs)
  rw [SetLike.mem_coe, StarSubalgebra.mem_centralizer_iff]
  intro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl | rfl
  · exact ⟨u1_mul_c_of_ne hne, star_u1_mul_c_of_ne hne⟩
  · exact ⟨u2_mul_c_of_ne hne, star_u2_mul_c_of_ne hne⟩
  · exact ⟨localParity_mul_c_of_ne hne, by rw [star_localParity]; exact localParity_mul_c_of_ne hne⟩

theorem twirl_of_mem_CAR {μ : Mode S} {Y : Finset S} (hμ : μ.1 ∉ Y) {x : A} (hx : x ∈ F.CAR Y) :
    F.twirl μ x = x := by
  have hc := CAR_le_centralizer hμ hx
  rw [StarSubalgebra.mem_centralizer_iff] at hc
  rw [twirl_eq_avg4]
  exact avg4_of_commute (Unitary.mul_star_self_of_mem (u1_mem_unitary μ))
    (Unitary.mul_star_self_of_mem (u2_mem_unitary μ))
    (Unitary.mul_star_self_of_mem (localParity_mem_unitary μ))
    (hc _ (by simp)).1 (hc _ (by simp)).1 (hc _ (by simp)).1

/-! ### Compositions of twirls -/

/-- The composition of the twirls over a list of modes (a proof device). -/
def twirlList (F : CARSystem S A) (l : List (Mode S)) : A → A :=
  l.foldr (fun μ f => F.twirl μ ∘ f) id

theorem condExp_eq_twirlList (Y : Finset S) : F.condExp Y = F.twirlList (outsideModes Y) := rfl

theorem twirlList_cons (μ : Mode S) (l : List (Mode S)) (a : A) :
    F.twirlList (μ :: l) a = F.twirl μ (F.twirlList l a) := rfl

theorem twirlList_nil (a : A) : F.twirlList [] a = a := rfl

theorem twirlList_add (l : List (Mode S)) (a b : A) :
    F.twirlList l (a + b) = F.twirlList l a + F.twirlList l b := by
  induction l with
  | nil => rfl
  | cons μ l ih => rw [twirlList_cons, twirlList_cons, twirlList_cons, ih, twirl_eq_avg4, avg4_add]; rfl

theorem twirlList_smul (l : List (Mode S)) (r : ℂ) (a : A) :
    F.twirlList l (r • a) = r • F.twirlList l a := by
  induction l with
  | nil => rfl
  | cons μ l ih => rw [twirlList_cons, twirlList_cons, ih, twirl_eq_avg4, avg4_smul]; rfl

theorem twirlList_star (l : List (Mode S)) (a : A) :
    F.twirlList l (star a) = star (F.twirlList l a) := by
  induction l with
  | nil => rfl
  | cons μ l ih => rw [twirlList_cons, twirlList_cons, ih, twirl_eq_avg4, avg4_star]; rfl

theorem norm_twirlList_le (l : List (Mode S)) (a : A) : ‖F.twirlList l a‖ ≤ ‖a‖ := by
  induction l with
  | nil => exact le_rfl
  | cons μ l ih =>
    rw [twirlList_cons, twirl_eq_avg4]
    exact (norm_avg4_le (u1_mem_unitary μ) (u2_mem_unitary μ) (localParity_mem_unitary μ) _).trans ih

theorem twirlList_nonneg [PartialOrder A] [StarOrderedRing A] (l : List (Mode S)) {a : A}
    (ha : 0 ≤ a) : 0 ≤ F.twirlList l a := by
  induction l with
  | nil => exact ha
  | cons μ l ih => rw [twirlList_cons, twirl_eq_avg4]; exact avg4_nonneg ih

theorem twirlList_of_mem_CAR {l : List (Mode S)} {Y : Finset S} (hl : ∀ μ ∈ l, μ.1 ∉ Y) {x : A}
    (hx : x ∈ F.CAR Y) : F.twirlList l x = x := by
  induction l with
  | nil => rfl
  | cons μ l ih =>
    rw [twirlList_cons, ih (fun ν hν => hl ν (List.mem_cons_of_mem _ hν))]
    exact twirl_of_mem_CAR (hl μ List.mem_cons_self) hx

theorem mem_outsideModes {Y : Finset S} {μ : Mode S} : μ ∈ outsideModes Y ↔ μ.1 ∉ Y := by
  simp [outsideModes, Finset.mem_toList]

theorem condExp_of_mem_CAR {Y : Finset S} {x : A} (hx : x ∈ F.CAR Y) : F.condExp Y x = x :=
  twirlList_of_mem_CAR (fun _ h => mem_outsideModes.mp h) hx

/-! ### The clauses that follow -/

theorem condExp_isLinearMap_dev (Y : Finset S) : IsLinearMap ℂ (F.condExp Y) :=
  ⟨twirlList_add _, twirlList_smul _⟩

theorem condExp_one_dev (Y : Finset S) : F.condExp Y 1 = 1 :=
  condExp_of_mem_CAR (one_mem _)

theorem condExp_nonneg_dev [PartialOrder A] [StarOrderedRing A] (Y : Finset S) {a : A} (ha : 0 ≤ a) :
    0 ≤ F.condExp Y a :=
  twirlList_nonneg _ ha

theorem norm_condExp_le_dev (Y : Finset S) (a : A) : ‖F.condExp Y a‖ ≤ ‖a‖ :=
  norm_twirlList_le _ a

theorem condExp_star_dev (Y : Finset S) (a : A) : F.condExp Y (star a) = star (F.condExp Y a) :=
  twirlList_star _ a

theorem norm_sub_condExp_le_two_mul (Y : Finset S) (a : A) {a' : A} (ha' : a' ∈ F.Alg Y) :
    ‖a - F.condExp Y a‖ ≤ 2 * ‖a - a'‖ := by
  have hfix : F.condExp Y a' = a' := condExp_of_mem_CAR ha'.1
  have e : a - F.condExp Y a = (a - a') - F.condExp Y (a - a') := by
    rw [(condExp_isLinearMap_dev Y).map_sub, hfix]; abel
  rw [e]
  calc ‖(a - a') - F.condExp Y (a - a')‖ ≤ ‖a - a'‖ + ‖F.condExp Y (a - a')‖ := norm_sub_le _ _
    _ ≤ ‖a - a'‖ + ‖a - a'‖ := by gcongr; exact norm_condExp_le_dev Y _
    _ = 2 * ‖a - a'‖ := by ring

theorem norm_sub_condExp_le_dev (Y : Finset S) {a : A} (_ha : F.IsEven a) :
    ‖a - F.condExp Y a‖ ≤ 2 * ⨅ a' : F.Alg Y, ‖a - (a' : A)‖ := by
  have hne : Nonempty (F.Alg Y) := ⟨⟨0, zero_mem _, Commute.zero_left _⟩⟩
  have h : ‖a - F.condExp Y a‖ / 2 ≤ ⨅ a' : F.Alg Y, ‖a - (a' : A)‖ :=
    le_ciInf fun a' => by
      have := norm_sub_condExp_le_two_mul Y a a'.2
      linarith
  linarith

/-! ### The parity automorphism -/

theorem exp_two_pi_I_smul_sum_nOp (σ : Spin) (T : Finset S) :
    NormedSpace.exp ((2 * (Real.pi : ℂ) * I) • ∑ s ∈ T, F.nOp (s, σ)) = 1 := by
  let _ : NormedAlgebra ℚ A := NormedAlgebra.restrictScalars ℚ ℂ A
  induction T using Finset.induction_on with
  | empty => simp
  | insert a T ha ih =>
    rw [Finset.sum_insert ha, smul_add, NormedSpace.exp_add_of_commute, ih, mul_one]
    · exact HRTorus.IndexCore.exp_two_pi_I_smul_of_isIdempotentElem (nOp_mul_nOp (a, σ))
    · exact ((Commute.sum_right _ _ _ fun s _ => commute_nOp (a, σ) (s, σ)).smul_left _).smul_right _

theorem parityU_mul_parityU_dev : F.parityU * F.parityU = 1 := by
  let _ : NormedAlgebra ℚ A := NormedAlgebra.restrictScalars ℚ ℂ A
  have hc : Commute (F.numberOp .up) (F.numberOp .dn) :=
    Commute.sum_left _ _ _ fun s _ => Commute.sum_right _ _ _ fun t _ => commute_nOp _ _
  rw [parityU, ← NormedSpace.exp_add_of_commute (Commute.refl _), ← add_smul,
    show ((Real.pi : ℂ) * I + Real.pi * I) = 2 * Real.pi * I by ring, smul_add,
    NormedSpace.exp_add_of_commute ((hc.smul_left _).smul_right _),
    numberOp_eq_sum, numberOp_eq_sum, exp_two_pi_I_smul_sum_nOp, exp_two_pi_I_smul_sum_nOp, mul_one]

theorem star_parityU_dev : star F.parityU = F.parityU := by
  calc star F.parityU = star F.parityU * (F.parityU * F.parityU) := by
        rw [parityU_mul_parityU_dev, mul_one]
    _ = F.parityU := by rw [← mul_assoc, Unitary.star_mul_self_of_mem parityU_mem_unitary, one_mul]

theorem parity_c_dev (μ : Mode S) : F.parity (F.c μ) = -F.c μ := by
  rw [parity, parityU_mul_c, neg_mul, mul_assoc, parityU_mul_parityU_dev, mul_one]

theorem parity_star_c (μ : Mode S) : F.parity (star (F.c μ)) = -star (F.c μ) := by
  rw [parity, parityU_mul_star_c, neg_mul, mul_assoc, parityU_mul_parityU_dev, mul_one]

theorem parity_mul (x y : A) : F.parity (x * y) = F.parity x * F.parity y := by
  calc F.parity (x * y) = F.parityU * x * (F.parityU * F.parityU) * y * F.parityU := by
        rw [parityU_mul_parityU_dev, mul_one, parity, mul_assoc F.parityU x y]
    _ = F.parity x * F.parity y := by simp only [parity, mul_assoc]

theorem parity_add (x y : A) : F.parity (x + y) = F.parity x + F.parity y := by
  simp only [parity, mul_add, add_mul]

theorem parity_neg (x : A) : F.parity (-x) = -F.parity x := by
  simp only [parity, mul_neg, neg_mul]

theorem parity_sub (x y : A) : F.parity (x - y) = F.parity x - F.parity y := by
  simp only [parity, mul_sub, sub_mul]

theorem parity_algebraMap (r : ℂ) : F.parity (algebraMap ℂ A r) = algebraMap ℂ A r := by
  rw [parity, mul_assoc, Algebra.commutes, ← mul_assoc, parityU_mul_parityU_dev, one_mul]

theorem parity_one : F.parity 1 = 1 := by
  simpa using parity_algebraMap (F := F) 1

theorem parity_parity (x : A) : F.parity (F.parity x) = x := by
  simp only [parity]
  calc F.parityU * (F.parityU * x * F.parityU) * F.parityU
      = (F.parityU * F.parityU) * x * (F.parityU * F.parityU) := by simp only [mul_assoc]
    _ = x := by rw [parityU_mul_parityU_dev, one_mul, mul_one]

theorem parity_nOp (μ : Mode S) : F.parity (F.nOp μ) = F.nOp μ := by
  rw [nOp, parity_mul, parity_star_c, parity_c_dev, neg_mul_neg]

/-! ### The algebra of a set of modes -/

/-- The unital star algebra generated by the annihilators of a set of modes (a proof device). -/
def CARm (F : CARSystem S A) (M : Set (Mode S)) : StarSubalgebra ℂ A :=
  StarAlgebra.adjoin ℂ (F.c '' M)

theorem CAR_eq_CARm (Y : Finset S) : F.CAR Y = F.CARm {μ | μ.1 ∈ Y} := by
  unfold CAR CARm
  congr 1
  ext a
  constructor
  · rintro ⟨s, hs, σ, rfl⟩; exact ⟨(s, σ), hs, rfl⟩
  · rintro ⟨μ, hμ, rfl⟩; exact ⟨μ.1, hμ, μ.2, rfl⟩

theorem CARm_univ : F.CARm Set.univ = ⊤ := by
  rw [CARm, Set.image_univ]; exact F.generates

theorem c_mem_CARm {M : Set (Mode S)} {ν : Mode S} (h : ν ∈ M) : F.c ν ∈ F.CARm M :=
  StarAlgebra.subset_adjoin ℂ _ ⟨ν, h, rfl⟩

theorem star_c_mem_CARm {M : Set (Mode S)} {ν : Mode S} (h : ν ∈ M) : star (F.c ν) ∈ F.CARm M :=
  star_mem (c_mem_CARm h)

theorem CARm_induction {M : Set (Mode S)} {p : A → Prop}
    (hc : ∀ ν ∈ M, p (F.c ν)) (hcs : ∀ ν ∈ M, p (star (F.c ν)))
    (halg : ∀ r : ℂ, p (algebraMap ℂ A r)) (hadd : ∀ x y, p x → p y → p (x + y))
    (hmul : ∀ x y, p x → p y → p (x * y)) {x : A} (hx : x ∈ F.CARm M) : p x := by
  have hx' : x ∈ Algebra.adjoin ℂ (F.c '' M ∪ star (F.c '' M)) := hx
  refine Algebra.adjoin_induction (p := fun x _ => p x) ?_ ?_ ?_ ?_ hx'
  · intro x hx
    rcases hx with ⟨ν, hν, rfl⟩ | hx
    · exact hc ν hν
    · obtain ⟨ν, hν, h⟩ := hx
      rw [← star_star x, ← h]
      exact hcs ν hν
  · intro r; exact halg r
  · intro x y _ _ hx hy; exact hadd x y hx hy
  · intro x y _ _ hx hy; exact hmul x y hx hy

theorem parity_mem_CARm {M : Set (Mode S)} {x : A} (hx : x ∈ F.CARm M) : F.parity x ∈ F.CARm M := by
  refine CARm_induction (p := fun x => F.parity x ∈ F.CARm M) ?_ ?_ ?_ ?_ ?_ hx
  · intro ν hν; rw [parity_c_dev]; exact neg_mem (c_mem_CARm hν)
  · intro ν hν; rw [parity_star_c]; exact neg_mem (star_c_mem_CARm hν)
  · intro r; rw [parity_algebraMap]; exact algebraMap_mem _ r
  · intro x y hx hy; rw [parity_add]; exact add_mem hx hy
  · intro x y hx hy; rw [parity_mul]; exact mul_mem hx hy

theorem c_mul_of_mem_CARm {μ : Mode S} {M : Set (Mode S)} (hμ : μ ∉ M) {b : A}
    (hb : b ∈ F.CARm M) :
    F.c μ * b = F.parity b * F.c μ ∧ star (F.c μ) * b = F.parity b * star (F.c μ) := by
  refine CARm_induction (p := fun b => F.c μ * b = F.parity b * F.c μ ∧
    star (F.c μ) * b = F.parity b * star (F.c μ)) ?_ ?_ ?_ ?_ ?_ hb
  · intro ν hν
    have hne : μ ≠ ν := fun h => hμ (h ▸ hν)
    rw [parity_c_dev]
    exact ⟨by rw [c_mul_c_swap, neg_mul], by rw [star_c_mul_c_of_ne hne, neg_mul]⟩
  · intro ν hν
    have hne : μ ≠ ν := fun h => hμ (h ▸ hν)
    rw [parity_star_c]
    exact ⟨by rw [c_mul_star_c_of_ne hne, neg_mul], by rw [star_c_mul_star_c_swap, neg_mul]⟩
  · intro r
    rw [parity_algebraMap]
    exact ⟨(Algebra.commutes r _).symm, (Algebra.commutes r _).symm⟩
  · rintro x y ⟨h1, h2⟩ ⟨h3, h4⟩
    rw [parity_add]
    exact ⟨by rw [mul_add, h1, h3, add_mul], by rw [mul_add, h2, h4, add_mul]⟩
  · rintro x y ⟨h1, h2⟩ ⟨h3, h4⟩
    rw [parity_mul]
    exact ⟨by rw [← mul_assoc, h1, mul_assoc, h3, ← mul_assoc],
      by rw [← mul_assoc, h2, mul_assoc, h4, ← mul_assoc]⟩

theorem CARm_le_centralizer {μ : Mode S} {M : Set (Mode S)} (hμ : μ ∉ M) :
    F.CARm M ≤ StarSubalgebra.centralizer ℂ
      {F.parityU * F.majorana μ, F.parityU * F.majorana' μ, F.localParity μ} := by
  apply StarAlgebra.adjoin_le
  rintro x ⟨ν, hν, rfl⟩
  have hne : μ ≠ ν := fun h => hμ (h ▸ hν)
  rw [SetLike.mem_coe, StarSubalgebra.mem_centralizer_iff]
  intro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl | rfl
  · exact ⟨u1_mul_c_of_ne hne, star_u1_mul_c_of_ne hne⟩
  · exact ⟨u2_mul_c_of_ne hne, star_u2_mul_c_of_ne hne⟩
  · exact ⟨localParity_mul_c_of_ne hne, by rw [star_localParity]; exact localParity_mul_c_of_ne hne⟩

theorem twirl_of_mem_CARm' {μ : Mode S} {M : Set (Mode S)} (hμ : μ ∉ M) {x : A} (hx : x ∈ F.CARm M) :
    F.twirl μ x = x := by
  have hc := CARm_le_centralizer hμ hx
  rw [StarSubalgebra.mem_centralizer_iff] at hc
  rw [twirl_eq_avg4]
  exact avg4_of_commute (Unitary.mul_star_self_of_mem (u1_mem_unitary μ))
    (Unitary.mul_star_self_of_mem (u2_mem_unitary μ))
    (Unitary.mul_star_self_of_mem (localParity_mem_unitary μ))
    (hc _ (by simp)).1 (hc _ (by simp)).1 (hc _ (by simp)).1

/-! ### The twirl on the mode it removes -/

theorem conj_u1 (μ : Mode S) (x : A) :
    F.parityU * F.majorana μ * x * star (F.parityU * F.majorana μ) =
      F.parity (F.majorana μ * x * F.majorana μ) := by
  rw [star_mul, star_majorana, star_parityU_dev, parity]; simp only [mul_assoc]

theorem conj_u2 (μ : Mode S) (x : A) :
    F.parityU * F.majorana' μ * x * star (F.parityU * F.majorana' μ) =
      F.parity (F.majorana' μ * x * F.majorana' μ) := by
  rw [star_mul, star_majorana', star_parityU_dev, parity]; simp only [mul_assoc]

theorem star_c_mul_c_mul_star_c (μ : Mode S) :
    star (F.c μ) * F.c μ * star (F.c μ) = star (F.c μ) := by
  rw [mul_assoc, c_mul_star_c, mul_sub, mul_one, ← mul_assoc, star_c_mul_star_c, zero_mul, sub_zero]

theorem c_mul_star_c_mul_c (μ : Mode S) : F.c μ * star (F.c μ) * F.c μ = F.c μ := by
  rw [c_mul_star_c, sub_mul, one_mul, mul_assoc, c_mul_self, mul_zero, sub_zero]

theorem majorana_c_majorana (μ : Mode S) :
    F.majorana μ * F.c μ * F.majorana μ = star (F.c μ) := by
  rw [majorana, add_mul, c_mul_self, zero_add, mul_add, mul_assoc, c_mul_self, mul_zero, zero_add,
    star_c_mul_c_mul_star_c]

theorem majorana'_c_majorana' (μ : Mode S) :
    F.majorana' μ * F.c μ * F.majorana' μ = -star (F.c μ) := by
  rw [majorana', smul_mul_assoc, smul_mul_assoc, mul_smul_comm, smul_smul, Complex.I_mul_I,
    sub_mul, c_mul_self, zero_sub, neg_mul, mul_sub, mul_assoc, c_mul_self, mul_zero, zero_sub,
    star_c_mul_c_mul_star_c, neg_neg, neg_one_smul]

theorem localParity_c_localParity (μ : Mode S) :
    F.localParity μ * F.c μ * F.localParity μ = -F.c μ := by
  have h1 : F.localParity μ * F.c μ = F.c μ := by
    rw [localParity, sub_mul, one_mul, smul_mul_assoc, mul_assoc, c_mul_self, mul_zero, smul_zero,
      sub_zero]
  rw [h1, localParity, mul_sub, mul_one, mul_smul_comm, ← mul_assoc, c_mul_star_c_mul_c,
    two_smul, sub_add_cancel_left]

theorem majorana_nOp_majorana (μ : Mode S) :
    F.majorana μ * F.nOp μ * F.majorana μ = 1 - F.nOp μ := by
  have h1 : F.majorana μ * F.nOp μ = F.c μ := by
    rw [majorana, nOp, add_mul, ← mul_assoc, c_mul_star_c_mul_c, ← mul_assoc, star_c_mul_star_c,
      zero_mul, add_zero]
  rw [h1, majorana, mul_add, c_mul_self, zero_add]
  exact c_mul_star_c μ

theorem majorana'_nOp_majorana' (μ : Mode S) :
    F.majorana' μ * F.nOp μ * F.majorana' μ = 1 - F.nOp μ := by
  have e : F.c μ * star (F.c μ) = 1 - F.nOp μ := c_mul_star_c μ
  have h1 : (F.c μ - star (F.c μ)) * F.nOp μ = F.c μ := by
    rw [nOp, sub_mul, ← mul_assoc, c_mul_star_c_mul_c, ← mul_assoc, star_c_mul_star_c, zero_mul,
      sub_zero]
  rw [majorana', smul_mul_assoc, smul_mul_assoc, mul_smul_comm, smul_smul, Complex.I_mul_I, h1,
    mul_sub, c_mul_self, zero_sub, e, neg_one_smul, neg_neg]

theorem localParity_nOp_localParity (μ : Mode S) :
    F.localParity μ * F.nOp μ * F.localParity μ = F.nOp μ := by
  have hz : F.localParity μ * F.nOp μ = F.nOp μ * F.localParity μ := by
    simp only [localParity, sub_mul, mul_sub, one_mul, mul_one, smul_mul_assoc, mul_smul_comm]
    rfl
  rw [hz, mul_assoc, localParity_mul_localParity, mul_one]

theorem twirl_c_self (μ : Mode S) : F.twirl μ (F.c μ) = 0 := by
  rw [twirl_eq_avg4, avg4, conj_u1, conj_u2, star_localParity, majorana_c_majorana,
    majorana'_c_majorana', localParity_c_localParity, parity_neg, parity_star_c, neg_neg]
  rw [show F.c μ + -star (F.c μ) + star (F.c μ) + -F.c μ = 0 by abel, smul_zero]

theorem twirl_star_c_self (μ : Mode S) : F.twirl μ (star (F.c μ)) = 0 := by
  rw [twirl_eq_avg4, avg4_star, ← twirl_eq_avg4, twirl_c_self, star_zero]

theorem twirl_nOp_self (μ : Mode S) : F.twirl μ (F.nOp μ) = (2 : ℂ)⁻¹ • (1 : A) := by
  rw [twirl_eq_avg4, avg4, conj_u1, conj_u2, star_localParity, majorana_nOp_majorana,
    majorana'_nOp_majorana', localParity_nOp_localParity, parity_sub, parity_one, parity_nOp]
  rw [show F.nOp μ + (1 - F.nOp μ) + (1 - F.nOp μ) + F.nOp μ = (2 : ℂ) • (1 : A) by
    rw [two_smul]; abel, smul_smul]
  norm_num

/-! ### The range lemma -/

theorem twirl_add (μ : Mode S) (a b : A) : F.twirl μ (a + b) = F.twirl μ a + F.twirl μ b := by
  rw [twirl_eq_avg4, twirl_eq_avg4, twirl_eq_avg4, avg4_add]

theorem twirl_mul_left {μ : Mode S} {M : Set (Mode S)} (hμ : μ ∉ M) {b : A} (hb : b ∈ F.CARm M)
    (x : A) : F.twirl μ (b * x) = b * F.twirl μ x := by
  have hc := CARm_le_centralizer hμ hb
  rw [StarSubalgebra.mem_centralizer_iff] at hc
  have h1 := (hc (F.parityU * F.majorana μ) (by simp)).1
  have h2 := (hc (F.parityU * F.majorana' μ) (by simp)).1
  have h3 := (hc (F.localParity μ) (by simp)).1
  rw [twirl_eq_avg4, twirl_eq_avg4, avg4, avg4, mul_smul_comm]
  congr 1
  simp only [mul_add, ← mul_assoc]
  rw [h1, h2, h3]
  simp only [mul_assoc]

/-- The four-term decompositions over the algebra of the other modes (a proof device). -/
def Wset (F : CARSystem S A) (μ : Mode S) (M : Set (Mode S)) : Set A :=
  {x | ∃ b₀ ∈ F.CARm (M \ {μ}), ∃ b₁ ∈ F.CARm (M \ {μ}), ∃ b₂ ∈ F.CARm (M \ {μ}),
    ∃ b₃ ∈ F.CARm (M \ {μ}), x = b₀ + b₁ * F.c μ + b₂ * star (F.c μ) + b₃ * F.nOp μ}

omit [Fintype S] [DecidableEq S] in
theorem not_mem_diff_singleton (μ : Mode S) (M : Set (Mode S)) : μ ∉ M \ {μ} := fun h => h.2 rfl

theorem one_mem_Wset (μ : Mode S) (M : Set (Mode S)) : (1 : A) ∈ F.Wset μ M :=
  ⟨1, one_mem _, 0, zero_mem _, 0, zero_mem _, 0, zero_mem _, by simp⟩

theorem add_mem_Wset {μ : Mode S} {M : Set (Mode S)} {x y : A} (hx : x ∈ F.Wset μ M)
    (hy : y ∈ F.Wset μ M) : x + y ∈ F.Wset μ M := by
  obtain ⟨b₀, h₀, b₁, h₁, b₂, h₂, b₃, h₃, rfl⟩ := hx
  obtain ⟨d₀, k₀, d₁, k₁, d₂, k₂, d₃, k₃, rfl⟩ := hy
  exact ⟨b₀ + d₀, add_mem h₀ k₀, b₁ + d₁, add_mem h₁ k₁, b₂ + d₂, add_mem h₂ k₂, b₃ + d₃,
    add_mem h₃ k₃, by simp only [add_mul]; abel⟩

theorem left_mul_mem_Wset {μ : Mode S} {M : Set (Mode S)} {b w : A} (hb : b ∈ F.CARm (M \ {μ}))
    (hw : w ∈ F.Wset μ M) : b * w ∈ F.Wset μ M := by
  obtain ⟨b₀, h₀, b₁, h₁, b₂, h₂, b₃, h₃, rfl⟩ := hw
  exact ⟨b * b₀, mul_mem hb h₀, b * b₁, mul_mem hb h₁, b * b₂, mul_mem hb h₂, b * b₃,
    mul_mem hb h₃, by simp only [mul_add, mul_assoc]⟩

theorem c_mul_mem_Wset {μ : Mode S} {M : Set (Mode S)} {w : A} (hw : w ∈ F.Wset μ M) :
    F.c μ * w ∈ F.Wset μ M := by
  obtain ⟨b₀, h₀, b₁, h₁, b₂, h₂, b₃, h₃, rfl⟩ := hw
  have hμ := not_mem_diff_singleton μ M
  refine ⟨F.parity b₂, parity_mem_CARm h₂, F.parity b₀ + F.parity b₃,
    add_mem (parity_mem_CARm h₀) (parity_mem_CARm h₃), 0, zero_mem _, -F.parity b₂,
    neg_mem (parity_mem_CARm h₂), ?_⟩
  have e : F.c μ * star (F.c μ) = 1 - F.nOp μ := c_mul_star_c μ
  simp only [mul_add, ← mul_assoc]
  rw [(c_mul_of_mem_CARm hμ h₀).1, (c_mul_of_mem_CARm hμ h₁).1, (c_mul_of_mem_CARm hμ h₂).1,
    (c_mul_of_mem_CARm hμ h₃).1]
  simp only [mul_assoc]
  rw [c_mul_self, e, c_mul_nOp_self]
  simp only [mul_zero, add_zero, zero_mul, mul_sub, mul_one, add_mul, neg_mul]
  abel

theorem star_c_mul_mem_Wset {μ : Mode S} {M : Set (Mode S)} {w : A} (hw : w ∈ F.Wset μ M) :
    star (F.c μ) * w ∈ F.Wset μ M := by
  obtain ⟨b₀, h₀, b₁, h₁, b₂, h₂, b₃, h₃, rfl⟩ := hw
  have hμ := not_mem_diff_singleton μ M
  refine ⟨0, zero_mem _, 0, zero_mem _, F.parity b₀, parity_mem_CARm h₀, F.parity b₁,
    parity_mem_CARm h₁, ?_⟩
  have e0 : star (F.c μ) * F.nOp μ = 0 := by
    rw [nOp, ← mul_assoc, star_c_mul_star_c, zero_mul]
  simp only [mul_add, ← mul_assoc]
  rw [(c_mul_of_mem_CARm hμ h₀).2, (c_mul_of_mem_CARm hμ h₁).2, (c_mul_of_mem_CARm hμ h₂).2,
    (c_mul_of_mem_CARm hμ h₃).2]
  simp only [mul_assoc]
  rw [star_c_mul_star_c, e0, show star (F.c μ) * F.c μ = F.nOp μ from rfl]
  simp only [mul_zero, add_zero, zero_add, zero_mul]

theorem mem_Wset_of_mem_CARm {μ : Mode S} {M : Set (Mode S)} {x : A} (hx : x ∈ F.CARm M) :
    x ∈ F.Wset μ M := by
  have key : ∀ w ∈ F.Wset μ M, x * w ∈ F.Wset μ M := by
    refine CARm_induction (p := fun x => ∀ w ∈ F.Wset μ M, x * w ∈ F.Wset μ M) ?_ ?_ ?_ ?_ ?_ hx
    · intro ν hν w hw
      by_cases h : ν = μ
      · subst h; exact c_mul_mem_Wset hw
      · exact left_mul_mem_Wset (c_mem_CARm ⟨hν, h⟩) hw
    · intro ν hν w hw
      by_cases h : ν = μ
      · subst h; exact star_c_mul_mem_Wset hw
      · exact left_mul_mem_Wset (star_c_mem_CARm ⟨hν, h⟩) hw
    · intro r w hw; exact left_mul_mem_Wset (algebraMap_mem _ r) hw
    · intro x y hx hy w hw; rw [add_mul]; exact add_mem_Wset (hx w hw) (hy w hw)
    · intro x y hx hy w hw; rw [mul_assoc]; exact hx _ (hy w hw)
  simpa using key 1 (one_mem_Wset μ M)

theorem twirl_mem_CARm {μ : Mode S} {M : Set (Mode S)} {x : A} (hx : x ∈ F.CARm M) :
    F.twirl μ x ∈ F.CARm (M \ {μ}) := by
  obtain ⟨b₀, h₀, b₁, h₁, b₂, h₂, b₃, h₃, rfl⟩ := mem_Wset_of_mem_CARm (μ := μ) hx
  have hμ := not_mem_diff_singleton μ M
  rw [twirl_add, twirl_add, twirl_add, twirl_mul_left hμ h₁, twirl_mul_left hμ h₂,
    twirl_mul_left hμ h₃, twirl_c_self, twirl_star_c_self, twirl_nOp_self, twirl_of_mem_CARm' hμ h₀]
  simp only [mul_zero, add_zero]
  exact add_mem h₀ (mul_mem h₃ (Subalgebra.smul_mem _ (one_mem _) _))

/-! ### Consequences: the range, idempotency, parity, evenness, the scalar `𝔼_∅` -/

theorem twirlList_mem_CARm (l : List (Mode S)) {M : Set (Mode S)} {x : A} (hx : x ∈ F.CARm M) :
    F.twirlList l x ∈ F.CARm (M \ {ν | ν ∈ l}) := by
  induction l with
  | nil => rw [twirlList_nil]; simpa using hx
  | cons μ l ih =>
    rw [twirlList_cons]
    have h := twirl_mem_CARm (μ := μ) ih
    convert h using 2
    ext ν
    simp only [Set.mem_sdiff, Set.mem_ofPred_eq, List.mem_cons, Set.mem_singleton_iff]
    tauto

theorem condExp_mem_dev (Y : Finset S) (a : A) : F.condExp Y a ∈ F.CAR Y := by
  have ha : a ∈ F.CARm Set.univ := by rw [CARm_univ]; exact StarSubalgebra.mem_top
  have h := twirlList_mem_CARm (outsideModes Y) ha
  rw [CAR_eq_CARm, condExp_eq_twirlList]
  convert h using 2
  ext ν
  simp [mem_outsideModes]

theorem condExp_condExp_dev (Y : Finset S) (a : A) :
    F.condExp Y (F.condExp Y a) = F.condExp Y a :=
  condExp_of_mem_CAR (condExp_mem_dev Y a)

theorem parityU_mul_majorana (μ : Mode S) : F.parityU * F.majorana μ = -(F.majorana μ * F.parityU) := by
  rw [majorana, mul_add, add_mul, parityU_mul_c, parityU_mul_star_c, neg_add]

theorem parityU_mul_majorana' (μ : Mode S) :
    F.parityU * F.majorana' μ = -(F.majorana' μ * F.parityU) := by
  rw [majorana', mul_smul_comm, smul_mul_assoc, mul_sub, sub_mul, parityU_mul_c, parityU_mul_star_c,
    ← smul_neg]
  congr 1
  abel

theorem parityU_mul_nOp (μ : Mode S) : F.parityU * F.nOp μ = F.nOp μ * F.parityU := by
  rw [nOp, ← mul_assoc, parityU_mul_star_c, neg_mul, mul_assoc, parityU_mul_c, mul_neg, neg_neg,
    mul_assoc]

theorem parityU_mul_localParity (μ : Mode S) :
    F.parityU * F.localParity μ = F.localParity μ * F.parityU := by
  have h : F.parityU * (star (F.c μ) * F.c μ) = star (F.c μ) * F.c μ * F.parityU := parityU_mul_nOp μ
  rw [localParity, mul_sub, sub_mul, mul_one, one_mul, mul_smul_comm, smul_mul_assoc, h]

theorem conj_parity_of_anticomm {u : A} (hu : F.parityU * u = -(u * F.parityU)) (a : A) :
    u * F.parity a * star u = F.parity (u * a * star u) := by
  have h1 : u * F.parityU = -(F.parityU * u) := by rw [hu, neg_neg]
  have h2 : F.parityU * star u = -(star u * F.parityU) := by
    have := congrArg star h1
    rw [star_mul, star_neg, star_mul, star_parityU_dev] at this
    exact this
  calc u * F.parity a * star u = (u * F.parityU) * a * (F.parityU * star u) := by
        simp only [parity, mul_assoc]
    _ = F.parity (u * a * star u) := by
        rw [h1, h2, neg_mul, neg_mul, mul_neg, neg_neg]; simp only [parity, mul_assoc]

theorem conj_parity_of_comm {u : A} (hu : F.parityU * u = u * F.parityU) (a : A) :
    u * F.parity a * star u = F.parity (u * a * star u) := by
  have h2 : F.parityU * star u = star u * F.parityU := by
    have := congrArg star hu
    rw [star_mul, star_mul, star_parityU_dev] at this
    exact this.symm
  calc u * F.parity a * star u = (u * F.parityU) * a * (F.parityU * star u) := by
        simp only [parity, mul_assoc]
    _ = F.parity (u * a * star u) := by
        rw [← hu, h2]; simp only [parity, mul_assoc]

theorem parity_smul (r : ℂ) (x : A) : F.parity (r • x) = r • F.parity x := by
  simp only [parity, mul_smul_comm, smul_mul_assoc]

theorem twirl_parity (μ : Mode S) (a : A) : F.twirl μ (F.parity a) = F.parity (F.twirl μ a) := by
  have h1 : F.parityU * (F.parityU * F.majorana μ) = -(F.parityU * F.majorana μ * F.parityU) := by
    rw [mul_assoc, parityU_mul_majorana, mul_neg]
  have h2 : F.parityU * (F.parityU * F.majorana' μ) = -(F.parityU * F.majorana' μ * F.parityU) := by
    rw [mul_assoc, parityU_mul_majorana', mul_neg]
  rw [twirl_eq_avg4, twirl_eq_avg4, avg4, avg4, conj_parity_of_anticomm h1,
    conj_parity_of_anticomm h2, conj_parity_of_comm (parityU_mul_localParity μ), parity_smul,
    parity_add, parity_add, parity_add]

theorem twirlList_parity (l : List (Mode S)) (a : A) :
    F.twirlList l (F.parity a) = F.parity (F.twirlList l a) := by
  induction l with
  | nil => rfl
  | cons μ l ih => rw [twirlList_cons, twirlList_cons, ih, twirl_parity]

theorem condExp_parity_dev (Y : Finset S) (a : A) :
    F.condExp Y (F.parity a) = F.parity (F.condExp Y a) :=
  twirlList_parity _ a

theorem parity_eq_of_isEven {a : A} (ha : F.IsEven a) : F.parity a = a := by
  rw [parity, mul_assoc, ha.eq, ← mul_assoc, parityU_mul_parityU_dev, one_mul]

theorem isEven_of_parity_eq {a : A} (ha : F.parity a = a) : F.IsEven a := by
  show a * F.parityU = F.parityU * a
  conv_lhs => rw [← ha]
  rw [parity, mul_assoc, parityU_mul_parityU_dev, mul_one]

theorem condExp_mem_Alg_dev (Y : Finset S) {a : A} (ha : F.IsEven a) : F.condExp Y a ∈ F.Alg Y := by
  refine ⟨condExp_mem_dev Y a, isEven_of_parity_eq ?_⟩
  rw [← condExp_parity_dev, parity_eq_of_isEven ha]

theorem condExp_empty_eq_smul_one_dev (a : A) : ∃ t : ℂ, F.condExp ∅ a = t • (1 : A) := by
  have h : F.CAR ∅ ≤ ⊥ := StarAlgebra.adjoin_le (by rintro x ⟨s, hs, _⟩; simp at hs)
  obtain ⟨t, ht⟩ := StarSubalgebra.mem_bot.mp (h (condExp_mem_dev ∅ a))
  exact ⟨t, by rw [← ht, Algebra.algebraMap_eq_smul_one]⟩

/-! ### The gauge clause -/

theorem gaugeX_mem_skewAdjoint (φ : Spin → ℝ) : F.gaugeX φ ∈ skewAdjoint A := by
  refine add_mem ?_ ?_ <;>
  · refine (isSelfAdjoint_numberOp _).smul_mem_skewAdjoint ?_
    rw [skewAdjoint.mem_iff, star_mul']
    simp only [Complex.star_def, Complex.conj_ofReal, Complex.conj_I]
    ring

theorem gaugeU_mem_unitary (φ : Spin → ℝ) : F.gaugeU φ ∈ unitary A := by
  let _ : NormedAlgebra ℚ A := NormedAlgebra.restrictScalars ℚ ℂ A
  exact NormedSpace.exp_mem_unitary_of_mem_skewAdjoint (gaugeX_mem_skewAdjoint φ)

theorem gaugeU_neg_mul_gaugeU (φ : Spin → ℝ) : F.gaugeU (-φ) * F.gaugeU φ = 1 := by
  have h := gaugeU_mul_gaugeU_neg (F := F) (-φ)
  rwa [neg_neg] at h

theorem star_gaugeU (φ : Spin → ℝ) : star (F.gaugeU φ) = F.gaugeU (-φ) := by
  calc star (F.gaugeU φ) = star (F.gaugeU φ) * (F.gaugeU φ * F.gaugeU (-φ)) := by
        rw [gaugeU_mul_gaugeU_neg, mul_one]
    _ = F.gaugeU (-φ) := by
        rw [← mul_assoc, Unitary.star_mul_self_of_mem (gaugeU_mem_unitary φ), one_mul]

theorem commute_numberOp (σ τ : Spin) : Commute (F.numberOp σ) (F.numberOp τ) :=
  Commute.sum_left _ _ _ fun _ _ => Commute.sum_right _ _ _ fun _ _ => commute_nOp _ _

theorem commute_gaugeX_nOp (φ : Spin → ℝ) (μ : Mode S) : Commute (F.gaugeX φ) (F.nOp μ) := by
  unfold gaugeX
  apply Commute.add_left <;> apply Commute.smul_left <;>
    exact Commute.sum_left _ _ _ fun _ _ => commute_nOp _ _

theorem commute_gaugeU_localParity (φ : Spin → ℝ) (μ : Mode S) :
    Commute (F.gaugeU φ) (F.localParity μ) := by
  have h : Commute (F.gaugeX φ) (F.localParity μ) :=
    (Commute.one_right _).sub_right ((commute_gaugeX_nOp φ μ).smul_right _)
  rw [gaugeU_eq]
  exact h.exp_left

theorem commute_gaugeU_parityU (φ : Spin → ℝ) : Commute (F.gaugeU φ) F.parityU := by
  have h : Commute (F.gaugeX φ) (((Real.pi : ℂ) * I) • (F.numberOp .up + F.numberOp .dn)) := by
    unfold gaugeX
    apply Commute.smul_right
    apply Commute.add_left <;> apply Commute.smul_left <;> apply Commute.add_right <;>
      apply commute_numberOp
  rw [gaugeU_eq, parityU]
  exact h.exp_left.exp_right

theorem gauge_add (φ : Spin → ℝ) (x y : A) : F.gauge φ (x + y) = F.gauge φ x + F.gauge φ y := by
  simp only [gauge, mul_add, add_mul]

theorem gauge_smul (φ : Spin → ℝ) (r : ℂ) (x : A) : F.gauge φ (r • x) = r • F.gauge φ x := by
  simp only [gauge, mul_smul_comm, smul_mul_assoc]

theorem gauge_mul (φ : Spin → ℝ) (x y : A) : F.gauge φ (x * y) = F.gauge φ x * F.gauge φ y := by
  calc F.gauge φ (x * y) = F.gaugeU φ * x * (F.gaugeU (-φ) * F.gaugeU φ) * y * F.gaugeU (-φ) := by
        rw [gaugeU_neg_mul_gaugeU, mul_one, gauge, mul_assoc (F.gaugeU φ) x y]
    _ = F.gauge φ x * F.gauge φ y := by simp only [gauge, mul_assoc]

theorem gauge_localParity (φ : Spin → ℝ) (μ : Mode S) : F.gauge φ (F.localParity μ) = F.localParity μ := by
  rw [gauge, (commute_gaugeU_localParity φ μ).eq, mul_assoc, gaugeU_mul_gaugeU_neg, mul_one]

theorem gauge_parity (φ : Spin → ℝ) (x : A) : F.gauge φ (F.parity x) = F.parity (F.gauge φ x) := by
  have h1 := (commute_gaugeU_parityU (F := F) φ).eq
  have h2 := (commute_gaugeU_parityU (F := F) (-φ)).eq
  simp only [gauge, parity]
  calc F.gaugeU φ * (F.parityU * x * F.parityU) * F.gaugeU (-φ)
      = (F.gaugeU φ * F.parityU) * x * (F.parityU * F.gaugeU (-φ)) := by simp only [mul_assoc]
    _ = F.parityU * (F.gaugeU φ * x * F.gaugeU (-φ)) * F.parityU := by
        rw [h1, ← h2]; simp only [mul_assoc]

theorem gauge_star_c (φ : Spin → ℝ) (s : S) (σ : Spin) :
    F.gauge φ (star (F.c (s, σ))) = Complex.exp (I * (φ σ : ℂ)) • star (F.c (s, σ)) := by
  have h := congrArg star (gauge_c_dev (F := F) φ s σ)
  rw [gauge, star_mul, star_mul, star_gaugeU, star_gaugeU, neg_neg, star_smul] at h
  rw [gauge, mul_assoc, h]
  congr 1
  rw [Complex.star_def, ← Complex.exp_conj, map_neg, map_mul, Complex.conj_I, Complex.conj_ofReal,
    neg_mul, neg_neg]

theorem majorana_sandwich_add (μ : Mode S) (x : A) :
    F.majorana μ * x * F.majorana μ + F.majorana' μ * x * F.majorana' μ =
      (2 : ℂ) • (F.c μ * x * star (F.c μ) + star (F.c μ) * x * F.c μ) := by
  simp only [majorana, majorana', add_mul, mul_add, sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm,
    smul_sub, smul_smul, Complex.I_mul_I, neg_one_smul, two_smul, smul_add]
  abel

theorem twirl_eq_simplified (μ : Mode S) (a : A) :
    F.twirl μ a = (4 : ℂ)⁻¹ • (a + F.parity ((2 : ℂ) • (F.c μ * a * star (F.c μ) +
      star (F.c μ) * a * F.c μ)) + F.localParity μ * a * F.localParity μ) := by
  rw [twirl_eq_avg4, avg4, conj_u1, conj_u2, star_localParity, add_assoc a, ← parity_add,
    majorana_sandwich_add]

theorem gauge_c_mul_mul_star_c (φ : Spin → ℝ) (μ : Mode S) (x : A) :
    F.gauge φ (F.c μ * x * star (F.c μ)) = F.c μ * F.gauge φ x * star (F.c μ) := by
  obtain ⟨s, σ⟩ := μ
  rw [gauge_mul, gauge_mul, gauge_c_dev, gauge_star_c]
  simp only [smul_mul_assoc, mul_smul_comm, smul_smul, ← Complex.exp_add, add_neg_cancel,
    Complex.exp_zero, one_smul]

theorem gauge_star_c_mul_mul_c (φ : Spin → ℝ) (μ : Mode S) (x : A) :
    F.gauge φ (star (F.c μ) * x * F.c μ) = star (F.c μ) * F.gauge φ x * F.c μ := by
  obtain ⟨s, σ⟩ := μ
  rw [gauge_mul, gauge_mul, gauge_c_dev, gauge_star_c]
  simp only [smul_mul_assoc, mul_smul_comm, smul_smul, ← Complex.exp_add, neg_add_cancel,
    Complex.exp_zero, one_smul]

theorem twirl_gauge (μ : Mode S) (φ : Spin → ℝ) (a : A) :
    F.twirl μ (F.gauge φ a) = F.gauge φ (F.twirl μ a) := by
  rw [twirl_eq_simplified, twirl_eq_simplified, gauge_smul, gauge_add, gauge_add, gauge_parity,
    gauge_smul, gauge_add, gauge_c_mul_mul_star_c, gauge_star_c_mul_mul_c, gauge_mul, gauge_mul,
    gauge_localParity]

theorem twirlList_gauge (l : List (Mode S)) (φ : Spin → ℝ) (a : A) :
    F.twirlList l (F.gauge φ a) = F.gauge φ (F.twirlList l a) := by
  induction l with
  | nil => rfl
  | cons μ l ih => rw [twirlList_cons, twirlList_cons, ih, twirl_gauge]

theorem condExp_gauge_dev (Y : Finset S) (φ : Spin → ℝ) (a : A) :
    F.condExp Y (F.gauge φ a) = F.gauge φ (F.condExp Y a) :=
  twirlList_gauge _ φ a

/-! ### Twirls of different modes commute; each twirl is idempotent -/

/-- `a ↦ P (ĉ_μ a ĉ_μ^* + ĉ_μ^* a ĉ_μ) P` (a proof device). -/
def E1 (F : CARSystem S A) (μ : Mode S) (a : A) : A :=
  F.parity (F.c μ * a * star (F.c μ) + star (F.c μ) * a * F.c μ)

/-- `a ↦ z_μ a z_μ` (a proof device). -/
def E2 (F : CARSystem S A) (μ : Mode S) (a : A) : A :=
  F.localParity μ * a * F.localParity μ

theorem twirl_eq_E (μ : Mode S) (a : A) :
    F.twirl μ a = (4 : ℂ)⁻¹ • (a + (2 : ℂ) • F.E1 μ a + F.E2 μ a) := by
  rw [twirl_eq_simplified, E1, E2, parity_smul]

theorem E1_add (μ : Mode S) (a b : A) : F.E1 μ (a + b) = F.E1 μ a + F.E1 μ b := by
  simp only [E1, mul_add, add_mul, ← parity_add]; congr 1; abel

theorem E1_smul (μ : Mode S) (r : ℂ) (a : A) : F.E1 μ (r • a) = r • F.E1 μ a := by
  simp only [E1, mul_smul_comm, smul_mul_assoc, ← smul_add, parity_smul]

theorem E2_add (μ : Mode S) (a b : A) : F.E2 μ (a + b) = F.E2 μ a + F.E2 μ b := by
  simp only [E2, mul_add, add_mul]

theorem E2_smul (μ : Mode S) (r : ℂ) (a : A) : F.E2 μ (r • a) = r • F.E2 μ a := by
  simp only [E2, mul_smul_comm, smul_mul_assoc]

theorem commute_localParity (μ ν : Mode S) : Commute (F.localParity μ) (F.localParity ν) := by
  have hn : Commute ((2 : ℂ) • F.nOp μ) ((2 : ℂ) • F.nOp ν) :=
    ((commute_nOp μ ν).smul_left _).smul_right _
  show Commute (1 - (2 : ℂ) • F.nOp μ) (1 - (2 : ℂ) • F.nOp ν)
  exact (Commute.one_right _).sub_right ((Commute.one_left _).sub_left hn)

theorem parity_localParity (μ : Mode S) : F.parity (F.localParity μ) = F.localParity μ := by
  rw [localParity, parity_sub, parity_one, parity_smul]
  rw [show star (F.c μ) * F.c μ = F.nOp μ from rfl, parity_nOp]

theorem localParity_mul_star_c_of_ne {μ ν : Mode S} (h : μ ≠ ν) :
    F.localParity μ * star (F.c ν) = star (F.c ν) * F.localParity μ := by
  have := congrArg star (localParity_mul_c_of_ne (F := F) h)
  rw [star_mul, star_mul, star_localParity] at this
  exact this.symm

theorem E2_E2 {μ ν : Mode S} (a : A) : F.E2 μ (F.E2 ν a) = F.E2 ν (F.E2 μ a) := by
  have h := (commute_localParity (F := F) μ ν).eq
  simp only [E2]
  calc F.localParity μ * (F.localParity ν * a * F.localParity ν) * F.localParity μ
      = (F.localParity μ * F.localParity ν) * a * (F.localParity ν * F.localParity μ) := by
        simp only [mul_assoc]
    _ = (F.localParity ν * F.localParity μ) * a * (F.localParity μ * F.localParity ν) := by
        rw [h]
    _ = _ := by simp only [mul_assoc]

theorem E2_parity (μ : Mode S) (x : A) : F.E2 μ (F.parity x) = F.parity (F.E2 μ x) := by
  rw [E2, E2, parity_mul, parity_mul, parity_localParity]

theorem E2_E1 {μ ν : Mode S} (h : μ ≠ ν) (a : A) : F.E2 μ (F.E1 ν a) = F.E1 ν (F.E2 μ a) := by
  rw [E1, E2_parity, E1]
  congr 1
  simp only [E2, mul_add, add_mul]
  have h1 := localParity_mul_c_of_ne (F := F) h
  have h2 := localParity_mul_star_c_of_ne (F := F) h
  congr 1
  · calc F.localParity μ * (F.c ν * a * star (F.c ν)) * F.localParity μ
        = (F.localParity μ * F.c ν) * a * (star (F.c ν) * F.localParity μ) := by simp only [mul_assoc]
      _ = F.c ν * (F.localParity μ * a * F.localParity μ) * star (F.c ν) := by
          rw [h1, ← h2]; simp only [mul_assoc]
  · calc F.localParity μ * (star (F.c ν) * a * F.c ν) * F.localParity μ
        = (F.localParity μ * star (F.c ν)) * a * (F.c ν * F.localParity μ) := by simp only [mul_assoc]
      _ = star (F.c ν) * (F.localParity μ * a * F.localParity μ) * F.c ν := by
          rw [h2, ← h1]; simp only [mul_assoc]

theorem c_parity_star_c (μ : Mode S) (y : A) :
    F.c μ * F.parity y * star (F.c μ) = F.parity (F.c μ * y * star (F.c μ)) := by
  simp only [parity_mul, parity_c_dev, parity_star_c, neg_mul, mul_neg, neg_neg]

theorem star_c_parity_c (μ : Mode S) (y : A) :
    star (F.c μ) * F.parity y * F.c μ = F.parity (star (F.c μ) * y * F.c μ) := by
  simp only [parity_mul, parity_c_dev, parity_star_c, neg_mul, mul_neg, neg_neg]

theorem E1_E1_eq (μ ν : Mode S) (a : A) :
    F.E1 μ (F.E1 ν a) = F.c μ * (F.c ν * a * star (F.c ν) + star (F.c ν) * a * F.c ν) * star (F.c μ)
      + star (F.c μ) * (F.c ν * a * star (F.c ν) + star (F.c ν) * a * F.c ν) * F.c μ := by
  rw [E1, E1, c_parity_star_c, star_c_parity_c, ← parity_add, parity_parity]

theorem E1_E1 {μ ν : Mode S} (h : μ ≠ ν) (a : A) : F.E1 μ (F.E1 ν a) = F.E1 ν (F.E1 μ a) := by
  rw [E1_E1_eq, E1_E1_eq]
  have t1 : F.c μ * (F.c ν * a * star (F.c ν)) * star (F.c μ) =
      F.c ν * (F.c μ * a * star (F.c μ)) * star (F.c ν) := by
    calc F.c μ * (F.c ν * a * star (F.c ν)) * star (F.c μ)
        = (F.c μ * F.c ν) * a * (star (F.c ν) * star (F.c μ)) := by simp only [mul_assoc]
      _ = (F.c ν * F.c μ) * a * (star (F.c μ) * star (F.c ν)) := by
          rw [c_mul_c_swap μ ν, star_c_mul_star_c_swap ν μ, neg_mul, mul_neg, neg_mul, neg_neg]
      _ = _ := by simp only [mul_assoc]
  have t2 : F.c μ * (star (F.c ν) * a * F.c ν) * star (F.c μ) =
      star (F.c ν) * (F.c μ * a * star (F.c μ)) * F.c ν := by
    calc F.c μ * (star (F.c ν) * a * F.c ν) * star (F.c μ)
        = (F.c μ * star (F.c ν)) * a * (F.c ν * star (F.c μ)) := by simp only [mul_assoc]
      _ = (star (F.c ν) * F.c μ) * a * (star (F.c μ) * F.c ν) := by
          rw [c_mul_star_c_of_ne h, c_mul_star_c_of_ne (Ne.symm h), neg_mul, mul_neg, neg_mul, neg_neg]
      _ = _ := by simp only [mul_assoc]
  have t3 : star (F.c μ) * (F.c ν * a * star (F.c ν)) * F.c μ =
      F.c ν * (star (F.c μ) * a * F.c μ) * star (F.c ν) := by
    calc star (F.c μ) * (F.c ν * a * star (F.c ν)) * F.c μ
        = (star (F.c μ) * F.c ν) * a * (star (F.c ν) * F.c μ) := by simp only [mul_assoc]
      _ = (F.c ν * star (F.c μ)) * a * (F.c μ * star (F.c ν)) := by
          rw [star_c_mul_c_of_ne h, star_c_mul_c_of_ne (Ne.symm h), neg_mul, mul_neg, neg_mul, neg_neg]
      _ = _ := by simp only [mul_assoc]
  have t4 : star (F.c μ) * (star (F.c ν) * a * F.c ν) * F.c μ =
      star (F.c ν) * (star (F.c μ) * a * F.c μ) * F.c ν := by
    calc star (F.c μ) * (star (F.c ν) * a * F.c ν) * F.c μ
        = (star (F.c μ) * star (F.c ν)) * a * (F.c ν * F.c μ) := by simp only [mul_assoc]
      _ = (star (F.c ν) * star (F.c μ)) * a * (F.c μ * F.c ν) := by
          rw [star_c_mul_star_c_swap μ ν, c_mul_c_swap ν μ, neg_mul, mul_neg, neg_mul, neg_neg]
      _ = _ := by simp only [mul_assoc]
  simp only [mul_add, add_mul] at *
  rw [t1, t2, t3, t4]
  abel

theorem E1_twirl {μ ν : Mode S} (h : μ ≠ ν) (a : A) : F.E1 μ (F.twirl ν a) = F.twirl ν (F.E1 μ a) := by
  rw [twirl_eq_E, twirl_eq_E, E1_smul, E1_add, E1_add, E1_smul, E1_E1 h, ← E2_E1 (Ne.symm h)]

theorem twirl_smul (μ : Mode S) (r : ℂ) (a : A) : F.twirl μ (r • a) = r • F.twirl μ a := by
  rw [twirl_eq_avg4, twirl_eq_avg4, avg4_smul]

theorem E2_twirl {μ ν : Mode S} (h : μ ≠ ν) (a : A) : F.E2 μ (F.twirl ν a) = F.twirl ν (F.E2 μ a) := by
  rw [twirl_eq_E, twirl_eq_E, E2_smul, E2_add, E2_add, E2_smul, E2_E1 h, E2_E2]

theorem twirl_comm (μ ν : Mode S) (a : A) : F.twirl μ (F.twirl ν a) = F.twirl ν (F.twirl μ a) := by
  by_cases h : μ = ν
  · subst h; rfl
  · rw [twirl_eq_E μ (F.twirl ν a), E1_twirl h, E2_twirl h, twirl_eq_E μ a, twirl_smul, twirl_add,
      twirl_add, twirl_smul]

theorem twirl_twirl (μ : Mode S) (a : A) : F.twirl μ (F.twirl μ a) = F.twirl μ a := by
  have ha : a ∈ F.CARm Set.univ := by rw [CARm_univ]; exact StarSubalgebra.mem_top
  exact twirl_of_mem_CARm' (not_mem_diff_singleton μ Set.univ) (twirl_mem_CARm ha)

theorem twirl_twirlList (μ : Mode S) (l : List (Mode S)) (a : A) :
    F.twirl μ (F.twirlList l a) = F.twirlList l (F.twirl μ a) := by
  induction l with
  | nil => rfl
  | cons ν l ih => rw [twirlList_cons, twirlList_cons, twirl_comm, ih]

theorem twirlList_twirl_of_mem {ν : Mode S} {l : List (Mode S)} (hν : ν ∈ l) (a : A) :
    F.twirlList l (F.twirl ν a) = F.twirlList l a := by
  induction l with
  | nil => simp at hν
  | cons μ l ih =>
    rw [twirlList_cons, twirlList_cons]
    by_cases h : ν ∈ l
    · rw [ih h]
    · have hμ : ν = μ := by simpa [h] using hν
      subst hμ
      rw [← twirl_twirlList, twirl_twirl]

theorem twirlList_twirlList_of_subset {l₁ l₂ : List (Mode S)} (h : ∀ ν ∈ l₂, ν ∈ l₁) (a : A) :
    F.twirlList l₁ (F.twirlList l₂ a) = F.twirlList l₁ a := by
  induction l₂ with
  | nil => rfl
  | cons ν l₂ ih =>
    rw [twirlList_cons, twirlList_twirl_of_mem (h ν List.mem_cons_self),
      ih (fun μ hμ => h μ (List.mem_cons_of_mem _ hμ))]

theorem condExp_empty_condExp_dev (Y : Finset S) (a : A) :
    F.condExp ∅ (F.condExp Y a) = F.condExp ∅ a := by
  rw [condExp_eq_twirlList, condExp_eq_twirlList]
  exact twirlList_twirlList_of_subset (fun ν _ => mem_outsideModes.mpr (Finset.notMem_empty _)) a

theorem condExp_mul_left {Y : Finset S} {b : A} (hb : b ∈ F.CAR Y) (x : A) :
    F.condExp Y (b * x) = b * F.condExp Y x := by
  rw [condExp_eq_twirlList]
  have hb' : b ∈ F.CARm {μ | μ.1 ∈ Y} := by rw [← CAR_eq_CARm]; exact hb
  have key : ∀ l : List (Mode S), (∀ μ ∈ l, μ.1 ∉ Y) →
      F.twirlList l (b * x) = b * F.twirlList l x := by
    intro l hl
    induction l with
    | nil => rfl
    | cons μ l ih =>
      rw [twirlList_cons, twirlList_cons, ih (fun ν hν => hl ν (List.mem_cons_of_mem _ hν)),
        twirl_mul_left (M := {μ | μ.1 ∈ Y}) (fun h => hl μ List.mem_cons_self h) hb']
  exact key _ (fun μ h => mem_outsideModes.mp h)

theorem condExp_empty_star_mul_sub_dev (Y : Finset S) (a : A) {b : A} (hb : b ∈ F.CAR Y) :
    F.condExp ∅ (star b * (a - F.condExp Y a)) = 0 := by
  have hb' : star b ∈ F.CAR Y := star_mem hb
  rw [mul_sub, (condExp_isLinearMap_dev ∅).map_sub, ← condExp_empty_condExp_dev Y (star b * a),
    condExp_mul_left hb', sub_self]

theorem twirl_eq_zero_of_nonneg [PartialOrder A] [StarOrderedRing A] (μ : Mode S) {p : A}
    (hp : 0 ≤ p) (h : F.twirl μ p = 0) : p = 0 := by
  rw [twirl_eq_avg4, avg4] at h
  have h4 : p + (F.parityU * F.majorana μ) * p * star (F.parityU * F.majorana μ) +
      (F.parityU * F.majorana' μ) * p * star (F.parityU * F.majorana' μ) +
      F.localParity μ * p * star (F.localParity μ) = 0 := by
    rcases smul_eq_zero.mp h with h0 | h0
    · norm_num at h0
    · exact h0
  have q1 := star_right_conjugate_nonneg hp (F.parityU * F.majorana μ)
  have q2 := star_right_conjugate_nonneg hp (F.parityU * F.majorana' μ)
  have q3 := star_right_conjugate_nonneg hp (F.localParity μ)
  have hle : p ≤ 0 := by
    calc p ≤ p + (F.parityU * F.majorana μ) * p * star (F.parityU * F.majorana μ) +
          (F.parityU * F.majorana' μ) * p * star (F.parityU * F.majorana' μ) +
          F.localParity μ * p * star (F.localParity μ) := by
          have := add_nonneg (add_nonneg q1 q2) q3
          calc p = p + 0 := (add_zero p).symm
            _ ≤ p + ((F.parityU * F.majorana μ) * p * star (F.parityU * F.majorana μ) +
                (F.parityU * F.majorana' μ) * p * star (F.parityU * F.majorana' μ) +
                F.localParity μ * p * star (F.localParity μ)) := add_le_add_right this p
            _ = _ := by abel
      _ = 0 := h4
  exact le_antisymm hle hp

theorem condExp_empty_star_mul_self_dev {a : A} (h : F.condExp ∅ (star a * a) = 0) : a = 0 := by
  let _ := CStarAlgebra.spectralOrder A
  let _ := CStarAlgebra.spectralOrderedRing A
  have key : ∀ (l : List (Mode S)) {p : A}, 0 ≤ p → F.twirlList l p = 0 → p = 0 := by
    intro l
    induction l with
    | nil => intro p _ h; exact h
    | cons μ l ih =>
      intro p hp h
      rw [twirlList_cons] at h
      exact ih hp (twirl_eq_zero_of_nonneg μ (twirlList_nonneg l hp) h)
  rw [condExp_eq_twirlList] at h
  exact (CStarRing.star_mul_self_eq_zero_iff a).mp (key _ (star_mul_self_nonneg a) h)

/-! ### The trace is tracial -/

theorem parity_majorana (μ : Mode S) : F.parity (F.majorana μ) = -F.majorana μ := by
  rw [majorana, parity_add, parity_c_dev, parity_star_c, neg_add]

theorem parity_majorana' (μ : Mode S) : F.parity (F.majorana' μ) = -F.majorana' μ := by
  rw [majorana', parity_smul, parity_sub, parity_c_dev, parity_star_c, neg_sub_neg, ← smul_neg,
    neg_sub]

theorem majorana'_mul_majorana (μ : Mode S) : F.majorana' μ * F.majorana μ = I • F.localParity μ := by
  have e : F.c μ * star (F.c μ) = 1 - star (F.c μ) * F.c μ := c_mul_star_c μ
  rw [majorana', majorana, smul_mul_assoc, sub_mul, mul_add, mul_add, c_mul_self, star_c_mul_star_c,
    e, localParity]
  congr 1
  rw [two_smul]; abel

theorem majorana_mul_majorana' (μ : Mode S) : F.majorana μ * F.majorana' μ = -(I • F.localParity μ) := by
  have e : F.c μ * star (F.c μ) = 1 - star (F.c μ) * F.c μ := c_mul_star_c μ
  rw [majorana', majorana, mul_smul_comm, add_mul, mul_sub, mul_sub, c_mul_self, star_c_mul_star_c,
    e, localParity, ← smul_neg]
  congr 1
  rw [two_smul]; abel

theorem localParity_mul_majorana (μ : Mode S) : F.localParity μ * F.majorana μ = -(I • F.majorana' μ) := by
  have e1 : star (F.c μ) * F.c μ * F.c μ = 0 := by rw [mul_assoc, c_mul_self, mul_zero]
  rw [localParity, majorana, majorana', sub_mul, one_mul, smul_mul_assoc, mul_add, e1,
    star_c_mul_c_mul_star_c, smul_smul, Complex.I_mul_I, neg_one_smul, neg_neg, zero_add, two_smul]
  abel

theorem majorana_mul_localParity (μ : Mode S) : F.majorana μ * F.localParity μ = I • F.majorana' μ := by
  have e2 : star (F.c μ) * (star (F.c μ) * F.c μ) = 0 := by
    rw [← mul_assoc, star_c_mul_star_c, zero_mul]
  have e3 : F.c μ * (star (F.c μ) * F.c μ) = F.c μ := by rw [← mul_assoc, c_mul_star_c_mul_c]
  rw [localParity, majorana, majorana', mul_sub, mul_one, mul_smul_comm, add_mul, e2, e3, add_zero,
    smul_smul, Complex.I_mul_I, neg_one_smul, two_smul]
  abel

theorem localParity_mul_majorana' (μ : Mode S) : F.localParity μ * F.majorana' μ = I • F.majorana μ := by
  have e1 : star (F.c μ) * F.c μ * F.c μ = 0 := by rw [mul_assoc, c_mul_self, mul_zero]
  rw [localParity, majorana, majorana', mul_smul_comm, sub_mul, one_mul, smul_mul_assoc, mul_sub, e1,
    star_c_mul_c_mul_star_c]
  congr 1
  rw [two_smul]; abel

theorem majorana'_mul_localParity (μ : Mode S) : F.majorana' μ * F.localParity μ = -(I • F.majorana μ) := by
  have e2 : star (F.c μ) * (star (F.c μ) * F.c μ) = 0 := by
    rw [← mul_assoc, star_c_mul_star_c, zero_mul]
  have e3 : F.c μ * (star (F.c μ) * F.c μ) = F.c μ := by rw [← mul_assoc, c_mul_star_c_mul_c]
  rw [localParity, majorana, majorana', smul_mul_assoc, mul_sub, mul_one, mul_smul_comm, sub_mul, e2,
    e3, ← smul_neg]
  congr 1
  rw [two_smul]; abel

theorem conj_neg' (u x : A) : (-u) * x * star (-u) = u * x * star u := by
  rw [star_neg, neg_mul, mul_neg, neg_mul, neg_neg]

theorem conj_I_smul (u x : A) : (I • u) * x * star (I • u) = u * x * star u := by
  simp only [star_smul, smul_mul_assoc, mul_smul_comm, smul_smul, Complex.star_def, Complex.conj_I,
    neg_mul, Complex.I_mul_I, neg_neg, one_smul]

theorem conj_conj (u v x : A) : u * (v * x * star v) * star u = (u * v) * x * star (u * v) := by
  rw [star_mul]; simp only [mul_assoc]

theorem twirl_conj_u1 (μ : Mode S) (x : A) :
    F.twirl μ ((F.parityU * F.majorana μ) * x * star (F.parityU * F.majorana μ)) = F.twirl μ x := by
  have h11 : F.parityU * F.majorana μ * (F.parityU * F.majorana μ) = -1 := by
    calc F.parityU * F.majorana μ * (F.parityU * F.majorana μ)
        = F.parity (F.majorana μ) * F.majorana μ := by simp only [parity, mul_assoc]
      _ = -1 := by rw [parity_majorana, neg_mul, majorana_mul_majorana]
  have h21 : F.parityU * F.majorana' μ * (F.parityU * F.majorana μ) = -(I • F.localParity μ) := by
    calc F.parityU * F.majorana' μ * (F.parityU * F.majorana μ)
        = F.parity (F.majorana' μ) * F.majorana μ := by simp only [parity, mul_assoc]
      _ = _ := by rw [parity_majorana', neg_mul, majorana'_mul_majorana]
  have h31 : F.localParity μ * (F.parityU * F.majorana μ) = -(I • (F.parityU * F.majorana' μ)) := by
    rw [← mul_assoc, ← parityU_mul_localParity, mul_assoc, localParity_mul_majorana, mul_neg,
      mul_smul_comm]
  rw [twirl_eq_avg4, twirl_eq_avg4, avg4, avg4, conj_conj, conj_conj, conj_conj, h11, h21, h31,
    conj_neg', conj_neg', conj_neg', conj_I_smul, conj_I_smul, star_one, mul_one, one_mul]
  congr 1
  abel

theorem twirl_conj_u2 (μ : Mode S) (x : A) :
    F.twirl μ ((F.parityU * F.majorana' μ) * x * star (F.parityU * F.majorana' μ)) = F.twirl μ x := by
  have h12 : F.parityU * F.majorana μ * (F.parityU * F.majorana' μ) = I • F.localParity μ := by
    calc F.parityU * F.majorana μ * (F.parityU * F.majorana' μ)
        = F.parity (F.majorana μ) * F.majorana' μ := by simp only [parity, mul_assoc]
      _ = _ := by rw [parity_majorana, neg_mul, majorana_mul_majorana', neg_neg]
  have h22 : F.parityU * F.majorana' μ * (F.parityU * F.majorana' μ) = -1 := by
    calc F.parityU * F.majorana' μ * (F.parityU * F.majorana' μ)
        = F.parity (F.majorana' μ) * F.majorana' μ := by simp only [parity, mul_assoc]
      _ = -1 := by rw [parity_majorana', neg_mul, majorana'_mul_majorana']
  have h32 : F.localParity μ * (F.parityU * F.majorana' μ) = I • (F.parityU * F.majorana μ) := by
    rw [← mul_assoc, ← parityU_mul_localParity, mul_assoc, localParity_mul_majorana', mul_smul_comm]
  rw [twirl_eq_avg4, twirl_eq_avg4, avg4, avg4, conj_conj, conj_conj, conj_conj, h12, h22, h32,
    conj_neg', conj_I_smul, conj_I_smul, star_one, mul_one, one_mul]
  congr 1
  abel

theorem twirl_conj_u3 (μ : Mode S) (x : A) :
    F.twirl μ (F.localParity μ * x * star (F.localParity μ)) = F.twirl μ x := by
  have h13 : F.parityU * F.majorana μ * F.localParity μ = I • (F.parityU * F.majorana' μ) := by
    rw [mul_assoc, majorana_mul_localParity, mul_smul_comm]
  have h23 : F.parityU * F.majorana' μ * F.localParity μ = -(I • (F.parityU * F.majorana μ)) := by
    rw [mul_assoc, majorana'_mul_localParity, mul_neg, mul_smul_comm]
  have h33 : F.localParity μ * F.localParity μ = 1 := localParity_mul_localParity μ
  rw [twirl_eq_avg4, twirl_eq_avg4, avg4, avg4, conj_conj, conj_conj, conj_conj, h13, h23, h33,
    conj_neg', conj_I_smul, conj_I_smul, star_one, mul_one, one_mul]
  congr 1
  abel

theorem condExp_empty_conj (μ : Mode S) {u : A}
    (hu : ∀ x, F.twirl μ (u * x * star u) = F.twirl μ x) (x : A) :
    F.condExp ∅ (u * x * star u) = F.condExp ∅ x := by
  have hμ : μ ∈ outsideModes (∅ : Finset S) := mem_outsideModes.mpr (Finset.notMem_empty _)
  rw [condExp_eq_twirlList, ← twirlList_twirl_of_mem hμ, hu, twirlList_twirl_of_mem hμ]

theorem condExp_empty_mul_comm_of_unitary {u : A} (hu1 : u * star u = 1)
    (hinv : ∀ x, F.condExp ∅ (u * x * star u) = F.condExp ∅ x) (y : A) :
    F.condExp ∅ (u * y) = F.condExp ∅ (y * u) := by
  rw [← hinv (y * u), mul_assoc, mul_assoc, hu1, mul_one]

/-- `a` commutes with everything under `τ` (a proof device). -/
def TrComm (F : CARSystem S A) (a : A) : Prop := ∀ y, F.condExp ∅ (a * y) = F.condExp ∅ (y * a)

theorem TrComm.mul {a b : A} (ha : F.TrComm a) (hb : F.TrComm b) : F.TrComm (a * b) := by
  intro y; rw [mul_assoc, ha (b * y), mul_assoc, hb (y * a), mul_assoc]

theorem TrComm.add {a b : A} (ha : F.TrComm a) (hb : F.TrComm b) : F.TrComm (a + b) := by
  intro y
  have hl := condExp_isLinearMap_dev (F := F) ∅
  rw [add_mul, mul_add, hl.map_add, hl.map_add, ha y, hb y]

theorem TrComm.smul {a : A} (r : ℂ) (ha : F.TrComm a) : F.TrComm (r • a) := by
  intro y
  have hl := condExp_isLinearMap_dev (F := F) ∅
  rw [smul_mul_assoc, mul_smul_comm, hl.map_smul, hl.map_smul, ha y]

theorem TrComm.algebraMap (r : ℂ) : F.TrComm (algebraMap ℂ A r) := by
  intro y; rw [Algebra.commutes]

theorem trComm_u1 (μ : Mode S) : F.TrComm (F.parityU * F.majorana μ) :=
  condExp_empty_mul_comm_of_unitary (Unitary.mul_star_self_of_mem (u1_mem_unitary μ))
    (condExp_empty_conj μ (twirl_conj_u1 μ))

theorem trComm_u2 (μ : Mode S) : F.TrComm (F.parityU * F.majorana' μ) :=
  condExp_empty_mul_comm_of_unitary (Unitary.mul_star_self_of_mem (u2_mem_unitary μ))
    (condExp_empty_conj μ (twirl_conj_u2 μ))

theorem trComm_parityU : F.TrComm F.parityU := by
  intro y
  obtain ⟨t, ht⟩ := condExp_empty_eq_smul_one_dev (F := F) (y * F.parityU)
  have h1 : F.parityU * y = F.parity (y * F.parityU) := by
    rw [parity, mul_assoc, mul_assoc, parityU_mul_parityU_dev, mul_one]
  rw [h1, condExp_parity_dev, ht, parity_smul, parity_one]

theorem trComm_c (ν : Mode S) : F.TrComm (F.c ν) := by
  have e : F.c ν = (2 : ℂ)⁻¹ • (F.parityU * (F.parityU * F.majorana ν) -
      I • (F.parityU * (F.parityU * F.majorana' ν))) := by
    rw [← mul_assoc, ← mul_assoc, parityU_mul_parityU_dev, one_mul, one_mul, majorana, majorana',
      smul_smul, Complex.I_mul_I, neg_one_smul, sub_neg_eq_add,
      show F.c ν + star (F.c ν) + (F.c ν - star (F.c ν)) = (2 : ℂ) • F.c ν by rw [two_smul]; abel,
      smul_smul, inv_mul_cancel₀ (by norm_num : (2 : ℂ) ≠ 0), one_smul]
  rw [e]
  have hsub : F.TrComm (F.parityU * (F.parityU * F.majorana ν) -
      I • (F.parityU * (F.parityU * F.majorana' ν))) := by
    rw [sub_eq_add_neg, ← neg_smul]
    exact (trComm_parityU.mul (trComm_u1 ν)).add ((trComm_parityU.mul (trComm_u2 ν)).smul _)
  exact hsub.smul _

theorem trComm_star_c (ν : Mode S) : F.TrComm (star (F.c ν)) := by
  have e : star (F.c ν) = (2 : ℂ)⁻¹ • (F.parityU * (F.parityU * F.majorana ν) +
      I • (F.parityU * (F.parityU * F.majorana' ν))) := by
    rw [← mul_assoc, ← mul_assoc, parityU_mul_parityU_dev, one_mul, one_mul, majorana, majorana',
      smul_smul, Complex.I_mul_I, neg_one_smul,
      show F.c ν + star (F.c ν) + -(F.c ν - star (F.c ν)) = (2 : ℂ) • star (F.c ν) by
        rw [two_smul]; abel,
      smul_smul, inv_mul_cancel₀ (by norm_num : (2 : ℂ) ≠ 0), one_smul]
  rw [e]
  exact ((trComm_parityU.mul (trComm_u1 ν)).add ((trComm_parityU.mul (trComm_u2 ν)).smul _)).smul _

theorem condExp_empty_mul_comm_dev (a b : A) : F.condExp ∅ (a * b) = F.condExp ∅ (b * a) := by
  have ha : a ∈ F.CARm Set.univ := by rw [CARm_univ]; exact StarSubalgebra.mem_top
  have key : F.TrComm a := by
    refine CARm_induction (p := fun a => F.TrComm a) ?_ ?_ ?_ ?_ ?_ ha
    · intro ν _; exact trComm_c ν
    · intro ν _; exact trComm_star_c ν
    · intro r; exact TrComm.algebraMap r
    · intro x y hx hy; exact hx.add hy
    · intro x y hx hy; exact hx.mul hy
  exact key b

end ProofDevices

/-! ## The model: agreement with the paper's definitions (statements) -/

/-- `parityU` is self-adjoint (the paper's `(-1)^{N̂}`). -/
theorem star_parityU : star F.parityU = F.parityU :=
  star_parityU_dev

/-- `(-1)^{N̂}` is an involution: `P·P = 1` (together with `star_parityU`, `P` is a self-adjoint
unitary). -/
theorem parityU_mul_parityU : F.parityU * F.parityU = 1 :=
  parityU_mul_parityU_dev

/-- The paper (Definition 3.7 ff.): "conjugation by $(-1)^{\Nhat\up+\Nhat\dn}$ changes the sign of
every $\chat_{s\sigma}$". -/
theorem parity_c (μ : Mode S) : F.parity (F.c μ) = - F.c μ :=
  parity_c_dev μ

/-- The proof of Lemma 3.8(iii): `e^{\iu\varphi\cdot\widehat{\mathbf N}}\chat(g\otimes\sigma')e^{-\iu\varphi\cdot\widehat{\mathbf N}}=e^{-\iu\varphi_{\sigma'}}\chat(g\otimes\sigma')`,
for the basis vectors `g = δ_s`. -/
theorem gauge_c (φ : Spin → ℝ) (s : S) (σ : Spin) :
    F.gauge φ (F.c (s, σ)) = Complex.exp (-(I * (φ σ : ℂ))) • F.c (s, σ) :=
  gauge_c_dev φ s σ

/-! ## Lemma 5.1: what the paper's definition of `𝔼_Y` says (statements)

The paper defines `𝔼_Y` as "the orthogonal projection onto $\CAR(Y)$ for the Hilbert--Schmidt
inner product". Here `𝔼_∅` takes values in `CAR(∅) = ℂ·1` and is the normalized trace `τ` (times
`1`): it is a faithful tracial state, so `⟨b, x⟩ := τ(b^* x)` is the Hilbert–Schmidt inner product
up to the factor `2^{-n}`, and the last statement says that `a − 𝔼_Y(a)` is orthogonal to
`CAR(Y)` for it. -/

/-- `𝔼_Y` maps into `CAR(Y)`. -/
theorem condExp_mem (Y : Finset S) (a : A) : F.condExp Y a ∈ F.CAR Y :=
  condExp_mem_dev Y a

/-- `𝔼_∅` is a scalar: `𝔼_∅(a) = τ(a)·1`. -/
theorem condExp_empty_eq_smul_one (a : A) : ∃ t : ℂ, F.condExp ∅ a = t • (1 : A) :=
  condExp_empty_eq_smul_one_dev a

/-- `τ` is tracial. -/
theorem condExp_empty_mul_comm (a b : A) : F.condExp ∅ (a * b) = F.condExp ∅ (b * a) :=
  condExp_empty_mul_comm_dev a b

/-- `τ` is faithful. -/
theorem condExp_empty_star_mul_self {a : A} (h : F.condExp ∅ (star a * a) = 0) : a = 0 :=
  condExp_empty_star_mul_self_dev h

/-- `𝔼_Y` is trace-preserving: `τ ∘ 𝔼_Y = τ`. -/
theorem condExp_empty_condExp (Y : Finset S) (a : A) :
    F.condExp ∅ (F.condExp Y a) = F.condExp ∅ a :=
  condExp_empty_condExp_dev Y a

/-- `a − 𝔼_Y(a)` is orthogonal to `CAR(Y)` for `⟨b, x⟩ = τ(b^* x)`. -/
theorem condExp_empty_star_mul_sub (Y : Finset S) (a : A) {b : A} (hb : b ∈ F.CAR Y) :
    F.condExp ∅ (star b * (a - F.condExp Y a)) = 0 :=
  condExp_empty_star_mul_sub_dev Y a hb

/-! ## Lemma 5.1 `lem:condexp`: the clauses (statements)

"Then $\CE_Y$ is linear, unital, positive, contractive, idempotent and $*$-preserving; it commutes
with the parity automorphism and with the gauge transformations of Lemma~\ref{lem:embedding}(iii);
it maps even operators into $\Alg(Y)$; and for every even $A$," followed by the display
"\norm{A-\CE_Y(A)}\le2\inf\{\norm{A-A'}:A'\in\Alg(Y)\}". The measurability sentence ("In
particular, if ...") is not stated. -/

/-- **Lemma 5.1**: `$\CE_Y$ is linear`. -/
theorem condExp_isLinearMap (Y : Finset S) : IsLinearMap ℂ (F.condExp Y) :=
  condExp_isLinearMap_dev Y

/-- **Lemma 5.1**: `unital`. -/
theorem condExp_one (Y : Finset S) : F.condExp Y 1 = 1 :=
  condExp_one_dev Y

/-- **Lemma 5.1**: `positive` (for the order of the C⋆-algebra). -/
theorem condExp_nonneg [PartialOrder A] [StarOrderedRing A] (Y : Finset S) {a : A} (ha : 0 ≤ a) :
    0 ≤ F.condExp Y a :=
  condExp_nonneg_dev Y ha

/-- **Lemma 5.1**: `contractive`. -/
theorem norm_condExp_le (Y : Finset S) (a : A) : ‖F.condExp Y a‖ ≤ ‖a‖ :=
  norm_condExp_le_dev Y a

/-- **Lemma 5.1**: `idempotent`. -/
theorem condExp_condExp (Y : Finset S) (a : A) : F.condExp Y (F.condExp Y a) = F.condExp Y a :=
  condExp_condExp_dev Y a

/-- **Lemma 5.1**: `$*$-preserving`. -/
theorem condExp_star (Y : Finset S) (a : A) : F.condExp Y (star a) = star (F.condExp Y a) :=
  condExp_star_dev Y a

/-- **Lemma 5.1**: `it commutes with the parity automorphism`. -/
theorem condExp_parity (Y : Finset S) (a : A) : F.condExp Y (F.parity a) = F.parity (F.condExp Y a) :=
  condExp_parity_dev Y a

/-- **Lemma 5.1**: it commutes `with the gauge transformations of Lemma~\ref{lem:embedding}(iii)`. -/
theorem condExp_gauge (Y : Finset S) (φ : Spin → ℝ) (a : A) :
    F.condExp Y (F.gauge φ a) = F.gauge φ (F.condExp Y a) :=
  condExp_gauge_dev Y φ a

/-- **Lemma 5.1**: `it maps even operators into $\Alg(Y)$`. -/
theorem condExp_mem_Alg (Y : Finset S) {a : A} (ha : F.IsEven a) : F.condExp Y a ∈ F.Alg Y :=
  condExp_mem_Alg_dev Y ha

/-- **Lemma 5.1**: `for every even $A$,` `\norm{A-\CE_Y(A)}\le2\inf\{\norm{A-A'}:A'\in\Alg(Y)\}`.
The infimum is over the subtype `Alg Y` (nonempty: it contains `0`). -/
theorem norm_sub_condExp_le (Y : Finset S) {a : A} (ha : F.IsEven a) :
    ‖a - F.condExp Y a‖ ≤ 2 * ⨅ a' : F.Alg Y, ‖a - (a' : A)‖ :=
  norm_sub_condExp_le_dev Y ha

/-! ## An addition of phase (b): uniqueness

Not one of the twenty reviewed statements; added under the review's ruling on question 5
("Uniqueness of the trace-preserving expectation only if time is left"). -/

/-- **Uniqueness**: `𝔼_Y` is the only map into `CAR(Y)` for which `a − Φ(a)` is orthogonal to
`CAR(Y)` for `⟨b, x⟩ = τ(b^* x)`, `τ = 𝔼_∅` — so the twirl is the orthogonal projection of the
paper's definition, for that trace. -/
theorem condExp_unique (Y : Finset S) {Φ : A → A} (hmem : ∀ a, Φ a ∈ F.CAR Y)
    (horth : ∀ a, ∀ b ∈ F.CAR Y, F.condExp ∅ (star b * (a - Φ a)) = 0) : Φ = F.condExp Y := by
  funext a
  set d := Φ a - F.condExp Y a with hd_def
  have hd : d ∈ F.CAR Y := sub_mem (hmem a) (F.condExp_mem Y a)
  have h1 := horth a d hd
  have h2 := F.condExp_empty_star_mul_sub Y a hd
  have hlin := F.condExp_isLinearMap ∅
  have e : star d * d = star d * (a - F.condExp Y a) - star d * (a - Φ a) := by
    rw [← mul_sub]
    congr 1
    rw [hd_def]
    abel
  have h0 : F.condExp ∅ (star d * d) = 0 := by
    rw [e, hlin.map_sub, h2, h1, sub_zero]
  exact sub_eq_zero.mp (F.condExp_empty_star_mul_self h0)

end CARSystem

end HRTorus.Fermion.Pilot.Abstract
