/-!
# Fermion-model pilot, model (a): the slot Fock space as a concrete Jordan–Wigner space

Written by Claude Opus 5.5 (an AI model), 2026-10-23. **A pilot.** The definitions and the twenty
statements were written first and reviewed against the paper (phase (a)) and are unchanged; phase (b)
added the proofs and the proof devices of the section `ProofDevices`. **Every theorem is proved; there is no
`sorry`.** The paper: the HR paper,
`papers/hr/sections/03-slot-frame.tex` (Definition 3.7 `def:slotfock`, Lemma 3.8 `lem:embedding`(iii)
for the gauge transformations), `papers/hr/sections/02-setting.tex` (Definition 2.5 `def:fock`: the
CAR, "even") and `papers/hr/sections/05-locality.tex` (Lemma 5.1 `lem:condexp` and its proof).
The companion file `HRTorus/Fermion/Pilot/CAR.lean` states the same lemma in an abstract model.

## The model

* Slots: any finite type `S` (the paper's `𝒮 = ℤ_{n_x} × ℤ_{n_y}`; Lemma 5.1 uses no geometry).
  Spins: `Spin = {up, dn}`. Modes: `S × Spin`, the `(s, σ)` of the paper.
* The slot Fock space `𝔉_𝒮 = 𝔉(ℓ²(𝒮) ⊗ ℂ²)` is modelled as `ℂ^{Conf S}`, where
  `Conf S = (S × Spin → Bool)` is the set of occupation configurations (dimension `2^{2|𝒮|}`);
  the vector `e_m` is the occupation-number basis vector `|m⟩` of the proof of Lemma 5.1.
  Operators on `𝔉_𝒮` are the matrices `Op S = Matrix (Conf S) (Conf S) ℂ`; the adjoint is `ᴴ`;
  the operator norm is Mathlib's `L²` operator norm (scope `Matrix.Norms.L2Operator`, under which
  `Op S` is a C⋆-algebra); "positive" is `Matrix.PosSemidef`.
* The Jordan–Wigner numbering of the modes is one fixed (arbitrary) bijection
  `num : S × Spin ≃ Fin n` (`Fintype.equivFin`); `c μ` is the annihilator of mode `μ` given by
  the Jordan–Wigner formula with that numbering. Nothing stated below depends on the numbering.
* `CAR Y` is the unital star subalgebra generated by the `ĉ_{sσ}`, `s ∈ Y` (`StarAlgebra.adjoin`);
  sets of slots are `Finset S`.
* The parity `(-1)^{N̂↑+N̂↓}` and the gauge unitaries `e^{i(φ↑N̂↑+φ↓N̂↓)}` are given as the diagonal
  matrices they are in the occupation basis (`parityOp`, `gaugeOp`); `numberOp_eq`,
  `parityOp_eq_exp` and `gaugeOp_eq_exp` state that these agree with the paper's definitions.
* The Hilbert–Schmidt inner product: the matrices are carried to `EuclideanSpace ℂ (Conf × Conf)`
  by the linear equivalence `hsEquiv` (the entries as one vector), whose inner product is
  `Tr(Aᴴ B)` (`inner_hsEquiv`). `condExp Y` is the orthogonal projection onto the image of
  `CAR Y` there, carried back: literally the paper's definition of `𝔼_Y`.
-/

open Matrix Complex
open scoped ComplexOrder Matrix.Norms.L2Operator InnerProductSpace

noncomputable section

namespace HRTorus.Fermion.Pilot.JW

/-- The spin label `σ ∈ {↑, ↓}`. -/
inductive Spin
  | up
  | dn
  deriving DecidableEq, Inhabited

/-- `Spin` is finite (written out: Mathlib's `deriving Fintype` handler fails on this toolchain). -/
instance : Fintype Spin where
  elems := {Spin.up, Spin.dn}
  complete := by intro x; cases x <;> simp

variable {S : Type*} [Fintype S] [DecidableEq S]

/-- A mode `(s, σ)`: a slot and a spin. -/
abbrev Mode (S : Type*) := S × Spin

/-- An occupation configuration `m = (m_μ)`, `m_μ ∈ {0, 1}` (`false`, `true`). -/
abbrev Conf (S : Type*) := Mode S → Bool

/-- Operators on the slot Fock space `ℂ^{Conf S}`: complex matrices indexed by configurations. -/
abbrev Op (S : Type*) [Fintype S] [DecidableEq S] := Matrix (Conf S) (Conf S) ℂ

/-! ## The Jordan–Wigner annihilators -/

/-- The fixed numbering `μ ↦ num μ` of the modes used for the Jordan–Wigner signs (the paper's
proof of Lemma 5.1: "Number the $n:=2\abs{\Slots}$ modes $(s,\sigma)$ of $\FockS$ as
$\mu_1,\dots,\mu_n$"). -/
def num : Mode S ≃ Fin (Fintype.card (Mode S)) :=
  Fintype.equivFin (Mode S)

/-- The Jordan–Wigner sign `(-1)^{m_{μ_1}+⋯+m_{μ_{j-1}}}` of mode `μ = μ_j` in configuration `m`:
the parity of the number of occupied modes numbered before `μ`. -/
def jwSign (μ : Mode S) (m : Conf S) : ℂ :=
  (-1) ^ (Finset.univ.filter fun ν => num ν < num μ ∧ m ν = true).card

/-- The annihilator of mode `μ` (proof of Lemma 5.1):
`a_j\lvert n_1\cdots n_n\rangle=(-1)^{n_1+\cdots+n_{j-1}}\,n_j\,\lvert n_1\cdots n_{j-1}\,0\,n_{j+1}\cdots n_n\rangle`.
As a matrix: the entry at `(m', m)` is the sign when `m_μ = 1` and `m'` is `m` with mode `μ`
emptied, and `0` otherwise. -/
def c (μ : Mode S) : Op S :=
  Matrix.of fun m' m => if m μ = true ∧ m' = Function.update m μ false then jwSign μ m else 0

/-- **Definition 3.7**: `$\chat_{s\sigma}:=\chat(\delta_s\otimes\sigma)$`. -/
def chat (s : S) (σ : Spin) : Op S :=
  c (s, σ)

/-- **Definition 3.7**: `$\Nhat\sigma:=\sum_s\chat_{s\sigma}^*\chat_{s\sigma}$`. -/
def numberOp (σ : Spin) : Op S :=
  ∑ s, (chat s σ)ᴴ * chat s σ

/-! ## Parity, gauge, the local algebras -/

/-- The parity `(-1)^{\Nhat\up+\Nhat\dn}`, diagonal in the occupation basis with entry
`(-1)^{|m|}`, `|m|` the number of occupied modes (proof of Lemma 5.1:
`(-1)^{\widehat N}=\prod_j(\one-2a_j^*a_j)=\mathsf z^{\otimes n}`). -/
def parityOp : Op S :=
  Matrix.diagonal fun m => (-1 : ℂ) ^ (Finset.univ.filter fun μ => m μ = true).card

/-- The gauge unitary `e^{\iu(\varphi_\up\Nhat\up+\varphi_\dn\Nhat\dn)}` for
`φ = (φ↑, φ↓)` (here a function `Spin → ℝ`), diagonal in the occupation basis with entry
`exp(i Σ_{μ occupied} φ_{σ(μ)})` (proof of Lemma 5.1:
`e^{\iu(\varphi_\up\Nhat\up+\varphi_\dn\Nhat\dn)}=\bigotimes_je^{\iu\varphi_{\sigma(j)}a_j^*a_j}`). -/
def gaugeOp (φ : Spin → ℝ) : Op S :=
  Matrix.diagonal fun m => Complex.exp (I * ∑ μ : Mode S, if m μ = true then (φ μ.2 : ℂ) else 0)

/-- The parity automorphism (proof of Lemma 5.1): `A\mapsto(-1)^{\widehat N}A(-1)^{\widehat N}`. -/
def parity (A : Op S) : Op S :=
  parityOp * A * parityOp

/-- The gauge transformation of **Lemma 3.8(iii)** on `𝔉_𝒮`:
`e^{\iu(\varphi_\up\Nhat\up+\varphi_\dn\Nhat\dn)}\iota(A)e^{-\iu(\varphi_\up\Nhat\up+\varphi_\dn\Nhat\dn)}`
with `ι(A)` replaced by an arbitrary operator `A`. -/
def gauge (φ : Spin → ℝ) (A : Op S) : Op S :=
  gaugeOp φ * A * gaugeOp (-φ)

/-- **Definition 2.5/3.7**: an operator is even if it commutes with the parity
(`\emph{even} if it commutes with the parity $(-1)^{\Nup+\Ndn}$`). -/
def IsEven (A : Op S) : Prop :=
  Commute A parityOp

/-- **Definition 3.7**: "For $X\subset\Slots$, $\CAR(X)$ is the unital $*$-algebra generated by the
$\chat_{s\sigma}$ with $s\in X$". -/
def CAR (Y : Finset S) : StarSubalgebra ℂ (Op S) :=
  StarAlgebra.adjoin ℂ {A | ∃ s ∈ Y, ∃ σ : Spin, A = chat s σ}

/-- **Definition 3.7**: "$\Alg(X)$ is its even part, the elements commuting with
$(-1)^{\Nhat\up+\Nhat\dn}$". -/
def Alg (Y : Finset S) : Set (Op S) :=
  {A | A ∈ CAR Y ∧ IsEven A}

/-! ## The Hilbert–Schmidt inner product and the conditional expectation -/

/-- The matrix entries of an operator as one vector of `EuclideanSpace ℂ (Conf × Conf)`; its inner
product is the Hilbert–Schmidt inner product `Tr(Aᴴ B)` (`inner_hsEquiv`). -/
def hsEquiv : Op S ≃ₗ[ℂ] EuclideanSpace ℂ (Conf S × Conf S) :=
  (Matrix.ofLinearEquiv ℂ).symm ≪≫ₗ (LinearEquiv.curry ℂ ℂ (Conf S) (Conf S)).symm ≪≫ₗ
    (WithLp.linearEquiv 2 ℂ (Conf S × Conf S → ℂ)).symm

/-- The image of `CAR(Y)` in the Hilbert–Schmidt space. -/
def hsCAR (Y : Finset S) : Submodule ℂ (EuclideanSpace ℂ (Conf S × Conf S)) :=
  (Subalgebra.toSubmodule (CAR Y).toSubalgebra).map (hsEquiv (S := S)).toLinearMap

/-- **Lemma 5.1** (the definition): "$\CE_Y$ be the trace-preserving conditional expectation from
the operators on $\FockS$ onto $\CAR(Y)$, that is, the orthogonal projection onto $\CAR(Y)$ for the
Hilbert--Schmidt inner product". -/
def condExp (Y : Finset S) (A : Op S) : Op S :=
  hsEquiv.symm ((hsCAR Y).starProjection (hsEquiv A))

/-! ## Proof devices (phase (b))

Lemmas and auxiliary definitions used by the proofs below; none of them is a statement of the
paper. Positivity and contractivity of `condExp` are proved by the C⋆-algebra route (the bimodule
property, the negative part by the continuous functional calculus, Kadison–Schwarz), which uses
no Jordan–Wigner signs. -/

section ProofDevices

/-! ### The Hilbert–Schmidt transport -/

theorem hsEquiv_apply (A : Op S) :
    hsEquiv A = WithLp.toLp 2 (fun p : Conf S × Conf S => A p.1 p.2) := rfl

theorem inner_hsEquiv_dev (A B : Op S) : ⟪hsEquiv A, hsEquiv B⟫_ℂ = (Aᴴ * B).trace := by
  rw [hsEquiv_apply, hsEquiv_apply, EuclideanSpace.inner_toLp_toLp]
  simp only [dotProduct, Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.conjTranspose_apply,
    Pi.star_apply]
  rw [Fintype.sum_prod_type, Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  ring

theorem mem_hsCAR_iff {Y : Finset S} {v : EuclideanSpace ℂ (Conf S × Conf S)} :
    v ∈ hsCAR Y ↔ hsEquiv.symm v ∈ CAR Y :=
  Submodule.mem_map_equiv _

theorem condExp_def (Y : Finset S) (A : Op S) :
    condExp Y A = hsEquiv.symm ((hsCAR Y).starProjection (hsEquiv A)) := rfl

theorem condExp_mem_dev (Y : Finset S) (A : Op S) : condExp Y A ∈ CAR Y :=
  mem_hsCAR_iff.mp ((hsCAR Y).starProjection_apply_mem (hsEquiv A))

theorem trace_conjTranspose_mul_eq_zero_iff {M B : Op S} :
    (Mᴴ * B).trace = 0 ↔ (Bᴴ * M).trace = 0 := by
  have e : Mᴴ * B = (Bᴴ * M)ᴴ := by rw [conjTranspose_mul, conjTranspose_conjTranspose]
  rw [e, trace_conjTranspose, star_eq_zero]

theorem condExp_eq_of {Y : Finset S} {A X : Op S} (hX : X ∈ CAR Y)
    (h : ∀ B ∈ CAR Y, (Bᴴ * (A - X)).trace = 0) : condExp Y A = X := by
  rw [condExp_def]
  have key : (hsCAR Y).starProjection (hsEquiv A) = hsEquiv X := by
    apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
    · rw [mem_hsCAR_iff, LinearEquiv.symm_apply_apply]; exact hX
    · intro w hw
      rw [mem_hsCAR_iff] at hw
      rw [← map_sub, ← LinearEquiv.apply_symm_apply hsEquiv w, inner_hsEquiv_dev]
      exact trace_conjTranspose_mul_eq_zero_iff.mpr (h _ hw)
  rw [key, LinearEquiv.symm_apply_apply]

theorem trace_conjTranspose_mul_sub_condExp_dev (Y : Finset S) (A : Op S) {B : Op S}
    (hB : B ∈ CAR Y) : (Bᴴ * (A - condExp Y A)).trace = 0 := by
  have h := (hsCAR Y).starProjection_inner_eq_zero (hsEquiv A) (hsEquiv B)
    (by rw [mem_hsCAR_iff, LinearEquiv.symm_apply_apply]; exact hB)
  have e : (hsCAR Y).starProjection (hsEquiv A) = hsEquiv (condExp Y A) := by
    rw [condExp_def, LinearEquiv.apply_symm_apply]
  rw [e, ← map_sub, inner_hsEquiv_dev] at h
  exact trace_conjTranspose_mul_eq_zero_iff.mp h

theorem condExp_of_mem {Y : Finset S} {A : Op S} (hA : A ∈ CAR Y) : condExp Y A = A :=
  condExp_eq_of hA fun B _ => by rw [sub_self, Matrix.mul_zero, trace_zero]

theorem condExp_isLinearMap_dev (Y : Finset S) : IsLinearMap ℂ (condExp Y) :=
  ⟨fun A B => by simp only [condExp_def, map_add], fun c A => by simp only [condExp_def, map_smul]⟩

theorem condExp_one_dev (Y : Finset S) : condExp Y (1 : Op S) = 1 :=
  condExp_of_mem (one_mem _)

theorem condExp_condExp_dev (Y : Finset S) (A : Op S) : condExp Y (condExp Y A) = condExp Y A :=
  condExp_of_mem (condExp_mem_dev Y A)

theorem trace_condExp_dev (Y : Finset S) (A : Op S) : (condExp Y A).trace = A.trace := by
  have h := trace_conjTranspose_mul_sub_condExp_dev Y A (one_mem (CAR Y))
  rw [conjTranspose_one, Matrix.one_mul, trace_sub, sub_eq_zero] at h
  exact h.symm

theorem conjTranspose_mem_CAR {Y : Finset S} {B : Op S} (hB : B ∈ CAR Y) : Bᴴ ∈ CAR Y := by
  rw [← star_eq_conjTranspose]; exact star_mem hB

theorem condExp_conjTranspose_dev (Y : Finset S) (A : Op S) :
    condExp Y Aᴴ = (condExp Y A)ᴴ := by
  apply condExp_eq_of (conjTranspose_mem_CAR (condExp_mem_dev Y A))
  intro B hB
  have h := trace_conjTranspose_mul_sub_condExp_dev Y A (conjTranspose_mem_CAR hB)
  rw [conjTranspose_conjTranspose] at h
  rw [← conjTranspose_sub, ← conjTranspose_mul, trace_conjTranspose, trace_mul_comm, h, star_zero]

theorem condExp_mul_mul {Y : Finset S} {B C : Op S} (hB : B ∈ CAR Y) (hC : C ∈ CAR Y) (X : Op S) :
    condExp Y (B * X * C) = B * condExp Y X * C := by
  apply condExp_eq_of (mul_mem (mul_mem hB (condExp_mem_dev Y X)) hC)
  intro D hD
  have h := trace_conjTranspose_mul_sub_condExp_dev Y X
    (mul_mem (mul_mem (conjTranspose_mem_CAR hB) hD) (conjTranspose_mem_CAR hC))
  have e : Dᴴ * (B * X * C - B * condExp Y X * C) =
      (Dᴴ * B) * (X - condExp Y X) * C := by
    simp only [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_assoc]
  rw [e, trace_mul_comm, ← Matrix.mul_assoc, ← Matrix.mul_assoc]
  rw [conjTranspose_mul, conjTranspose_mul, conjTranspose_conjTranspose,
    conjTranspose_conjTranspose] at h
  simpa only [Matrix.mul_assoc] using h

theorem norm_sub_condExp_le_two_mul_of_contraction
    (hc : ∀ (Y : Finset S) (A : Op S), ‖condExp Y A‖ ≤ ‖A‖) (Y : Finset S) (A : Op S) {A' : Op S}
    (hA' : A' ∈ Alg Y) : ‖A - condExp Y A‖ ≤ 2 * ‖A - A'‖ := by
  have hfix : condExp Y A' = A' := condExp_of_mem hA'.1
  have e : A - condExp Y A = (A - A') - condExp Y (A - A') := by
    rw [(condExp_isLinearMap_dev Y).map_sub, hfix]; abel
  rw [e]
  calc ‖(A - A') - condExp Y (A - A')‖ ≤ ‖A - A'‖ + ‖condExp Y (A - A')‖ := norm_sub_le _ _
    _ ≤ ‖A - A'‖ + ‖A - A'‖ := by gcongr; exact hc Y _
    _ = 2 * ‖A - A'‖ := by ring

/-! ### Positivity and contractivity: the C⋆ route -/

section Order

open scoped MatrixOrder

theorem isClosed_CAR (Y : Finset S) : IsClosed (CAR Y : Set (Op S)) :=
  (Subalgebra.toSubmodule (CAR Y).toSubalgebra).closed_of_finiteDimensional

theorem condExp_posSemidef_dev (Y : Finset S) {A : Op S} (hA : A.PosSemidef) :
    (condExp Y A).PosSemidef := by
  set H := condExp Y A with hH
  have hHsa : IsSelfAdjoint H := by
    rw [IsSelfAdjoint, star_eq_conjTranspose, hH, ← condExp_conjTranspose_dev, hA.isHermitian.eq]
  have := isClosed_CAR Y
  have hNmem : H⁻ ∈ CAR Y := by
    rw [CFC.negPart_def]; exact cfcₙ_mem (𝕜' := ℂ) _ (condExp_mem_dev Y A)
  have hN0 : 0 ≤ H⁻ := CFC.negPart_nonneg H
  have hNpsd : (H⁻).PosSemidef := Matrix.nonneg_iff_posSemidef.mp hN0
  have hNh : (H⁻)ᴴ = H⁻ := hNpsd.isHermitian.eq
  have hNP : H⁻ * H⁺ = 0 := CFC.negPart_mul_posPart H
  have hdec : H⁺ - H⁻ = H := CFC.posPart_sub_negPart H hHsa
  have e1 : H⁻ * H * H⁻ = -(H⁻ * H⁻ * H⁻) := by
    calc H⁻ * H * H⁻ = H⁻ * (H⁺ - H⁻) * H⁻ := by rw [hdec]
      _ = -(H⁻ * H⁻ * H⁻) := by rw [Matrix.mul_sub, hNP, zero_sub, Matrix.neg_mul]
  have e2 : (H⁻ * H * H⁻).trace = (H⁻ * A * H⁻).trace := by
    rw [hH, ← condExp_mul_mul hNmem hNmem, trace_condExp_dev]
  have t1 : 0 ≤ (H⁻ * A * H⁻).trace := by
    have := hA.conjTranspose_mul_mul_same H⁻
    rw [hNh] at this
    exact this.trace_nonneg
  have hN3psd : (H⁻ * H⁻ * H⁻).PosSemidef := by
    have := hNpsd.conjTranspose_mul_mul_same H⁻
    rwa [hNh] at this
  have t2 : 0 ≤ (H⁻ * H⁻ * H⁻).trace := hN3psd.trace_nonneg
  have t3 : (H⁻ * H⁻ * H⁻).trace = 0 := by
    have h : (H⁻ * A * H⁻).trace = -(H⁻ * H⁻ * H⁻).trace := by rw [← e2, e1, trace_neg]
    refine le_antisymm ?_ t2
    rw [← neg_nonneg, ← h]
    exact t1
  have hN3 : H⁻ * H⁻ * H⁻ = 0 := hN3psd.trace_eq_zero_iff.mp t3
  have hN2 : H⁻ * H⁻ = 0 := by
    have h4 : ((H⁻ * H⁻)ᴴ * (H⁻ * H⁻)).trace = 0 := by
      rw [conjTranspose_mul, hNh, ← Matrix.mul_assoc, hN3, Matrix.zero_mul, trace_zero]
    exact Matrix.trace_conjTranspose_mul_self_eq_zero_iff.mp h4
  have hN : H⁻ = 0 := by
    have h2 : ((H⁻)ᴴ * H⁻).trace = 0 := by rw [hNh, hN2, trace_zero]
    exact Matrix.trace_conjTranspose_mul_self_eq_zero_iff.mp h2
  have hHP : H = H⁺ := by
    calc H = H⁺ - H⁻ := hdec.symm
      _ = H⁺ := by rw [hN, sub_zero]
  exact (congrArg Matrix.PosSemidef hHP).mpr (Matrix.nonneg_iff_posSemidef.mp (CFC.posPart_nonneg H))

theorem algebraMap_real_mem_CAR (Y : Finset S) (r : ℝ) : algebraMap ℝ (Op S) r ∈ CAR Y := by
  rw [Algebra.algebraMap_eq_smul_one, ← Complex.coe_smul]
  exact Subalgebra.smul_mem (CAR Y).toSubalgebra (one_mem _) _

theorem norm_condExp_le_of_nonneg (Y : Finset S) {Z : Op S} (hZ : 0 ≤ Z) :
    ‖condExp Y Z‖ ≤ ‖Z‖ := by
  have lin := condExp_isLinearMap_dev (S := S) Y
  have hZle : Z ≤ algebraMap ℝ (Op S) ‖Z‖ :=
    IsSelfAdjoint.le_algebraMap_norm_self Z (IsSelfAdjoint.of_nonneg hZ)
  have hpos : 0 ≤ condExp Y (algebraMap ℝ (Op S) ‖Z‖ - Z) :=
    Matrix.nonneg_iff_posSemidef.mpr
      (condExp_posSemidef_dev Y (Matrix.nonneg_iff_posSemidef.mp (sub_nonneg.mpr hZle)))
  rw [lin.map_sub, condExp_of_mem (algebraMap_real_mem_CAR Y _)] at hpos
  have hEle : condExp Y Z ≤ algebraMap ℝ (Op S) ‖Z‖ := sub_nonneg.mp hpos
  have hE0 : 0 ≤ condExp Y Z :=
    Matrix.nonneg_iff_posSemidef.mpr (condExp_posSemidef_dev Y (Matrix.nonneg_iff_posSemidef.mp hZ))
  calc ‖condExp Y Z‖ ≤ ‖algebraMap ℝ (Op S) ‖Z‖‖ :=
        CStarAlgebra.norm_le_norm_of_le_of_nonneg hEle hE0
    _ = ‖Z‖ := by
        rw [Algebra.algebraMap_eq_smul_one, norm_smul, CStarRing.norm_one, mul_one,
          Real.norm_of_nonneg (norm_nonneg _)]

theorem norm_condExp_le_dev (Y : Finset S) (A : Op S) : ‖condExp Y A‖ ≤ ‖A‖ := by
  set E := condExp Y A with hE
  have lin := condExp_isLinearMap_dev (S := S) Y
  have hEmem : E ∈ CAR Y := condExp_mem_dev Y A
  have h1 : condExp Y (Aᴴ * E) = Eᴴ * E := by
    have := condExp_mul_mul (one_mem _) hEmem Aᴴ
    rwa [Matrix.one_mul, Matrix.one_mul, condExp_conjTranspose_dev] at this
  have h2 : condExp Y (Eᴴ * A) = Eᴴ * E := by
    have := condExp_mul_mul (conjTranspose_mem_CAR hEmem) (one_mem _) A
    rwa [Matrix.mul_one, Matrix.mul_one] at this
  have h3 : condExp Y (Eᴴ * E) = Eᴴ * E := condExp_of_mem (mul_mem (conjTranspose_mem_CAR hEmem) hEmem)
  have hKe : condExp Y ((A - E)ᴴ * (A - E)) = condExp Y (Aᴴ * A) - Eᴴ * E := by
    rw [conjTranspose_sub, Matrix.sub_mul, Matrix.mul_sub, Matrix.mul_sub, lin.map_sub, lin.map_sub,
      lin.map_sub, h1, h2, h3]
    abel
  have hK : (condExp Y ((A - E)ᴴ * (A - E))).PosSemidef :=
    condExp_posSemidef_dev Y (posSemidef_conjTranspose_mul_self _)
  have hle : Eᴴ * E ≤ condExp Y (Aᴴ * A) := by rw [Matrix.le_iff, ← hKe]; exact hK
  have h0 : 0 ≤ Eᴴ * E := Matrix.nonneg_iff_posSemidef.mpr (posSemidef_conjTranspose_mul_self E)
  have hn1 : ‖Eᴴ * E‖ ≤ ‖condExp Y (Aᴴ * A)‖ := CStarAlgebra.norm_le_norm_of_le_of_nonneg hle h0
  have hn2 : ‖condExp Y (Aᴴ * A)‖ ≤ ‖Aᴴ * A‖ :=
    norm_condExp_le_of_nonneg Y (Matrix.nonneg_iff_posSemidef.mpr (posSemidef_conjTranspose_mul_self A))
  have hc1 : ‖Eᴴ * E‖ = ‖E‖ * ‖E‖ := by rw [← star_eq_conjTranspose]; exact CStarRing.norm_star_mul_self
  have hc2 : ‖Aᴴ * A‖ = ‖A‖ * ‖A‖ := by rw [← star_eq_conjTranspose]; exact CStarRing.norm_star_mul_self
  have hsq : ‖E‖ * ‖E‖ ≤ ‖A‖ * ‖A‖ := by rw [← hc1, ← hc2]; exact hn1.trans hn2
  exact mul_self_le_mul_self_iff (norm_nonneg _) (norm_nonneg _) |>.mpr hsq

end Order

/-! ### Diagonal unitaries: parity and gauge -/

theorem diagonal_mul_c_mul_conjTranspose {d : Conf S → ℂ} {μ : Mode S} {l : ℂ}
    (h : ∀ m : Conf S, m μ = true → d (Function.update m μ false) * star (d m) = l) :
    diagonal d * c μ * (diagonal d)ᴴ = l • c μ := by
  ext m' m
  rw [diagonal_conjTranspose, Matrix.mul_diagonal, Matrix.diagonal_mul]
  simp only [c, Matrix.of_apply, Matrix.smul_apply, smul_eq_mul, Pi.star_apply]
  split_ifs with hc
  · obtain ⟨hm, rfl⟩ := hc
    rw [← h m hm]
    ring
  · simp

theorem diagonal_conjTranspose_mul_diagonal {d : Conf S → ℂ} (hu : ∀ m, d m * star (d m) = 1) :
    (diagonal d)ᴴ * diagonal d = 1 := by
  rw [diagonal_conjTranspose, diagonal_mul_diagonal, ← diagonal_one]
  congr 1
  ext m
  rw [Pi.star_apply, mul_comm, hu]

theorem diagonal_mul_diagonal_conjTranspose {d : Conf S → ℂ} (hu : ∀ m, d m * star (d m) = 1) :
    diagonal d * (diagonal d)ᴴ = 1 := by
  rw [diagonal_conjTranspose, diagonal_mul_diagonal, ← diagonal_one]
  congr 1
  ext m
  rw [Pi.star_apply, hu]

theorem diagonal_conj_mem_CAR {d : Conf S → ℂ} (hu : ∀ m, d m * star (d m) = 1)
    (hph : ∀ μ : Mode S, ∃ l : ℂ, ∀ m : Conf S, m μ = true →
      d (Function.update m μ false) * star (d m) = l)
    {Y : Finset S} {X : Op S} (hX : X ∈ CAR Y) : diagonal d * X * (diagonal d)ᴴ ∈ CAR Y := by
  have hDD := diagonal_conjTranspose_mul_diagonal hu
  have hDD' := diagonal_mul_diagonal_conjTranspose hu
  have hX' : X ∈ Algebra.adjoin ℂ ({A | ∃ s ∈ Y, ∃ σ : Spin, A = chat s σ} ∪
      star {A | ∃ s ∈ Y, ∃ σ : Spin, A = chat s σ}) := hX
  refine Algebra.adjoin_induction (p := fun X _ => diagonal d * X * (diagonal d)ᴴ ∈ CAR Y)
    ?_ ?_ ?_ ?_ hX'
  · intro x hx
    rcases hx with ⟨s, hs, σ, rfl⟩ | hx
    · obtain ⟨l, hl⟩ := hph (s, σ)
      rw [chat, diagonal_mul_c_mul_conjTranspose hl]
      exact Subalgebra.smul_mem (CAR Y).toSubalgebra
        (StarAlgebra.subset_adjoin ℂ _ ⟨s, hs, σ, rfl⟩) _
    · obtain ⟨s, hs, σ, h⟩ := hx
      have hx : x = (chat s σ)ᴴ := by
        rw [← star_eq_conjTranspose, ← h, star_star]
      obtain ⟨l, hl⟩ := hph (s, σ)
      have e : diagonal d * (chat s σ)ᴴ * (diagonal d)ᴴ =
          (diagonal d * chat s σ * (diagonal d)ᴴ)ᴴ := by
        simp only [conjTranspose_mul, conjTranspose_conjTranspose, Matrix.mul_assoc]
      rw [hx, e, chat, diagonal_mul_c_mul_conjTranspose hl, conjTranspose_smul]
      exact Subalgebra.smul_mem (CAR Y).toSubalgebra
        (conjTranspose_mem_CAR (StarAlgebra.subset_adjoin ℂ _ ⟨s, hs, σ, rfl⟩)) _
  · intro r
    rw [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_one, hDD']
    exact Subalgebra.smul_mem (CAR Y).toSubalgebra (one_mem _) _
  · intro x y _ _ hx hy
    rw [Matrix.mul_add, Matrix.add_mul]; exact add_mem hx hy
  · intro x y _ _ hx hy
    have e : diagonal d * (x * y) * (diagonal d)ᴴ =
        (diagonal d * x * (diagonal d)ᴴ) * (diagonal d * y * (diagonal d)ᴴ) := by
      calc diagonal d * (x * y) * (diagonal d)ᴴ
          = diagonal d * x * ((diagonal d)ᴴ * diagonal d) * y * (diagonal d)ᴴ := by
            rw [hDD, Matrix.mul_one]; simp only [Matrix.mul_assoc]
        _ = _ := by simp only [Matrix.mul_assoc]
    rw [e]; exact mul_mem hx hy

theorem condExp_conj_diagonal {d : Conf S → ℂ} (hu : ∀ m, d m * star (d m) = 1)
    (hph : ∀ μ : Mode S, ∃ l : ℂ, ∀ m : Conf S, m μ = true →
      d (Function.update m μ false) * star (d m) = l)
    (Y : Finset S) (A : Op S) :
    condExp Y (diagonal d * A * (diagonal d)ᴴ) = diagonal d * condExp Y A * (diagonal d)ᴴ := by
  apply condExp_eq_of (diagonal_conj_mem_CAR hu hph (condExp_mem_dev Y A))
  intro B hB
  have hu' : ∀ m, (star d) m * star ((star d) m) = 1 := by
    intro m; rw [Pi.star_apply, star_star, mul_comm, hu]
  have hph' : ∀ μ : Mode S, ∃ l : ℂ, ∀ m : Conf S, m μ = true →
      (star d) (Function.update m μ false) * star ((star d) m) = l := by
    intro μ
    obtain ⟨l, hl⟩ := hph μ
    exact ⟨star l, fun m hm => by
      rw [Pi.star_apply, Pi.star_apply, star_star, ← hl m hm, star_mul', star_star, mul_comm]⟩
  have hB' := diagonal_conj_mem_CAR hu' hph' hB
  rw [← diagonal_conjTranspose, conjTranspose_conjTranspose] at hB'
  have h := trace_conjTranspose_mul_sub_condExp_dev Y A hB'
  have e1 : Bᴴ * (diagonal d * A * (diagonal d)ᴴ - diagonal d * condExp Y A * (diagonal d)ᴴ) =
      (Bᴴ * diagonal d) * (A - condExp Y A) * (diagonal d)ᴴ := by
    simp only [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_assoc]
  rw [e1, trace_mul_comm, ← Matrix.mul_assoc, ← Matrix.mul_assoc]
  rw [conjTranspose_mul, conjTranspose_mul, conjTranspose_conjTranspose] at h
  simpa only [Matrix.mul_assoc] using h

/-- The number of occupied modes (a proof device). -/
def occ (m : Conf S) : ℕ := (Finset.univ.filter fun μ => m μ = true).card

theorem occ_update {m : Conf S} {μ : Mode S} (hm : m μ = true) :
    occ m = occ (Function.update m μ false) + 1 := by
  unfold occ
  rw [← Finset.card_insert_of_notMem (s := Finset.univ.filter fun ν => Function.update m μ false ν = true)
    (a := μ) (by simp)]
  congr 1
  ext ν
  by_cases h : ν = μ
  · subst h; simp [hm]
  · simp [h]

theorem parityOp_eq_diagonal : (parityOp : Op S) = diagonal fun m => (-1 : ℂ) ^ occ m := rfl

theorem parity_eq_conj (A : Op S) : parity A = diagonal (fun m : Conf S => (-1 : ℂ) ^ occ m) * A *
    (diagonal fun m : Conf S => (-1 : ℂ) ^ occ m)ᴴ := by
  rw [parity, parityOp_eq_diagonal, diagonal_conjTranspose]
  congr 2
  ext m
  rw [Pi.star_apply, star_pow, star_neg, star_one]

omit [DecidableEq S] in
theorem parity_unit (m : Conf S) : (-1 : ℂ) ^ occ m * star ((-1 : ℂ) ^ occ m) = 1 := by
  rw [star_pow, star_neg, star_one, ← mul_pow, neg_one_mul, neg_neg, one_pow]

theorem parity_phase (μ : Mode S) : ∃ l : ℂ, ∀ m : Conf S, m μ = true →
    (-1 : ℂ) ^ occ (Function.update m μ false) * star ((-1 : ℂ) ^ occ m) = l :=
  ⟨-1, fun m hm => by
    rw [occ_update hm, star_pow, star_neg, star_one, pow_succ, mul_neg_one, mul_neg, ← mul_pow,
      neg_one_mul, neg_neg, one_pow]⟩

theorem condExp_parity_dev (Y : Finset S) (A : Op S) : condExp Y (parity A) = parity (condExp Y A) := by
  rw [parity_eq_conj, parity_eq_conj, condExp_conj_diagonal parity_unit parity_phase]

/-- The phase of the gauge unitary on a configuration (a proof device). -/
def gaugePhase (φ : Spin → ℝ) (m : Conf S) : ℂ :=
  ∑ μ : Mode S, if m μ = true then (φ μ.2 : ℂ) else 0

theorem gaugePhase_update (φ : Spin → ℝ) {m : Conf S} {μ : Mode S} (hm : m μ = true) :
    gaugePhase φ m = gaugePhase φ (Function.update m μ false) + (φ μ.2 : ℂ) := by
  unfold gaugePhase
  rw [← Finset.add_sum_erase _ _ (Finset.mem_univ μ), ← Finset.add_sum_erase _ _ (Finset.mem_univ μ)]
  rw [Function.update_self]
  simp only [hm, ite_true, Bool.false_eq_true, ite_false, zero_add]
  rw [add_comm]
  congr 1
  refine Finset.sum_congr rfl fun ν hν => ?_
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hν)]

omit [DecidableEq S] in
theorem star_gaugePhase (φ : Spin → ℝ) (m : Conf S) : star (gaugePhase φ m) = gaugePhase φ m := by
  unfold gaugePhase
  rw [star_sum]
  refine Finset.sum_congr rfl fun ν _ => ?_
  split_ifs <;> simp [Complex.conj_ofReal]

theorem gauge_eq_conj (φ : Spin → ℝ) (A : Op S) : gauge φ A =
    diagonal (fun m : Conf S => Complex.exp (I * gaugePhase φ m)) * A *
      (diagonal fun m : Conf S => Complex.exp (I * gaugePhase φ m))ᴴ := by
  rw [gauge, gaugeOp, gaugeOp, diagonal_conjTranspose]
  congr 2
  ext m
  rw [Pi.star_apply, Complex.star_def, ← Complex.exp_conj, map_mul, Complex.conj_I,
    ← Complex.star_def, star_gaugePhase]
  unfold gaugePhase
  rw [neg_mul, ← mul_neg, ← Finset.sum_neg_distrib]
  congr 2
  refine Finset.sum_congr rfl fun ν _ => ?_
  split_ifs <;> simp

omit [DecidableEq S] in
theorem gauge_unit (φ : Spin → ℝ) (m : Conf S) :
    Complex.exp (I * gaugePhase φ m) * star (Complex.exp (I * gaugePhase φ m)) = 1 := by
  rw [Complex.star_def, ← Complex.exp_conj, map_mul, Complex.conj_I, ← Complex.star_def,
    star_gaugePhase, ← Complex.exp_add, neg_mul, add_neg_cancel, Complex.exp_zero]

theorem gauge_phase (φ : Spin → ℝ) (μ : Mode S) : ∃ l : ℂ, ∀ m : Conf S, m μ = true →
    Complex.exp (I * gaugePhase φ (Function.update m μ false)) *
      star (Complex.exp (I * gaugePhase φ m)) = l :=
  ⟨Complex.exp (-(I * (φ μ.2 : ℂ))), fun m hm => by
    rw [Complex.star_def, ← Complex.exp_conj, map_mul, Complex.conj_I, ← Complex.star_def,
      star_gaugePhase, gaugePhase_update φ hm, ← Complex.exp_add]
    congr 1
    ring⟩

theorem condExp_gauge_dev (Y : Finset S) (φ : Spin → ℝ) (A : Op S) :
    condExp Y (gauge φ A) = gauge φ (condExp Y A) := by
  rw [gauge_eq_conj, gauge_eq_conj, condExp_conj_diagonal (gauge_unit φ) (gauge_phase φ)]

theorem parityOp_mul_parityOp : (parityOp : Op S) * parityOp = 1 := by
  rw [parityOp_eq_diagonal, diagonal_mul_diagonal, ← diagonal_one]
  congr 1; ext m; rw [← mul_pow, neg_one_mul, neg_neg, one_pow]

theorem condExp_mem_Alg_dev (Y : Finset S) {A : Op S} (hA : IsEven A) : condExp Y A ∈ Alg Y := by
  refine ⟨condExp_mem_dev Y A, ?_⟩
  have hP : parity A = A := by
    rw [parity, Matrix.mul_assoc, hA.eq, ← Matrix.mul_assoc, parityOp_mul_parityOp, Matrix.one_mul]
  have h := condExp_parity_dev Y A
  rw [hP] at h
  show condExp Y A * parityOp = parityOp * condExp Y A
  conv_lhs => rw [h]
  rw [parity, Matrix.mul_assoc, parityOp_mul_parityOp, Matrix.mul_one]

theorem norm_sub_condExp_le_dev (Y : Finset S) {A : Op S} (_hA : IsEven A) :
    ‖A - condExp Y A‖ ≤ 2 * ⨅ A' : Alg Y, ‖A - (A' : Op S)‖ := by
  have hne : Nonempty (Alg Y) := ⟨⟨0, zero_mem _, Commute.zero_left _⟩⟩
  have h : ‖A - condExp Y A‖ / 2 ≤ ⨅ A' : Alg Y, ‖A - (A' : Op S)‖ :=
    le_ciInf fun A' => by
      have := norm_sub_condExp_le_two_mul_of_contraction norm_condExp_le_dev Y A A'.2
      linarith
  linarith

/-! ### Jordan–Wigner signs -/

theorem c_apply (μ : Mode S) (m' m : Conf S) :
    c μ m' m = if m μ = true ∧ m' = Function.update m μ false then jwSign μ m else 0 := rfl

/-- The number of occupied modes numbered before `μ` (a proof device). -/
def cnt (μ : Mode S) (m : Conf S) : ℕ :=
  (Finset.univ.filter fun ν => num ν < num μ ∧ m ν = true).card

omit [DecidableEq S] in
theorem jwSign_eq (μ : Mode S) (m : Conf S) : jwSign μ m = (-1 : ℂ) ^ cnt μ m := rfl

omit [DecidableEq S] in
theorem star_jwSign (μ : Mode S) (m : Conf S) : star (jwSign μ m) = jwSign μ m := by
  rw [jwSign_eq, star_pow, star_neg, star_one]

omit [DecidableEq S] in
theorem jwSign_mul_self (μ : Mode S) (m : Conf S) : jwSign μ m * jwSign μ m = 1 := by
  rw [jwSign_eq, ← mul_pow, neg_one_mul, neg_neg, one_pow]

theorem cnt_update_self (μ : Mode S) (m : Conf S) (b : Bool) :
    cnt μ (Function.update m μ b) = cnt μ m := by
  unfold cnt
  congr 1
  ext ν
  by_cases h : ν = μ
  · subst h; simp
  · simp [Function.update_of_ne h]

theorem cnt_update_true {μ ρ : Mode S} (h : ρ ≠ μ) {m : Conf S} (hρ : m ρ = false) :
    cnt μ (Function.update m ρ true) = cnt μ m + (if num ρ < num μ then 1 else 0) := by
  unfold cnt
  split_ifs with hlt
  · rw [← Finset.card_insert_of_notMem (a := ρ) (by simp [hρ])]
    congr 1
    ext ν
    by_cases hν : ν = ρ
    · subst hν; simp [hlt]
    · simp [hν]
  · rw [add_zero]
    congr 1
    ext ν
    by_cases hν : ν = ρ
    · subst hν; simp [hlt, hρ]
    · simp [Function.update_of_ne hν]

theorem jwSign_update_self (μ : Mode S) (m : Conf S) (b : Bool) :
    jwSign μ (Function.update m μ b) = jwSign μ m := by
  rw [jwSign_eq, jwSign_eq, cnt_update_self]

theorem jwSign_update_true {μ ρ : Mode S} (h : ρ ≠ μ) {m : Conf S} (hρ : m ρ = false) :
    jwSign μ (Function.update m ρ true) = (if num ρ < num μ then -1 else 1) * jwSign μ m := by
  rw [jwSign_eq, jwSign_eq, cnt_update_true h hρ, pow_add]
  split_ifs <;> simp [mul_comm]

theorem sum_mul_c (μ : Mode S) (g : Conf S → ℂ) (m : Conf S) :
    ∑ k, g k * c μ k m = if m μ = true then g (Function.update m μ false) * jwSign μ m else 0 := by
  rw [Fintype.sum_eq_single (Function.update m μ false)]
  · rw [c_apply]
    by_cases hm : m μ = true <;> simp [hm]
  · intro k hk
    rw [c_apply, ite_eq_right (fun h => hk h.2), mul_zero]

theorem sum_c_mul (μ : Mode S) (g : Conf S → ℂ) (m' : Conf S) :
    ∑ k, c μ m' k * g k =
      if m' μ = false then jwSign μ (Function.update m' μ true) * g (Function.update m' μ true)
      else 0 := by
  rw [Fintype.sum_eq_single (Function.update m' μ true)]
  · rw [c_apply, Function.update_self, Function.update_idem]
    by_cases hm : m' μ = false
    · rw [ite_eq_left ⟨rfl, (Function.update_eq_self_iff.mpr hm.symm).symm⟩, ite_eq_left hm]
    · rw [ite_eq_right (fun h => hm (by
          have := congrFun h.2 μ
          rw [Function.update_self] at this
          exact this)), ite_eq_right hm, zero_mul]
  · intro k hk
    rw [c_apply]
    split_ifs with h
    · exfalso
      apply hk
      obtain ⟨hk1, rfl⟩ := h
      rw [Function.update_idem, ← hk1, Function.update_eq_self]
    · rw [zero_mul]

theorem conjTranspose_c_mul_c_apply (ν μ : Mode S) (m' m : Conf S) :
    ((c ν)ᴴ * c μ) m' m =
      if m μ = true ∧ m' ν = true ∧ Function.update m μ false = Function.update m' ν false
      then jwSign ν m' * jwSign μ m else 0 := by
  rw [Matrix.mul_apply]
  simp only [conjTranspose_apply]
  rw [sum_mul_c μ (fun k => star (c ν k m')) m, c_apply]
  by_cases h1 : m μ = true
  · rw [ite_eq_left h1]
    by_cases h23 : m' ν = true ∧ Function.update m μ false = Function.update m' ν false
    · rw [ite_eq_left h23, ite_eq_left ⟨h1, h23⟩, star_jwSign]
    · rw [ite_eq_right h23, star_zero, zero_mul, ite_eq_right (fun h => h23 h.2)]
  · rw [ite_eq_right h1, ite_eq_right (fun h => h1 h.1)]

theorem c_mul_conjTranspose_c_apply (μ ν : Mode S) (m' m : Conf S) :
    (c μ * (c ν)ᴴ) m' m =
      if m' μ = false ∧ (Function.update m' μ true) ν = true ∧
        m = Function.update (Function.update m' μ true) ν false
      then jwSign μ (Function.update m' μ true) * jwSign ν (Function.update m' μ true) else 0 := by
  rw [Matrix.mul_apply]
  simp only [conjTranspose_apply]
  rw [sum_c_mul μ (fun k => star (c ν m k)) m', c_apply]
  by_cases h1 : m' μ = false
  · rw [ite_eq_left h1]
    by_cases h23 : (Function.update m' μ true) ν = true ∧
        m = Function.update (Function.update m' μ true) ν false
    · rw [ite_eq_left h23, ite_eq_left ⟨h1, h23⟩, star_jwSign]
    · rw [ite_eq_right h23, star_zero, mul_zero, ite_eq_right (fun h => h23 h.2)]
  · rw [ite_eq_right h1, ite_eq_right (fun h => h1 h.1)]

omit [Fintype S] in
theorem cond_E1_to_E2 {μ ν : Mode S} (h : μ ≠ ν) {m' m : Conf S} (h1 : m μ = true)
    (h2 : m' ν = true) (h3 : Function.update m μ false = Function.update m' ν false) :
    m' μ = false ∧ (Function.update m' μ true) ν = true ∧
      m = Function.update (Function.update m' μ true) ν false := by
  have hμ := congrFun h3 μ
  have hν := congrFun h3 ν
  rw [Function.update_self, Function.update_of_ne h] at hμ
  rw [Function.update_self, Function.update_of_ne (Ne.symm h)] at hν
  refine ⟨hμ.symm, by rw [Function.update_of_ne (Ne.symm h)]; exact h2, ?_⟩
  funext ρ
  by_cases hρν : ρ = ν
  · subst hρν; rw [Function.update_self]; exact hν
  · rw [Function.update_of_ne hρν]
    by_cases hρμ : ρ = μ
    · subst hρμ; rw [Function.update_self]; exact h1
    · rw [Function.update_of_ne hρμ]
      have := congrFun h3 ρ
      rwa [Function.update_of_ne hρμ, Function.update_of_ne hρν] at this

omit [Fintype S] in
theorem cond_E2_to_E1 {μ ν : Mode S} (h : μ ≠ ν) {m' m : Conf S} (h1 : m' μ = false)
    (h2 : (Function.update m' μ true) ν = true)
    (h3 : m = Function.update (Function.update m' μ true) ν false) :
    m μ = true ∧ m' ν = true ∧ Function.update m μ false = Function.update m' ν false := by
  rw [Function.update_of_ne (Ne.symm h)] at h2
  refine ⟨by rw [h3, Function.update_of_ne h, Function.update_self], h2, ?_⟩
  funext ρ
  by_cases hρμ : ρ = μ
  · subst hρμ; rw [Function.update_self, Function.update_of_ne h]; exact h1.symm
  · rw [Function.update_of_ne hρμ]
    by_cases hρν : ρ = ν
    · subst hρν; rw [Function.update_self, h3, Function.update_self]
    · rw [Function.update_of_ne hρν, h3, Function.update_of_ne hρν, Function.update_of_ne hρμ]

omit [DecidableEq S] in
theorem num_lt_or {μ ν : Mode S} (h : μ ≠ ν) :
    (if num ν < num μ then (-1 : ℂ) else 1) * (if num μ < num ν then -1 else 1) = -1 := by
  have hne : num μ ≠ num ν := fun e => h (num.injective e)
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · rw [ite_eq_right (not_lt.mpr hlt.le), ite_eq_left hlt]; ring
  · rw [ite_eq_left hlt, ite_eq_right (not_lt.mpr hlt.le)]; ring

omit [Fintype S] in
theorem eq_of_update_eq {μ : Mode S} {m m' : Conf S} (h1 : m μ = true) (h2 : m' μ = true)
    (h3 : Function.update m μ false = Function.update m' μ false) : m' = m := by
  funext ρ
  by_cases hρ : ρ = μ
  · subst hρ; rw [h1, h2]
  · have := congrFun h3 ρ
    rw [Function.update_of_ne hρ, Function.update_of_ne hρ] at this
    exact this.symm

theorem c_anticomm_star_dev (μ ν : Mode S) :
    c μ * (c ν)ᴴ + (c ν)ᴴ * c μ = if μ = ν then 1 else 0 := by
  ext m' m
  rw [Matrix.add_apply, c_mul_conjTranspose_c_apply, conjTranspose_c_mul_c_apply]
  by_cases hμν : μ = ν
  · subst hμν
    rw [ite_eq_left rfl, Matrix.one_apply]
    simp only [Function.update_self, true_and, Function.update_idem]
    by_cases hmm : m' = m
    · subst hmm
      by_cases hb : m' μ = true
      · have hf : ¬ m' μ = false := by simp [hb]
        rw [ite_eq_right (fun h => hf h.1), ite_eq_left ⟨hb, hb, rfl⟩, jwSign_mul_self, zero_add,
          ite_eq_left rfl]
      · have hf : m' μ = false := by simpa using hb
        rw [ite_eq_left ⟨hf, (Function.update_eq_self_iff.mpr hf.symm).symm⟩, jwSign_mul_self,
          ite_eq_right (fun h => hb h.1), add_zero, ite_eq_left rfl]
    · rw [ite_eq_right (fun h => hmm (by
          rw [h.2, Function.update_eq_self_iff.mpr h.1.symm])),
        ite_eq_right (fun h => hmm (eq_of_update_eq h.1 h.2.1 h.2.2)), add_zero, ite_eq_right hmm]
  · rw [ite_eq_right hμν, Matrix.zero_apply]
    by_cases hE1 : m μ = true ∧ m' ν = true ∧ Function.update m μ false = Function.update m' ν false
    · obtain ⟨h1, h2, h3⟩ := hE1
      rw [ite_eq_left (cond_E1_to_E2 hμν h1 h2 h3), ite_eq_left ⟨h1, h2, h3⟩]
      set x := Function.update m μ false with hx
      have hxμ : x μ = false := by rw [hx, Function.update_self]
      have hxν : x ν = false := by rw [h3, Function.update_self]
      have hm : m = Function.update x μ true := by
        rw [hx, Function.update_idem, ← h1, Function.update_eq_self]
      have hm' : m' = Function.update x ν true := by
        rw [h3, Function.update_idem, ← h2, Function.update_eq_self]
      have hm1 : Function.update m' μ true = Function.update (Function.update x ν true) μ true := by
        rw [hm']
      rw [hm1, jwSign_update_self, jwSign_update_true (Ne.symm hμν) hxν,
        jwSign_update_true hμν (by rw [Function.update_of_ne hμν]; exact hxμ), jwSign_update_self,
        hm', jwSign_update_self, hm, jwSign_update_self]
      have hs := num_lt_or (S := S) hμν
      linear_combination (jwSign μ x * jwSign ν x) * hs
    · rw [ite_eq_right (fun h => hE1 (cond_E2_to_E1 hμν h.1 h.2.1 h.2.2)), ite_eq_right hE1, add_zero]

theorem c_mul_c_apply (μ ν : Mode S) (m' m : Conf S) :
    (c μ * c ν) m' m =
      if m ν = true ∧ (Function.update m ν false) μ = true ∧
        m' = Function.update (Function.update m ν false) μ false
      then jwSign μ (Function.update m ν false) * jwSign ν m else 0 := by
  rw [Matrix.mul_apply, sum_mul_c ν (fun k => c μ m' k) m, c_apply]
  by_cases h1 : m ν = true
  · rw [ite_eq_left h1]
    by_cases h23 : (Function.update m ν false) μ = true ∧
        m' = Function.update (Function.update m ν false) μ false
    · rw [ite_eq_left h23, ite_eq_left ⟨h1, h23⟩]
    · rw [ite_eq_right h23, zero_mul, ite_eq_right (fun h => h23 h.2)]
  · rw [ite_eq_right h1, ite_eq_right (fun h => h1 h.1)]

theorem jwSign_update_false {μ ρ : Mode S} (h : ρ ≠ μ) {m : Conf S} (hρ : m ρ = true) :
    jwSign μ (Function.update m ρ false) = (if num ρ < num μ then -1 else 1) * jwSign μ m := by
  have e := jwSign_update_true h (m := Function.update m ρ false) (Function.update_self ρ false m)
  rw [Function.update_idem, ← hρ, Function.update_eq_self] at e
  rw [e, ← mul_assoc]
  split_ifs <;> ring

theorem c_anticomm_dev (μ ν : Mode S) : c μ * c ν + c ν * c μ = 0 := by
  ext m' m
  rw [Matrix.add_apply, c_mul_c_apply, c_mul_c_apply, Matrix.zero_apply]
  by_cases hμν : μ = ν
  · subst hμν
    simp only [Function.update_self, Bool.false_eq_true, false_and, and_false, ite_false, add_zero]
  · by_cases hc : m ν = true ∧ m μ = true ∧ m' = Function.update (Function.update m ν false) μ false
    · obtain ⟨h1, h2, h3⟩ := hc
      rw [ite_eq_left ⟨h1, by rw [Function.update_of_ne hμν]; exact h2, h3⟩,
        ite_eq_left ⟨h2, by rw [Function.update_of_ne (Ne.symm hμν)]; exact h1,
          by rw [h3, Function.update_comm (Ne.symm hμν)]⟩,
        jwSign_update_false (Ne.symm hμν) h1, jwSign_update_false hμν h2]
      have hne : num μ ≠ num ν := fun e => hμν (num.injective e)
      rcases lt_or_gt_of_ne hne with hlt | hlt
      · rw [ite_eq_right (not_lt.mpr hlt.le), ite_eq_left hlt]; ring
      · rw [ite_eq_left hlt, ite_eq_right (not_lt.mpr hlt.le)]; ring
    · rw [ite_eq_right (fun h => hc ⟨h.1, by
            have := h.2.1; rwa [Function.update_of_ne hμν] at this, h.2.2⟩),
        ite_eq_right (fun h => hc ⟨by
            have := h.2.1; rwa [Function.update_of_ne (Ne.symm hμν)] at this,
          h.1, by rw [h.2.2, Function.update_comm hμν]⟩), add_zero]

theorem conjTranspose_c_mul_c_self (μ : Mode S) :
    (c μ)ᴴ * c μ = diagonal fun m : Conf S => if m μ = true then 1 else 0 := by
  ext m' m
  rw [conjTranspose_c_mul_c_apply, diagonal_apply]
  by_cases hmm : m' = m
  · subst hmm
    by_cases hb : m' μ = true
    · rw [ite_eq_left ⟨hb, hb, rfl⟩, jwSign_mul_self, ite_eq_left rfl, ite_eq_left hb]
    · rw [ite_eq_right (fun h => hb h.1), ite_eq_left rfl, ite_eq_right hb]
  · rw [ite_eq_right (fun h => hmm (eq_of_update_eq h.1 h.2.1 h.2.2)), ite_eq_right hmm]

theorem numberOp_eq_dev (σ : Spin) :
    numberOp σ =
      Matrix.diagonal fun m : Conf S => ((Finset.univ.filter fun s : S => m (s, σ) = true).card : ℂ) := by
  ext m' m
  rw [numberOp, Matrix.sum_apply]
  simp only [chat, conjTranspose_c_mul_c_self, diagonal_apply]
  by_cases hmm : m' = m
  · subst hmm
    simp only [ite_true]
    rw [Finset.sum_boole]
  · simp [hmm]

theorem sum_spin {M : Type*} [AddCommMonoid M] (g : Spin → M) : ∑ σ : Spin, g σ = g .up + g .dn := by
  rw [show (Finset.univ : Finset Spin) = {Spin.up, Spin.dn} from rfl, Finset.sum_pair (by decide)]

omit [DecidableEq S] in
theorem card_occ_split (m : Conf S) :
    ((Finset.univ.filter fun μ : Mode S => m μ = true).card : ℂ) =
      ((Finset.univ.filter fun s : S => m (s, .up) = true).card : ℂ) +
        ((Finset.univ.filter fun s : S => m (s, .dn) = true).card : ℂ) := by
  rw [← Finset.sum_boole, ← Finset.sum_boole, ← Finset.sum_boole, Fintype.sum_prod_type,
    ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun s _ => sum_spin _

theorem parityOp_eq_exp_dev :
    (parityOp : Op S) = NormedSpace.exp (((Real.pi : ℂ) * I) • (numberOp .up + numberOp .dn)) := by
  let _ : NormedAlgebra ℚ ℂ := NormedAlgebra.restrictScalars ℚ ℂ ℂ
  rw [numberOp_eq_dev, numberOp_eq_dev, diagonal_add, ← diagonal_smul, Matrix.exp_diagonal,
    Pi.exp_def, parityOp]
  congr 1
  funext m
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [← card_occ_split, ← Complex.exp_eq_exp_ℂ, mul_comm, Complex.exp_nat_mul,
    Complex.exp_pi_mul_I]

theorem gaugeOp_eq_exp_dev (φ : Spin → ℝ) :
    (gaugeOp φ : Op S) =
      NormedSpace.exp ((I * (φ .up : ℂ)) • numberOp .up + (I * (φ .dn : ℂ)) • numberOp .dn) := by
  let _ : NormedAlgebra ℚ ℂ := NormedAlgebra.restrictScalars ℚ ℂ ℂ
  rw [numberOp_eq_dev, numberOp_eq_dev, ← diagonal_smul, ← diagonal_smul, diagonal_add,
    Matrix.exp_diagonal, Pi.exp_def, gaugeOp]
  congr 1
  funext m
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [← Complex.exp_eq_exp_ℂ]
  congr 1
  have h : ∑ μ : Mode S, (if m μ = true then (φ μ.2 : ℂ) else 0) =
      (φ .up : ℂ) * ((Finset.univ.filter fun s : S => m (s, .up) = true).card : ℂ) +
        (φ .dn : ℂ) * ((Finset.univ.filter fun s : S => m (s, .dn) = true).card : ℂ) := by
    rw [Fintype.sum_prod_type]
    simp only [sum_spin]
    rw [Finset.sum_add_distrib, ← Finset.sum_boole, ← Finset.sum_boole, Finset.mul_sum,
      Finset.mul_sum]
    congr 1 <;> refine Finset.sum_congr rfl fun s _ => ?_ <;> split_ifs <;> simp
  rw [h]
  ring

/-! ### `CAR(𝒮)` is everything -/

theorem c_mem_CAR_univ (μ : Mode S) : c μ ∈ CAR (Finset.univ : Finset S) :=
  StarAlgebra.subset_adjoin ℂ _ ⟨μ.1, Finset.mem_univ _, μ.2, rfl⟩

theorem proj_mem_CAR_univ (μ : Mode S) (b : Bool) :
    diagonal (fun x : Conf S => if x μ = b then (1 : ℂ) else 0) ∈ CAR (Finset.univ : Finset S) := by
  have hn : (c μ)ᴴ * c μ ∈ CAR (Finset.univ : Finset S) :=
    mul_mem (conjTranspose_mem_CAR (c_mem_CAR_univ μ)) (c_mem_CAR_univ μ)
  cases b
  · have e : diagonal (fun x : Conf S => if x μ = false then (1 : ℂ) else 0) = 1 - (c μ)ᴴ * c μ := by
      rw [conjTranspose_c_mul_c_self, ← diagonal_one, diagonal_sub]
      congr 1
      funext x
      cases x μ <;> simp
    rw [e]
    exact sub_mem (one_mem _) hn
  · rw [← conjTranspose_c_mul_c_self]
    exact hn

theorem diagUnit_mem (m : Conf S) (T : Finset (Mode S)) :
    diagonal (fun x : Conf S => if ∀ μ ∈ T, x μ = m μ then (1 : ℂ) else 0) ∈
      CAR (Finset.univ : Finset S) := by
  induction T using Finset.induction_on with
  | empty => simp only [Finset.notMem_empty, IsEmpty.forall_iff, implies_true, ite_true, diagonal_one]
             exact one_mem _
  | insert μ T hμ ih =>
    have e : diagonal (fun x : Conf S => if ∀ ν ∈ insert μ T, x ν = m ν then (1 : ℂ) else 0) =
        diagonal (fun x : Conf S => if x μ = m μ then (1 : ℂ) else 0) *
          diagonal (fun x : Conf S => if ∀ ν ∈ T, x ν = m ν then (1 : ℂ) else 0) := by
      rw [diagonal_mul_diagonal]
      congr 1
      funext x
      simp only [Finset.forall_mem_insert]
      by_cases h1 : x μ = m μ <;> simp [h1]
    rw [e]
    exact mul_mem (proj_mem_CAR_univ μ (m μ)) ih

theorem single_diag_mem (m : Conf S) : single m m (1 : ℂ) ∈ CAR (Finset.univ : Finset S) := by
  have h := diagUnit_mem m Finset.univ
  have e : single m m (1 : ℂ) =
      diagonal (fun x : Conf S => if ∀ μ ∈ (Finset.univ : Finset (Mode S)), x μ = m μ then (1 : ℂ) else 0) := by
    ext i j
    rw [single_apply, diagonal_apply]
    by_cases hij : i = j
    · subst hij
      by_cases hm : m = i
      · subst hm; simp
      · rw [ite_eq_right (fun h => hm h.1), ite_eq_left rfl,
          ite_eq_right (fun h => hm (funext fun μ => (h μ (Finset.mem_univ μ)).symm))]
    · rw [ite_eq_right (fun h => hij (h.1.symm.trans h.2)), ite_eq_right hij]
  rw [e]
  exact h

theorem single_eq_c_mul {μ : Mode S} {k m' m : Conf S} (hk : k μ = true)
    (hm' : m' = Function.update k μ false) :
    single m' m (1 : ℂ) = jwSign μ k • (c μ * single k m 1) := by
  ext i j
  rw [Matrix.smul_apply, Matrix.mul_apply, Fintype.sum_eq_single k, single_apply, single_apply,
    c_apply, smul_eq_mul]
  · by_cases hi : m' = i
    · subst hi
      have hc : k μ = true ∧ m' = Function.update k μ false := ⟨hk, hm'⟩
      rw [ite_eq_left hc]
      by_cases hj : m = j
      · have h1 : m' = m' ∧ m = j := ⟨rfl, hj⟩
        have h2 : k = k ∧ m = j := ⟨rfl, hj⟩
        rw [ite_eq_left h1, ite_eq_left h2, mul_one, jwSign_mul_self]
      · rw [ite_eq_right (fun h => hj h.2), ite_eq_right (fun h => hj h.2), mul_zero, mul_zero]
    · have hc : ¬ (k μ = true ∧ i = Function.update k μ false) := fun h => hi (hm'.trans h.2.symm)
      rw [ite_eq_right (fun h => hi h.1), ite_eq_right hc, zero_mul, mul_zero]
  · intro l hl
    rw [single_apply, ite_eq_right (fun h => hl h.1.symm), mul_zero]

theorem single_eq_conjTranspose_c_mul {μ : Mode S} {k m' m : Conf S} (hk : k μ = false)
    (hm' : m' = Function.update k μ true) :
    single m' m (1 : ℂ) = jwSign μ m' • ((c μ)ᴴ * single k m 1) := by
  ext i j
  rw [Matrix.smul_apply, Matrix.mul_apply, Fintype.sum_eq_single k, single_apply, single_apply,
    conjTranspose_apply, c_apply, smul_eq_mul]
  · by_cases hi : m' = i
    · subst hi
      have hc : m' μ = true ∧ k = Function.update m' μ false := by
        refine ⟨by rw [hm', Function.update_self], ?_⟩
        rw [hm', Function.update_idem, ← hk, Function.update_eq_self]
      rw [ite_eq_left hc, star_jwSign]
      by_cases hj : m = j
      · rw [ite_eq_left ⟨rfl, hj⟩, ite_eq_left ⟨rfl, hj⟩, mul_one, jwSign_mul_self]
      · rw [ite_eq_right (fun h => hj h.2), ite_eq_right (fun h => hj h.2), mul_zero, mul_zero]
    · have hc : ¬ (i μ = true ∧ k = Function.update i μ false) := by
        rintro ⟨h1, h2⟩
        apply hi
        rw [hm', h2, Function.update_idem, ← h1, Function.update_eq_self]
      rw [ite_eq_right (fun h => hi h.1), ite_eq_right hc, star_zero, zero_mul, mul_zero]
  · intro l hl
    rw [single_apply, ite_eq_right (fun h => hl h.1.symm), mul_zero]

theorem single_mem_aux (m : Conf S) (T : Finset (Mode S)) :
    ∀ m' : Conf S, (∀ μ ∉ T, m' μ = m μ) → single m' m (1 : ℂ) ∈ CAR (Finset.univ : Finset S) := by
  induction T using Finset.induction_on with
  | empty =>
    intro m' h
    have : m' = m := funext fun μ => h μ (Finset.notMem_empty μ)
    subst this
    exact single_diag_mem m'
  | insert μ T hμT ih =>
    intro m' h
    set m'' := Function.update m' μ (m μ) with hm''def
    have h'' : ∀ ν ∉ T, m'' ν = m ν := by
      intro ν hν
      by_cases hνμ : ν = μ
      · subst hνμ; rw [hm''def, Function.update_self]
      · rw [hm''def, Function.update_of_ne hνμ]
        exact h ν (by simp [hνμ, hν])
    have hmem := ih m'' h''
    by_cases heq : m' μ = m μ
    · have e : m'' = m' := by rw [hm''def, ← heq, Function.update_eq_self]
      rw [e] at hmem
      exact hmem
    · cases hb : m' μ
      · have hmμ : m μ = true := by
          rw [hb] at heq; cases hmμ' : m μ <;> simp_all
        have hk : m'' μ = true := by rw [hm''def, Function.update_self, hmμ]
        have hm' : m' = Function.update m'' μ false := by
          rw [hm''def, Function.update_idem, ← hb, Function.update_eq_self]
        rw [single_eq_c_mul hk hm']
        exact Subalgebra.smul_mem (CAR _).toSubalgebra (mul_mem (c_mem_CAR_univ μ) hmem) _
      · have hmμ : m μ = false := by
          rw [hb] at heq; cases hmμ' : m μ <;> simp_all
        have hk : m'' μ = false := by rw [hm''def, Function.update_self, hmμ]
        have hm' : m' = Function.update m'' μ true := by
          rw [hm''def, Function.update_idem, ← hb, Function.update_eq_self]
        rw [single_eq_conjTranspose_c_mul hk hm']
        exact Subalgebra.smul_mem (CAR _).toSubalgebra
          (mul_mem (conjTranspose_mem_CAR (c_mem_CAR_univ μ)) hmem) _

theorem CAR_univ_dev : CAR (Finset.univ : Finset S) = ⊤ := by
  rw [eq_top_iff]
  intro A _
  rw [Matrix.matrix_eq_sum_single A]
  refine sum_mem fun i _ => sum_mem fun j _ => ?_
  rw [show single i j (A i j) = A i j • single i j (1 : ℂ) by rw [smul_single, smul_eq_mul, mul_one]]
  exact Subalgebra.smul_mem (CAR _).toSubalgebra
    (single_mem_aux j Finset.univ i (fun μ h => absurd (Finset.mem_univ μ) h)) _

end ProofDevices

/-! ## The model: the CAR, and agreement with the paper's definitions (statements) -/

/-- The canonical anticommutation relations (Definition 2.5: `$\{c(f),c(g)\}=0$`), for the
basis modes. -/
theorem c_anticomm (μ ν : Mode S) : c μ * c ν + c ν * c μ = 0 :=
  c_anticomm_dev μ ν

/-- The canonical anticommutation relations (Definition 2.5: `$\{c(f),c(g)^*\}=\ip fg$`), for the
basis modes `f = δ_μ`, `g = δ_ν`. -/
theorem c_anticomm_star (μ ν : Mode S) :
    c μ * (c ν)ᴴ + (c ν)ᴴ * c μ = if μ = ν then 1 else 0 :=
  c_anticomm_star_dev μ ν

/-- The number operator `N̂_σ` is diagonal in the occupation basis, with entry the number of
occupied modes of spin `σ`. -/
theorem numberOp_eq (σ : Spin) :
    numberOp σ =
      Matrix.diagonal fun m : Conf S => ((Finset.univ.filter fun s : S => m (s, σ) = true).card : ℂ) :=
  numberOp_eq_dev σ

/-- `parityOp` is the paper's `(-1)^{\Nhat\up+\Nhat\dn}`, as `e^{iπ(N̂↑+N̂↓)}`. -/
theorem parityOp_eq_exp :
    (parityOp : Op S) = NormedSpace.exp (((Real.pi : ℂ) * I) • (numberOp .up + numberOp .dn)) :=
  parityOp_eq_exp_dev

/-- `gaugeOp φ` is the paper's `e^{\iu(\varphi_\up\Nhat\up+\varphi_\dn\Nhat\dn)}`. -/
theorem gaugeOp_eq_exp (φ : Spin → ℝ) :
    (gaugeOp φ : Op S) =
      NormedSpace.exp ((I * (φ .up : ℂ)) • numberOp .up + (I * (φ .dn : ℂ)) • numberOp .dn) :=
  gaugeOp_eq_exp_dev φ

/-- The inner product of `hsEquiv` is the Hilbert–Schmidt inner product. -/
theorem inner_hsEquiv (A B : Op S) : ⟪hsEquiv A, hsEquiv B⟫_ℂ = (Aᴴ * B).trace :=
  inner_hsEquiv_dev A B

/-- The proof of Lemma 5.1, eq. (5.1) for `Y = 𝒮`: "For $Y=\Slots$ this says that $\CAR(\Slots)$ is the
algebra of all operators on $\FockS$". -/
theorem CAR_univ : CAR (Finset.univ : Finset S) = ⊤ :=
  CAR_univ_dev

/-! ## Lemma 5.1: what the definition of `𝔼_Y` says, in the paper's terms (statements) -/

/-- `𝔼_Y` maps onto (into) `CAR(Y)`. -/
theorem condExp_mem (Y : Finset S) (A : Op S) : condExp Y A ∈ CAR Y :=
  condExp_mem_dev Y A

/-- `A − 𝔼_Y(A)` is Hilbert–Schmidt orthogonal to `CAR(Y)`: `Tr(Bᴴ(A − 𝔼_Y(A))) = 0`. -/
theorem trace_conjTranspose_mul_sub_condExp (Y : Finset S) (A : Op S) {B : Op S}
    (hB : B ∈ CAR Y) : (Bᴴ * (A - condExp Y A)).trace = 0 :=
  trace_conjTranspose_mul_sub_condExp_dev Y A hB

/-- `𝔼_Y` is trace-preserving (Lemma 5.1's first sentence; its proof: "it preserves the trace"). -/
theorem trace_condExp (Y : Finset S) (A : Op S) : (condExp Y A).trace = A.trace :=
  trace_condExp_dev Y A

/-! ## Lemma 5.1 `lem:condexp`: the clauses (statements)

"Then $\CE_Y$ is linear, unital, positive, contractive, idempotent and $*$-preserving; it commutes
with the parity automorphism and with the gauge transformations of Lemma~\ref{lem:embedding}(iii);
it maps even operators into $\Alg(Y)$; and for every even $A$," followed by the display
"\norm{A-\CE_Y(A)}\le2\inf\{\norm{A-A'}:A'\in\Alg(Y)\}". The measurability sentence ("In
particular, if ...") is not stated. -/

/-- **Lemma 5.1**: `$\CE_Y$ is linear`. -/
theorem condExp_isLinearMap (Y : Finset S) : IsLinearMap ℂ (condExp Y) :=
  condExp_isLinearMap_dev Y

/-- **Lemma 5.1**: `unital`. -/
theorem condExp_one (Y : Finset S) : condExp Y (1 : Op S) = 1 :=
  condExp_one_dev Y

/-- **Lemma 5.1**: `positive` (positive semidefinite matrices to positive semidefinite matrices). -/
theorem condExp_posSemidef (Y : Finset S) {A : Op S} (hA : A.PosSemidef) :
    (condExp Y A).PosSemidef :=
  condExp_posSemidef_dev Y hA

/-- **Lemma 5.1**: `contractive` (in the operator norm). -/
theorem norm_condExp_le (Y : Finset S) (A : Op S) : ‖condExp Y A‖ ≤ ‖A‖ :=
  norm_condExp_le_dev Y A

/-- **Lemma 5.1**: `idempotent`. -/
theorem condExp_condExp (Y : Finset S) (A : Op S) : condExp Y (condExp Y A) = condExp Y A :=
  condExp_condExp_dev Y A

/-- **Lemma 5.1**: `$*$-preserving`. -/
theorem condExp_conjTranspose (Y : Finset S) (A : Op S) : condExp Y Aᴴ = (condExp Y A)ᴴ :=
  condExp_conjTranspose_dev Y A

/-- **Lemma 5.1**: `it commutes with the parity automorphism`. -/
theorem condExp_parity (Y : Finset S) (A : Op S) : condExp Y (parity A) = parity (condExp Y A) :=
  condExp_parity_dev Y A

/-- **Lemma 5.1**: it commutes `with the gauge transformations of Lemma~\ref{lem:embedding}(iii)`. -/
theorem condExp_gauge (Y : Finset S) (φ : Spin → ℝ) (A : Op S) :
    condExp Y (gauge φ A) = gauge φ (condExp Y A) :=
  condExp_gauge_dev Y φ A

/-- **Lemma 5.1**: `it maps even operators into $\Alg(Y)$`. -/
theorem condExp_mem_Alg (Y : Finset S) {A : Op S} (hA : IsEven A) : condExp Y A ∈ Alg Y :=
  condExp_mem_Alg_dev Y hA

/-- **Lemma 5.1**: `for every even $A$,` `\norm{A-\CE_Y(A)}\le2\inf\{\norm{A-A'}:A'\in\Alg(Y)\}`.
The infimum is over the subtype `Alg Y` (nonempty: it contains `0`). -/
theorem norm_sub_condExp_le (Y : Finset S) {A : Op S} (hA : IsEven A) :
    ‖A - condExp Y A‖ ≤ 2 * ⨅ A' : Alg Y, ‖A - (A' : Op S)‖ :=
  norm_sub_condExp_le_dev Y hA

end HRTorus.Fermion.Pilot.JW
