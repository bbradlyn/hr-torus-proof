/-! ## The dynamics, odd operators, and the measurability sentence of Lemma 5.1 (any finite `S`) -/

section Generic

variable {S : Type*} [Fintype S] [DecidableEq S]

/-- The Heisenberg dynamics generated by an operator `H`: §5's "`$\tau_t(A):=e^{\iu t\Hhat}Ae^{-\iu t\Hhat}$`" and
Appendix B's "`$\tau^X_t(A):=e^{\iu tH_X}Ae^{-\iu tH_X}$`", for any `H` (block B's `iota_conj_exp` form). -/
def dyn (H : Op S) (t : ℝ) (A : Op S) : Op S :=
  NormedSpace.exp ((I * (t : ℂ)) • H) * A * NormedSpace.exp ((-(I * (t : ℂ))) • H)

/-- An odd operator (Proposition B.1: "`are both odd`"): it anticommutes with the parity `(-1)^{N̂↑+N̂↓}`; the pilot's
`IsEven` is commuting with it. -/
def IsOdd (A : Op S) : Prop :=
  A * parityOp = -(parityOp * A)

/-- The elements of `CAR(Y)` of the parity of `A` (Theorem 5.3(b): "`A'\in\CAR(\fat X\rho)\text{ of the parity of }A`"):
even when `A` is even, odd when `A` is odd (no condition when `A` has neither parity). -/
def CARpar (Y : Finset S) (A : Op S) : Set (Op S) :=
  {A' | A' ∈ CAR Y ∧ (IsEven A → IsEven A') ∧ (IsOdd A → IsOdd A')}

/-- **Lemma 5.1**, the measurability sentence: "`In particular, if $u\mapsto A_u$ is continuous (respectively Borel) and $u\mapsto Y_u$ takes finitely many values on Borel sets, then $u\mapsto\CE_{Y_u}(A_u)$ is Borel`"
— the Borel case, Borel measurability of operator-valued maps taken entrywise (block C's convention), "takes finitely
many values on Borel sets" as: every fibre `{u : Y_u = Y₀}` is Borel (there are finitely many `Y₀`). -/
theorem measurable_condExp {U : Type*} [MeasurableSpace U] {A : U → Op S}
    (hA : ∀ m m' : Conf S, Measurable fun u => A u m m') {Y : U → Finset S}
    (hY : ∀ Y₀ : Finset S, MeasurableSet {u | Y u = Y₀}) :
    ∀ m m' : Conf S, Measurable fun u => condExp (Y u) (A u) m m' := by
  intro k k'
  have key : ∀ Y₀ : Finset S, Measurable fun u => condExp Y₀ (A u) k k' := by
    intro Y₀
    have hL := Fermion.Pilot.JW.condExp_isLinearMap (S := S) Y₀
    have hsum : ∀ (s : Finset (Conf S)) (F : Conf S → Op S),
        condExp Y₀ (∑ x ∈ s, F x) = ∑ x ∈ s, condExp Y₀ (F x) := fun s F =>
      map_sum (IsLinearMap.mk' (condExp Y₀) hL) F s
    have hrepr : ∀ B : Op S, condExp Y₀ B k k' =
        ∑ m : Conf S, ∑ m' : Conf S, B m m' * (condExp Y₀ (Matrix.single m m' 1)) k k' := by
      intro B
      have hB : condExp Y₀ B = ∑ m : Conf S, ∑ m' : Conf S, B m m' • condExp Y₀ (Matrix.single m m' 1) := by
        have e1 : condExp Y₀ B = condExp Y₀ (∑ m : Conf S, ∑ m' : Conf S, Matrix.single m m' (B m m')) := by
          rw [← Matrix.matrix_eq_sum_single B]
        rw [e1, hsum]
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [hsum]
        refine Finset.sum_congr rfl fun m' _ => ?_
        have hs : Matrix.single m m' (B m m') = B m m' • Matrix.single m m' (1 : ℂ) := by
          rw [Matrix.smul_single, smul_eq_mul, mul_one]
        rw [hs, hL.map_smul]
      rw [hB, Matrix.sum_apply]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [Matrix.sum_apply]
      refine Finset.sum_congr rfl fun m' _ => ?_
      rw [Matrix.smul_apply, smul_eq_mul]
    have hfun : (fun u => condExp Y₀ (A u) k k') =
        fun u => ∑ m : Conf S, ∑ m' : Conf S, A u m m' * (condExp Y₀ (Matrix.single m m' 1)) k k' :=
      funext fun u => hrepr (A u)
    rw [hfun]
    exact Finset.measurable_sum _ fun m _ => Finset.measurable_sum _ fun m' _ => (hA m m').mul_const _
  have hdecomp : (fun u => condExp (Y u) (A u) k k') =
      fun u => ∑ Y₀ : Finset S, ({u | Y u = Y₀} : Set U).indicator (fun u => condExp Y₀ (A u) k k') u := by
    funext u
    rw [Finset.sum_eq_single (Y u)]
    · simp [Set.indicator]
    · intro b _ hb
      simp only [Set.indicator, Set.mem_ofPred_eq]
      rw [ite_eq_right (Ne.symm hb)]
    · intro h
      exact absurd (Finset.mem_univ _) h
  rw [hdecomp]
  exact Finset.measurable_sum _ fun Y₀ _ => (key Y₀).indicator (hY Y₀)

/-- **Lemma 5.1**, the measurability sentence, the continuous case: for `u ↦ A_u` continuous on a topological space
with its Borel sets, `u ↦ 𝔼_{Y_u}(A_u)` is Borel. -/
theorem measurable_condExp_of_continuous {U : Type*} [TopologicalSpace U] [MeasurableSpace U]
    [OpensMeasurableSpace U] {A : U → Op S} (hA : Continuous A) {Y : U → Finset S}
    (hY : ∀ Y₀ : Finset S, MeasurableSet {u | Y u = Y₀}) :
    ∀ m m' : Conf S, Measurable fun u => condExp (Y u) (A u) m m' := by
  exact measurable_condExp (fun m m' => (hA.matrix_elem m m').measurable) hY

end Generic

/-! ## Interactions on a finite index set: `H_X`, `H_Ψ`, `S(X)` -/

section Interactions

variable {S : Type*} [Fintype S] [DecidableEq S] {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Appendix B: "`for $X\subset\mathfrak M$ let $H_X:=\sum_{Z\subset X}\Phi(Z)$`" (and for slots, the proof of Theorem 5.2:
"`$H_{\widetilde X}=\sum_{Z\subset X}\Psi(Z)=:H_X$`"). -/
def hamOn (Φ : Finset ι → Op S) (X : Finset ι) : Op S :=
  ∑ Z ∈ X.powerset, Φ Z

/-- §5: "`its Hamiltonian is $H_\Psi:=\sum_Z\Psi(Z)$`". -/
def hamTot (Φ : Finset ι → Op S) : Op S :=
  ∑ Z : Finset ι, Φ Z

/-- Appendix B: "`let $S(X):=\{Z\subset\mathfrak M:Z\cap X\ne\emptyset,\ Z\cap(\mathfrak M\setminus X)\ne\emptyset\}$`" and,
for slots, "`S_\Lambda(X):=\{Z\subset\Slots:Z\cap X\ne\emptyset,\ Z\not\subset X\}.`" — both are the sets meeting `X` and
its complement. -/
def boundarySets (X : Finset ι) : Finset (Finset ι) :=
  Finset.univ.filter fun Z => (Z ∩ X).Nonempty ∧ (Z \ X).Nonempty

/-- `H_𝔐 = H_Ψ`: the whole index set gives the full Hamiltonian ("`in particular $H_{\mathfrak M}=H_\Psi$`"). -/
theorem hamOn_univ (Φ : Finset ι → Op S) : hamOn Φ Finset.univ = hamTot Φ := by
  simp only [hamOn, hamTot, Finset.powerset_univ]

end Interactions

/-! ## Even interactions on `𝒮` and the chain matrix (any finite slot type `S`) -/

section EvenInteractions

variable {S : Type*} [Fintype S] [DecidableEq S]

/-- §5: "`An \emph{even interaction} on $\Slots$ is a map $\Psi$ from the subsets of $\Slots$ to operators on $\FockS$ with $\Psi(Z)=\Psi(Z)^*\in\Alg(Z)$`". -/
def IsEvenInteraction (Ψ : Finset S → Op S) : Prop :=
  ∀ Z : Finset S, IsSelfAdjoint (Ψ Z) ∧ Ψ Z ∈ Alg Z

/-- §5: "`and its \emph{chain matrix} is the $\Slots\times\Slots$ matrix $M^\Psi_{ss'}:=\sum_{Z\ni s,s'}\norm{\Psi(Z)}$ (diagonal included).`" -/
def chainMatrix (Ψ : Finset S → Op S) : Matrix S S ℝ :=
  Matrix.of fun s s' => ∑ Z ∈ Finset.univ.filter (fun Z : Finset S => s ∈ Z ∧ s' ∈ Z), ‖opCLM (Ψ Z)‖

/-- The proof of Theorem 5.2: "`Let $M:=M^\Psi$ and $\mu:=\max_s\sum_{s'}M_{ss'}$.`" (a real supremum over the finite slot
set). -/
def chainRowMax (Ψ : Finset S → Op S) : ℝ :=
  ⨆ s : S, ∑ s' : S, chainMatrix Ψ s s'

end EvenInteractions

/-! ## Appendix B: the mode set, `CAR` of a set of modes, Proposition B.1 -/

section Modes

variable {S : Type*} [Fintype S] [DecidableEq S]

/-- The proof of Theorem 5.2: "`for $X\subset\Slots$ let $\widetilde X:=X\times\{\up,\dn\}$`". -/
def tilde (X : Finset S) : Finset (Mode S) :=
  X ×ˢ Finset.univ

/-- Appendix B: "`$\CAR(Y)$ for $Y\subset\mathfrak M$ the algebra generated by the annihilation operators $a_y$, $y\in Y$`",
on the mode set `𝔐 = 𝒮 × {↑, ↓}` with "`$a_{(s,\sigma)}:=\chat_{s\sigma}$`" (the pilot's `c`). -/
def CARm (W : Finset (Mode S)) : StarSubalgebra ℂ (Op S) :=
  StarAlgebra.adjoin ℂ {A | ∃ μ ∈ W, A = c μ}

/-- Appendix B: "`and $\CAR(Y)^+$ its even part`". -/
def CARmEven (W : Finset (Mode S)) : Set (Op S) :=
  {A | A ∈ CARm W ∧ IsEven A}

/-- The parity of the modes in `W`, diagonal in the occupation basis with entry `(−1)^{#occupied modes in W}`. -/
def parityOn (W : Finset (Mode S)) : Op S :=
  Matrix.diagonal fun m => (-1 : ℂ) ^ (W.filter fun μ => m μ = true).card

/-- Appendix B: "`An even interaction is a map $\Phi$ from subsets of $\mathfrak M$ to $\CAR(\mathfrak M)$ with $\Phi(Z)=\Phi(Z)^*\in\CAR(Z)^+$`". -/
def IsEvenInteractionM (Φ : Finset (Mode S) → Op S) : Prop :=
  ∀ W : Finset (Mode S), IsSelfAdjoint (Φ W) ∧ Φ W ∈ CARmEven W

/-! ### Proof devices for the mode level (phase (b); not statements of the paper)

Every element of `CAR(W)` moves past the annihilator and the creator of a mode outside `W` with the parity (block B's
`mul_c_eq_of_mem_CAR`, one level finer); the parity of the modes outside `W` commutes with `CAR(W)`; an odd element of
`CAR(X)` moves past `CAR(Y)`, `Y` disjoint, with the parity. -/

theorem mul_c_eq_of_mem_CARm {X : Finset (Mode S)} {ν : Mode S} (hν : ν ∉ X) {A : Op S} (hA : A ∈ CARm X) :
    A * c ν = c ν * (parityOp * A * parityOp) ∧ A * (c ν)ᴴ = (c ν)ᴴ * (parityOp * A * parityOp) := by
  have hA' : A ∈ Algebra.adjoin ℂ ({B | ∃ μ ∈ X, B = c μ} ∪ star {B | ∃ μ ∈ X, B = c μ}) := hA
  refine Algebra.adjoin_induction (p := fun A _ => A * c ν = c ν * (parityOp * A * parityOp) ∧
    A * (c ν)ᴴ = (c ν)ᴴ * (parityOp * A * parityOp)) ?_ ?_ ?_ ?_ hA'
  · intro x hx
    rcases hx with ⟨μ, hμ, rfl⟩ | hx
    · have hne : μ ≠ ν := fun h => hν (h ▸ hμ)
      have hP : parityOp * c μ * parityOp = -c μ := parityOp_mul_c_mul_parityOp μ
      rw [hP, Matrix.mul_neg, Matrix.mul_neg]
      refine ⟨eq_neg_of_add_eq_zero_left (Fermion.Pilot.JW.c_anticomm μ ν), ?_⟩
      have h2 := Fermion.Pilot.JW.c_anticomm_star μ ν
      rw [ite_eq_right hne] at h2
      exact eq_neg_of_add_eq_zero_left h2
    · obtain ⟨μ, hμ, h⟩ := hx
      have hx : x = (c μ)ᴴ := by
        rw [← Matrix.star_eq_conjTranspose, ← h, star_star]
      have hne : μ ≠ ν := fun h => hν (h ▸ hμ)
      have hP : parityOp * (c μ)ᴴ * parityOp = -(c μ)ᴴ := parityOp_mul_c_conjTranspose_mul_parityOp μ
      rw [hx, hP, Matrix.mul_neg, Matrix.mul_neg]
      constructor
      · have h2 := Fermion.Pilot.JW.c_anticomm_star ν μ
        rw [ite_eq_right (Ne.symm hne)] at h2
        exact eq_neg_of_add_eq_zero_right h2
      · exact eq_neg_of_add_eq_zero_left (c_conjTranspose_anticomm μ ν)
  · intro r
    have hr : parityOp * algebraMap ℂ (Op S) r * parityOp = algebraMap ℂ (Op S) r := by
      rw [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_one,
        Fermion.Pilot.JW.parityOp_mul_parityOp]
    rw [hr]
    exact ⟨Algebra.commutes r (c ν), Algebra.commutes r (c ν)ᴴ⟩
  · intro x y _ _ hx hy
    have e : parityOp * (x + y) * parityOp = parityOp * x * parityOp + parityOp * y * parityOp := by
      rw [Matrix.mul_add, Matrix.add_mul]
    rw [e, Matrix.add_mul, Matrix.add_mul, Matrix.mul_add, Matrix.mul_add, hx.1, hy.1, hx.2, hy.2]
    exact ⟨rfl, rfl⟩
  · intro x y _ _ hx hy
    have e : parityOp * (x * y) * parityOp = (parityOp * x * parityOp) * (parityOp * y * parityOp) := by
      calc parityOp * (x * y) * parityOp = parityOp * x * (parityOp * parityOp) * y * parityOp := by
            rw [Fermion.Pilot.JW.parityOp_mul_parityOp, Matrix.mul_one]; simp only [Matrix.mul_assoc]
        _ = _ := by simp only [Matrix.mul_assoc]
    rw [e]
    constructor
    · rw [Matrix.mul_assoc, hy.1, ← Matrix.mul_assoc, hx.1, Matrix.mul_assoc]
    · rw [Matrix.mul_assoc, hy.2, ← Matrix.mul_assoc, hx.2, Matrix.mul_assoc]

theorem parityOp_conj_of_isEven {A : Op S} (hA : IsEven A) : parityOp * A * parityOp = A := by
  rw [Matrix.mul_assoc, hA.eq, ← Matrix.mul_assoc, Fermion.Pilot.JW.parityOp_mul_parityOp, Matrix.one_mul]

theorem parityOp_conj_of_isOdd {A : Op S} (hA : IsOdd A) : parityOp * A * parityOp = -A := by
  have hA' : A * parityOp = -(parityOp * A) := hA
  rw [Matrix.mul_assoc, hA', Matrix.mul_neg, ← Matrix.mul_assoc, Fermion.Pilot.JW.parityOp_mul_parityOp,
    Matrix.one_mul]

theorem commute_c_of_mem_CARmEven {X : Finset (Mode S)} {ν : Mode S} (hν : ν ∉ X) {A : Op S}
    (hA : A ∈ CARmEven X) : Commute A (c ν) ∧ Commute A (c ν)ᴴ := by
  obtain ⟨h1, h2⟩ := mul_c_eq_of_mem_CARm hν hA.1
  rw [parityOp_conj_of_isEven hA.2] at h1 h2
  exact ⟨h1, h2⟩

theorem mul_eq_parity_mul_of_isOdd {X Y : Finset (Mode S)} (hXY : Disjoint X Y) {A : Op S} (hA : A ∈ CARm X)
    (hAo : IsOdd A) {B : Op S} (hB : B ∈ CARm Y) : A * B = (parityOp * B * parityOp) * A := by
  have gen : ∀ ν ∈ Y, A * c ν = -(c ν * A) ∧ A * (c ν)ᴴ = -((c ν)ᴴ * A) := by
    intro ν hν
    obtain ⟨h1, h2⟩ := mul_c_eq_of_mem_CARm (Finset.disjoint_right.mp hXY hν) hA
    rw [parityOp_conj_of_isOdd hAo, Matrix.mul_neg] at h1 h2
    exact ⟨h1, h2⟩
  have hB' : B ∈ Algebra.adjoin ℂ ({B | ∃ μ ∈ Y, B = c μ} ∪ star {B | ∃ μ ∈ Y, B = c μ}) := hB
  refine Algebra.adjoin_induction (p := fun B _ => A * B = (parityOp * B * parityOp) * A) ?_ ?_ ?_ ?_ hB'
  · intro x hx
    rcases hx with ⟨ν, hν, rfl⟩ | hx
    · rw [parityOp_mul_c_mul_parityOp, Matrix.neg_mul]
      exact (gen ν hν).1
    · obtain ⟨ν, hν, h⟩ := hx
      have hx : x = (c ν)ᴴ := by
        rw [← Matrix.star_eq_conjTranspose, ← h, star_star]
      rw [hx, parityOp_mul_c_conjTranspose_mul_parityOp, Matrix.neg_mul]
      exact (gen ν hν).2
  · intro r
    have hr : parityOp * algebraMap ℂ (Op S) r * parityOp = algebraMap ℂ (Op S) r := by
      rw [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_one,
        Fermion.Pilot.JW.parityOp_mul_parityOp]
    rw [hr]
    exact (Algebra.commutes r A).symm
  · intro x y _ _ hx hy
    rw [Matrix.mul_add, hx, hy, Matrix.mul_add, Matrix.add_mul, Matrix.add_mul]
  · intro x y _ _ hx hy
    have e : parityOp * (x * y) * parityOp = (parityOp * x * parityOp) * (parityOp * y * parityOp) := by
      calc parityOp * (x * y) * parityOp = parityOp * x * (parityOp * parityOp) * y * parityOp := by
            rw [Fermion.Pilot.JW.parityOp_mul_parityOp, Matrix.mul_one]; simp only [Matrix.mul_assoc]
        _ = _ := by simp only [Matrix.mul_assoc]
    rw [e, ← Matrix.mul_assoc, hx, Matrix.mul_assoc, hy, ← Matrix.mul_assoc]

theorem card_filter_add_card_filter_compl (W : Finset (Mode S)) (m : Conf S) :
    (W.filter fun μ => m μ = true).card + (Wᶜ.filter fun μ => m μ = true).card =
      (Finset.univ.filter fun μ => m μ = true).card := by
  have h := Finset.card_filter_add_card_filter_not (s := Finset.univ.filter fun μ : Mode S => m μ = true)
    (fun μ => μ ∈ W)
  have e1 : (Finset.univ.filter fun μ : Mode S => m μ = true).filter (fun μ => μ ∈ W) =
      W.filter fun μ => m μ = true := by
    ext μ; simp only [Finset.mem_filter, Finset.mem_univ, true_and]; tauto
  have e2 : (Finset.univ.filter fun μ : Mode S => m μ = true).filter (fun μ => ¬ μ ∈ W) =
      Wᶜ.filter fun μ => m μ = true := by
    ext μ; simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_compl]; tauto
  rw [e1, e2] at h
  exact h

theorem parityOn_mul_parityOn_compl (W : Finset (Mode S)) : parityOn W * parityOn Wᶜ = parityOp := by
  rw [parityOn, parityOn, Matrix.diagonal_mul_diagonal, Fermion.Pilot.JW.parityOp]
  congr 1
  funext m
  rw [← pow_add, card_filter_add_card_filter_compl]

theorem parityOn_mul_self (W : Finset (Mode S)) : parityOn W * parityOn W = 1 := by
  rw [parityOn, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
  congr 1
  funext m
  rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]

theorem parityOn_conjTranspose (W : Finset (Mode S)) : (parityOn W)ᴴ = parityOn W := by
  rw [parityOn, Matrix.diagonal_conjTranspose]
  congr 1
  funext m
  rw [Pi.star_apply, star_pow, star_neg, star_one]

theorem commute_parityOn_compl_c {W : Finset (Mode S)} {μ : Mode S} (hμ : μ ∈ W) :
    Commute (parityOn Wᶜ) (c μ) := by
  show parityOn Wᶜ * c μ = c μ * parityOn Wᶜ
  ext m' m
  rw [parityOn, Matrix.diagonal_mul, Matrix.mul_diagonal, Fermion.Pilot.JW.c, Matrix.of_apply]
  by_cases h : m μ = true ∧ m' = Function.update m μ false
  · rw [ite_eq_left h, h.2]
    have hset : (Wᶜ.filter fun ν => Function.update m μ false ν = true) = Wᶜ.filter fun ν => m ν = true := by
      ext ν
      simp only [Finset.mem_filter, Finset.mem_compl]
      constructor
      · rintro ⟨hν, h'⟩
        have hne : ν ≠ μ := fun e => hν (e ▸ hμ)
        rw [Function.update_of_ne hne] at h'
        exact ⟨hν, h'⟩
      · rintro ⟨hν, h'⟩
        have hne : ν ≠ μ := fun e => hν (e ▸ hμ)
        exact ⟨hν, by rw [Function.update_of_ne hne]; exact h'⟩
    rw [hset, mul_comm]
  · rw [ite_eq_right h, mul_zero, zero_mul]

theorem commute_parityOn_compl_of_mem_CARm {W : Finset (Mode S)} {A : Op S} (hA : A ∈ CARm W) :
    Commute (parityOn Wᶜ) A := by
  have hle : (CARm W).toSubalgebra ≤ Subalgebra.centralizer ℂ {parityOn Wᶜ} := by
    rw [CARm, StarAlgebra.adjoin_toSubalgebra]
    apply Algebra.adjoin_le
    rintro C (⟨μ, hμ, rfl⟩ | hC)
    · rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst hb
      exact (commute_parityOn_compl_c hμ).eq
    · obtain ⟨μ, hμ, h⟩ := Set.mem_star.mp hC
      have hC' : C = (c μ)ᴴ := by rw [← star_star C, h]; rfl
      rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst hb
      rw [hC']
      have h1 := congrArg Matrix.conjTranspose (commute_parityOn_compl_c (W := W) hμ).eq
      rw [Matrix.conjTranspose_mul, Matrix.conjTranspose_mul, parityOn_conjTranspose] at h1
      exact h1.symm
  have hA' : A ∈ (CARm W).toSubalgebra := hA
  exact (Subalgebra.mem_centralizer_iff ℂ).mp (hle hA') (parityOn Wᶜ) rfl

/-- The proof of Theorem 5.2: "`The algebra $\CAR(X)$ of Definition~\ref{def:slotfock} is the algebra $\CAR(\widetilde X)$ of this appendix`". -/
theorem CAR_eq_CARm_tilde (X : Finset S) : CAR X = CARm (tilde X) := by
  show StarAlgebra.adjoin ℂ _ = StarAlgebra.adjoin ℂ _
  congr 1
  ext A
  simp only [Set.mem_ofPred_eq, tilde, Finset.mem_product, Finset.mem_univ, and_true]
  constructor
  · rintro ⟨s, hs, σ, rfl⟩
    exact ⟨(s, σ), hs, rfl⟩
  · rintro ⟨⟨s, σ⟩, hs, rfl⟩
    exact ⟨s, hs, σ, rfl⟩

/-- The proof of Theorem 5.2: "`and $\Alg(X)=\CAR(\widetilde X)^+$`". -/
theorem Alg_eq_CARmEven_tilde (X : Finset S) : Alg X = CARmEven (tilde X) := by
  show {A | A ∈ CAR X ∧ IsEven A} = {A | A ∈ CARm (tilde X) ∧ IsEven A}
  rw [CAR_eq_CARm_tilde]

/-- The proof of Theorem 5.2: "`for $A\in\CAR(\widetilde X)$, conjugation by $(-1)^{\Nhat\up+\Nhat\dn}$ coincides with conjugation by the parity of the modes in $\widetilde X$`"
(for any set `W` of modes). -/
theorem parityOp_conj_eq_parityOn_conj {W : Finset (Mode S)} {A : Op S} (hA : A ∈ CARm W) :
    parityOp * A * parityOp = parityOn W * A * parityOn W := by
  have hc := (commute_parityOn_compl_of_mem_CARm hA).eq
  have hcomm : parityOn W * parityOn Wᶜ = parityOn Wᶜ * parityOn W := by
    rw [parityOn, parityOn, Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
    congr 1
    funext m
    ring
  rw [← parityOn_mul_parityOn_compl W]
  calc parityOn W * parityOn Wᶜ * A * (parityOn W * parityOn Wᶜ)
      = parityOn W * (parityOn Wᶜ * A) * (parityOn W * parityOn Wᶜ) := by simp only [Matrix.mul_assoc]
    _ = parityOn W * (A * parityOn Wᶜ) * (parityOn W * parityOn Wᶜ) := by rw [hc]
    _ = parityOn W * A * (parityOn Wᶜ * (parityOn W * parityOn Wᶜ)) := by simp only [Matrix.mul_assoc]
    _ = parityOn W * A * (parityOn Wᶜ * (parityOn Wᶜ * parityOn W)) := by rw [hcomm]
    _ = parityOn W * A * ((parityOn Wᶜ * parityOn Wᶜ) * parityOn W) := by simp only [Matrix.mul_assoc]
    _ = parityOn W * A * parityOn W := by rw [parityOn_mul_self, Matrix.one_mul]

/-- The proof of Theorem 5.2: "`By \eqref{eq:loc-JW}, $\CAR(\mathfrak M)$ is the algebra of all operators on $\FockS$.`" -/
theorem CARm_univ : CARm (Finset.univ : Finset (Mode S)) = ⊤ := by
  have h := CAR_eq_CARm_tilde (Finset.univ : Finset S)
  have ht : tilde (Finset.univ : Finset S) = Finset.univ := Finset.univ_product_univ
  rw [ht, Fermion.Pilot.JW.CAR_univ] at h
  exact h.symm

/-- **Proposition B.1**: "`Let $X,Y\subset\mathfrak M$ be disjoint. If $A\in\CAR(X)^+$ and $B\in\CAR(Y)$, then $[A,B]=0$.`" -/
theorem commute_of_mem_CARmEven_of_mem_CARm {X Y : Finset (Mode S)} (hXY : Disjoint X Y) {A B : Op S}
    (hA : A ∈ CARmEven X) (hB : B ∈ CARm Y) : Commute A B := by
  have hle : (CARm Y).toSubalgebra ≤ Subalgebra.centralizer ℂ {A} := by
    rw [CARm, StarAlgebra.adjoin_toSubalgebra]
    apply Algebra.adjoin_le
    rintro C (⟨μ, hμ, rfl⟩ | hC)
    · rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst hb
      exact (commute_c_of_mem_CARmEven (Finset.disjoint_right.mp hXY hμ) hA).1.eq
    · obtain ⟨μ, hμ, h⟩ := Set.mem_star.mp hC
      have hC' : C = (c μ)ᴴ := by rw [← star_star C, h]; rfl
      rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst hb
      rw [hC']
      exact (commute_c_of_mem_CARmEven (Finset.disjoint_right.mp hXY hμ) hA).2.eq
  have hB' : B ∈ (CARm Y).toSubalgebra := hB
  exact (Subalgebra.mem_centralizer_iff ℂ).mp (hle hB') A rfl

/-- **Proposition B.1**: "`If $A\in\CAR(X)$ and $B\in\CAR(Y)$ are both odd, then $\{A,B\}=0$.`" -/
theorem anticomm_of_mem_CARm_of_isOdd {X Y : Finset (Mode S)} (hXY : Disjoint X Y) {A B : Op S}
    (hA : A ∈ CARm X) (hB : B ∈ CARm Y) (hAo : IsOdd A) (hBo : IsOdd B) : A * B + B * A = 0 := by
  rw [mul_eq_parity_mul_of_isOdd hXY hA hAo hB, parityOp_conj_of_isOdd hBo, Matrix.neg_mul, neg_add_cancel]

end Modes

/-! ## Lemma B.2 (bounded operators on a Hilbert space) -/

/-! ### Proof devices for Lemma B.2 (phase (b); not statements of the paper)

For `G` self-adjoint, `u ↦ exp(u • iG)` is a unitary group with `star (exp(u • iG)) = exp(u • (−iG))`. The forward
inequality is a fencing argument (Mathlib's `image_le_of_liminf_slope_right_le_deriv_boundary`): at each point `x`,
`g(z) := f(z) − e^{i(z−x)A(x)} f(x) e^{−i(z−x)A(x)}` vanishes at `x` with derivative `B(x)`, and the unitary conjugation
keeps the norm; the backward inequality follows by the reflection `t ↦ −t`. -/

section LemmaB2Devices

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

theorem star_I_smul_of_isSelfAdjoint {G : E →L[ℂ] E} (hG : IsSelfAdjoint G) :
    star ((I : ℂ) • G) = -((I : ℂ) • G) := by
  rw [star_smul, hG.star_eq, Complex.star_def, Complex.conj_I, neg_smul]

theorem expSmul_I_mem_unitary {G : E →L[ℂ] E} (hG : IsSelfAdjoint G) (h : ℝ) :
    NormedSpace.exp (h • ((I : ℂ) • G)) ∈ unitary (E →L[ℂ] E) := by
  have hsa : IsSelfAdjoint ((h : ℂ) • G) := by
    rw [IsSelfAdjoint, star_smul, hG.star_eq, Complex.star_def, Complex.conj_ofReal]
  have e : h • ((I : ℂ) • G) = (I : ℂ) • ((h : ℂ) • G) := by
    rw [← Complex.coe_smul, smul_comm]
  rw [e]
  exact (selfAdjoint.expUnitary ⟨(h : ℂ) • G, selfAdjoint.mem_iff.mpr hsa⟩).prop

theorem star_expSmul_I {G : E →L[ℂ] E} (hG : IsSelfAdjoint G) (h : ℝ) :
    star (NormedSpace.exp (h • ((I : ℂ) • G))) = NormedSpace.exp (h • (-((I : ℂ) • G))) := by
  rw [NormedSpace.star_exp, ← Complex.coe_smul, star_smul, Complex.star_def, Complex.conj_ofReal,
    star_I_smul_of_isSelfAdjoint hG, Complex.coe_smul]

theorem norm_le_of_hasDerivAt_comm_fwd {F G K : ℝ → (E →L[ℂ] E)} (hK : Continuous K)
    (hGsa : ∀ t, IsSelfAdjoint (G t)) (hF : ∀ t, HasDerivAt F ((I : ℂ) • (G t * F t - F t * G t) + K t) t)
    {a b : ℝ} (hab : a ≤ b) : ‖F b‖ ≤ ‖F a‖ + ∫ u in a..b, ‖K u‖ := by
  have hFc : Continuous F := continuous_iff_continuousAt.mpr fun t => (hF t).continuousAt
  have hBd : ∀ s, HasDerivAt (fun s => ‖F a‖ + ∫ u in a..s, ‖K u‖) ‖K s‖ s := fun s =>
    ((hK.norm.integral_hasStrictDerivAt a s).hasDerivAt).const_add _
  refine image_le_of_liminf_slope_right_le_deriv_boundary (f := fun s => ‖F s‖)
    (B := fun s => ‖F a‖ + ∫ u in a..s, ‖K u‖) (B' := fun s => ‖K s‖) hFc.norm.continuousOn ?_
    (fun s _ => (hBd s).continuousAt.continuousWithinAt) (fun s _ => (hBd s).hasDerivWithinAt) ?_
    ⟨hab, le_rfl⟩
  · simp
  · intro x _ r hr
    set X : E →L[ℂ] E := (I : ℂ) • G x with hX
    set W : ℝ → (E →L[ℂ] E) :=
      fun z => NormedSpace.exp ((z - x) • X) * F x * NormedSpace.exp ((z - x) • (-X)) with hWdef
    have hW : HasDerivAt W ((I : ℂ) • (G x * F x - F x * G x)) x := by
      have h1 : HasDerivAt (fun z : ℝ => NormedSpace.exp ((z - x) • X)) X x := by
        have := (hasDerivAt_exp_smul_const' (𝕂 := ℝ) X (x - x)).comp_sub_const x x
        simpa using this
      have h2 : HasDerivAt (fun z : ℝ => NormedSpace.exp ((z - x) • (-X))) (-X) x := by
        have := (hasDerivAt_exp_smul_const' (𝕂 := ℝ) (-X) (x - x)).comp_sub_const x x
        simpa using this
      have h3 := (h1.mul_const (F x)).mul h2
      convert h3 using 1
      simp only [sub_self, zero_smul, NormedSpace.exp_zero, one_mul, mul_one, hX]
      rw [mul_neg, smul_mul_assoc, mul_smul_comm, ← sub_eq_add_neg, ← smul_sub]
    set g : ℝ → (E →L[ℂ] E) := fun z => F z - W z with hgdef
    have hg : HasDerivAt g (K x) x := by
      have := (hF x).sub hW
      convert this using 1
      abel
    have hg0 : g x = 0 := by
      simp [hgdef, hWdef]
    have hfreq := hg.hasDerivWithinAt.liminf_right_slope_norm_le hr
    have hev : ∀ᶠ z in nhdsWithin x (Set.Ioi x), x < z := self_mem_nhdsWithin
    refine (hfreq.and_eventually hev).mono fun z hz => ?_
    obtain ⟨hz, hxz⟩ := hz
    rw [hg0, norm_zero, sub_zero] at hz
    have hWn : ‖W z‖ = ‖F x‖ := by
      simp only [hWdef]
      rw [← star_expSmul_I (hGsa x) (z - x), CStarRing.norm_mul_mem_unitary _ (Unitary.star_mem
        (expSmul_I_mem_unitary (hGsa x) _)), CStarRing.norm_mem_unitary_mul _ (expSmul_I_mem_unitary (hGsa x) _)]
    have hle : ‖F z‖ ≤ ‖F x‖ + ‖g z‖ := by
      calc ‖F z‖ = ‖W z + g z‖ := by simp [hgdef]
        _ ≤ ‖W z‖ + ‖g z‖ := norm_add_le _ _
        _ = ‖F x‖ + ‖g z‖ := by rw [hWn]
    rw [slope_def_module, smul_eq_mul]
    have hpos : 0 < (z - x)⁻¹ := inv_pos.mpr (sub_pos.mpr hxz)
    calc (z - x)⁻¹ * (‖F z‖ - ‖F x‖) ≤ (z - x)⁻¹ * ‖g z‖ := by
          apply mul_le_mul_of_nonneg_left _ hpos.le
          linarith
      _ < r := hz

end LemmaB2Devices

/-- **Lemma B.2**: "`Let $A(t)$, $B(t)$ be norm-continuous families of bounded operators on a Hilbert space, with $A(t)$ self-adjoint. Then the solution of $f'(t)=\iu[A(t),f(t)]+B(t)$, $f(t_0)=f_0$, satisfies $\norm{f(t)}\le\norm{f(t_0)}+\int_{\min\{t,t_0\}}^{\max\{t,t_0\}}\norm{B(u)}\,\dd u$.`"
— for a given `f` differentiable on `ℝ` with that derivative (in the normed space `E →L[ℂ] E`), and every `t`, `t₀`. -/
theorem norm_le_of_hasDerivAt_comm {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    {A B f : ℝ → (E →L[ℂ] E)} (hA : Continuous A) (hB : Continuous B) (hAsa : ∀ t, IsSelfAdjoint (A t))
    (hf : ∀ t, HasDerivAt f ((I : ℂ) • (A t * f t - f t * A t) + B t) t) (t t₀ : ℝ) :
    ‖f t‖ ≤ ‖f t₀‖ + ∫ u in (min t t₀)..(max t t₀), ‖B u‖ := by
  rcases le_total t₀ t with h | h
  · rw [min_eq_right h, max_eq_left h]
    exact norm_le_of_hasDerivAt_comm_fwd hB hAsa hf h
  · rw [min_eq_left h, max_eq_right h]
    have hf' : ∀ s, HasDerivAt (fun s => f (-s))
        ((I : ℂ) • ((-A (-s)) * f (-s) - f (-s) * (-A (-s))) + (-B (-s))) s := by
      intro s
      have := (hf (-s)).scomp s (hasDerivAt_neg s)
      refine this.congr_deriv ?_
      simp only [neg_mul, mul_neg, sub_neg_eq_add, neg_one_smul]
      module
    have key := norm_le_of_hasDerivAt_comm_fwd (F := fun s => f (-s)) (G := fun s => -A (-s))
      (K := fun s => -B (-s)) ((hB.comp continuous_neg).neg) (fun s => (hAsa (-s)).neg) hf'
      (a := -t₀) (b := -t) (by linarith)
    simp only [neg_neg, norm_neg] at key
    rw [intervalIntegral.integral_comp_neg (fun u => ‖B u‖), neg_neg, neg_neg] at key
    exact key

/-! ## Lemma B.3 (the one-step estimate on the modes) -/

/-! ### Proof devices for the dynamics (phase (b); not statements of the paper)

`τ^H_s` is a *-automorphism for self-adjoint `H`, isometric for the operator norm; on the operator side
(`opCLM`, a continuous star-algebra isomorphism onto `E →L[ℂ] E`) it is `exp(s • iH) · exp(s • (−iH))`, whose
derivative is the commutator with `iH` (Mathlib's `hasDerivAt_exp_smul_const'`); the product rule for `τ_s(Y(s))`. -/

section DynDevices

variable {S : Type*} [Fintype S] [DecidableEq S]

theorem opCLM_mul' (X Y : Op S) : opCLM (X * Y) = opCLM X * opCLM Y :=
  map_mul (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)) X Y

theorem opCLM_add' (X Y : Op S) : opCLM (X + Y) = opCLM X + opCLM Y :=
  map_add (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)) X Y

theorem opCLM_sub' (X Y : Op S) : opCLM (X - Y) = opCLM X - opCLM Y :=
  map_sub (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)) X Y

theorem opCLM_neg' (X : Op S) : opCLM (-X) = -opCLM X :=
  map_neg (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)) X

theorem opCLM_smul' (c : ℂ) (X : Op S) : opCLM (c • X) = c • opCLM X :=
  map_smul (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)) c X

theorem opCLM_sum' {ι : Type*} (F : Finset ι) (X : ι → Op S) : opCLM (∑ i ∈ F, X i) = ∑ i ∈ F, opCLM (X i) :=
  map_sum (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)) X F

theorem opCLM_star' (X : Op S) : opCLM (star X) = star (opCLM X) :=
  map_star (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)) X

theorem continuous_opCLM : Continuous (fun A : Op S => opCLM A) :=
  LinearMap.continuous_of_finiteDimensional
    (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)).toAlgEquiv.toLinearEquiv.toLinearMap

theorem opCLM_exp (X : Op S) : opCLM (NormedSpace.exp X) = NormedSpace.exp (opCLM X) := by
  open scoped Matrix.Norms.L2Operator in
  exact NormedSpace.map_exp_of_mem_ball (𝕂 := ℂ) (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ)) continuous_opCLM X
    ((NormedSpace.expSeries_radius_eq_top ℂ (Op S)).symm ▸ edist_lt_top _ _)

theorem real_smul_clm (X : EuclideanSpace ℂ (Conf S) →L[ℂ] EuclideanSpace ℂ (Conf S)) (r : ℝ) :
    r • X = (r : ℂ) • X :=
  RCLike.real_smul_eq_coe_smul (K := ℂ) (E := EuclideanSpace ℂ (Conf S) →L[ℂ] EuclideanSpace ℂ (Conf S)) r X

theorem opCLM_expI (H : Op S) (s : ℝ) :
    opCLM (NormedSpace.exp ((I * (s : ℂ)) • H)) = NormedSpace.exp (s • opCLM ((I : ℂ) • H)) := by
  rw [opCLM_exp, real_smul_clm, ← opCLM_smul']
  congr 2
  module

theorem opCLM_expI_neg (H : Op S) (s : ℝ) :
    opCLM (NormedSpace.exp ((-(I * (s : ℂ))) • H)) = NormedSpace.exp (s • (-opCLM ((I : ℂ) • H))) := by
  rw [opCLM_exp, ← opCLM_neg', real_smul_clm, ← opCLM_smul']
  congr 2
  module

theorem expI_mul_expI_neg (H : Op S) (s : ℝ) :
    NormedSpace.exp ((I * (s : ℂ)) • H) * NormedSpace.exp ((-(I * (s : ℂ))) • H) = 1 := by
  rw [← Matrix.exp_add_of_commute _ _ ((Commute.refl H).smul_left _ |>.smul_right _), ← add_smul,
    add_neg_cancel, zero_smul, NormedSpace.exp_zero]

theorem expI_neg_mul_expI (H : Op S) (s : ℝ) :
    NormedSpace.exp ((-(I * (s : ℂ))) • H) * NormedSpace.exp ((I * (s : ℂ)) • H) = 1 := by
  rw [← Matrix.exp_add_of_commute _ _ ((Commute.refl H).smul_left _ |>.smul_right _), ← add_smul,
    neg_add_cancel, zero_smul, NormedSpace.exp_zero]

theorem commute_IH_expI (H : Op S) (c : ℂ) : Commute ((I : ℂ) • H) (NormedSpace.exp (c • H)) :=
  (((Commute.refl H).smul_left (I : ℂ)).smul_right c).exp_right

theorem dyn_mul (H : Op S) (s : ℝ) (X Y : Op S) : dyn H s (X * Y) = dyn H s X * dyn H s Y := by
  simp only [dyn, Matrix.mul_assoc]
  rw [← Matrix.mul_assoc (NormedSpace.exp ((-(I * (s : ℂ))) • H)) (NormedSpace.exp ((I * (s : ℂ)) • H)),
    expI_neg_mul_expI, Matrix.one_mul]

theorem dyn_add (H : Op S) (s : ℝ) (X Y : Op S) : dyn H s (X + Y) = dyn H s X + dyn H s Y := by
  simp only [dyn, Matrix.mul_add, Matrix.add_mul]

theorem dyn_sub (H : Op S) (s : ℝ) (X Y : Op S) : dyn H s (X - Y) = dyn H s X - dyn H s Y := by
  simp only [dyn, Matrix.mul_sub, Matrix.sub_mul]

theorem dyn_smul (H : Op S) (s : ℝ) (c : ℂ) (X : Op S) : dyn H s (c • X) = c • dyn H s X := by
  simp only [dyn, Matrix.mul_smul, Matrix.smul_mul]

theorem dyn_sum (H : Op S) (s : ℝ) {ι : Type*} (F : Finset ι) (X : ι → Op S) :
    dyn H s (∑ i ∈ F, X i) = ∑ i ∈ F, dyn H s (X i) := by
  simp only [dyn, Finset.mul_sum, Finset.sum_mul]

theorem dyn_zero_op (H : Op S) (s : ℝ) : dyn H s 0 = 0 := by
  simp [dyn]

theorem dyn_time_zero (H A : Op S) : dyn H 0 A = A := by
  simp [dyn]

theorem expI_conjTranspose {H : Op S} (hH : IsSelfAdjoint H) (s : ℝ) :
    (NormedSpace.exp ((I * (s : ℂ)) • H))ᴴ = NormedSpace.exp ((-(I * (s : ℂ))) • H) := by
  rw [← Matrix.exp_conjTranspose, Matrix.conjTranspose_smul]
  have hH' : Hᴴ = H := hH
  rw [hH']
  congr 2
  simp [Complex.conj_ofReal, Complex.conj_I]

theorem expI_mem_unitary {H : Op S} (hH : IsSelfAdjoint H) (s : ℝ) :
    NormedSpace.exp ((I * (s : ℂ)) • H) ∈ unitary (Op S) := by
  rw [Unitary.mem_iff, Matrix.star_eq_conjTranspose, expI_conjTranspose hH]
  exact ⟨expI_neg_mul_expI H s, expI_mul_expI_neg H s⟩

theorem dyn_conjTranspose {H : Op S} (hH : IsSelfAdjoint H) (s : ℝ) (X : Op S) :
    (dyn H s X)ᴴ = dyn H s Xᴴ := by
  rw [dyn, dyn, Matrix.conjTranspose_mul, Matrix.conjTranspose_mul, expI_conjTranspose hH]
  have h2 : (NormedSpace.exp ((-(I * (s : ℂ))) • H))ᴴ = NormedSpace.exp ((I * (s : ℂ)) • H) := by
    rw [← expI_conjTranspose hH, Matrix.conjTranspose_conjTranspose]
  rw [h2, Matrix.mul_assoc]

theorem isSelfAdjoint_dyn {H : Op S} (hH : IsSelfAdjoint H) (s : ℝ) {X : Op S} (hX : IsSelfAdjoint X) :
    IsSelfAdjoint (dyn H s X) := by
  have hX' : Xᴴ = X := hX
  show (dyn H s X)ᴴ = dyn H s X
  rw [dyn_conjTranspose hH, hX']

open scoped Matrix.Norms.L2Operator in
theorem norm_dyn {H : Op S} (hH : IsSelfAdjoint H) (s : ℝ) (X : Op S) : ‖opCLM (dyn H s X)‖ = ‖opCLM X‖ := by
  have hU := expI_mem_unitary hH s
  have e : dyn H s X = NormedSpace.exp ((I * (s : ℂ)) • H) * X * (NormedSpace.exp ((I * (s : ℂ)) • H))ᴴ := by
    rw [expI_conjTranspose hH]; rfl
  rw [e, norm_opCLM_eq_l2, norm_opCLM_eq_l2, ← Matrix.star_eq_conjTranspose,
    CStarRing.norm_mul_mem_unitary _ (Unitary.star_mem hU), CStarRing.norm_mem_unitary_mul _ hU]

open scoped Matrix.Norms.L2Operator in
theorem norm_comm_le (X Y : Op S) : ‖opCLM (X * Y - Y * X)‖ ≤ 2 * ‖opCLM X‖ * ‖opCLM Y‖ := by
  rw [norm_opCLM_eq_l2, norm_opCLM_eq_l2, norm_opCLM_eq_l2]
  calc ‖X * Y - Y * X‖ ≤ ‖X * Y‖ + ‖Y * X‖ := norm_sub_le _ _
    _ ≤ ‖X‖ * ‖Y‖ + ‖Y‖ * ‖X‖ := add_le_add (norm_mul_le _ _) (norm_mul_le _ _)
    _ = 2 * ‖X‖ * ‖Y‖ := by ring

/-- The derivative of `u ↦ opCLM (τ^H_u(A))` for a fixed `A`: `opCLM(i[H, τ^H_s(A)])`. -/
theorem hasDerivAt_opCLM_dyn (H A : Op S) (s : ℝ) :
    HasDerivAt (fun u => opCLM (dyn H u A))
      (opCLM ((I : ℂ) • (H * dyn H s A - dyn H s A * H))) s := by
  set L : Op S := (I : ℂ) • H with hL
  have hfun : (fun u => opCLM (dyn H u A)) =
      fun u => NormedSpace.exp (u • opCLM L) * opCLM A * NormedSpace.exp (u • (-opCLM L)) := by
    funext u; rw [dyn, opCLM_mul', opCLM_mul', opCLM_expI, opCLM_expI_neg]
  rw [hfun]
  have h1 := hasDerivAt_exp_smul_const' (𝕂 := ℝ) (opCLM L) s
  have h2 := hasDerivAt_exp_smul_const' (𝕂 := ℝ) (-opCLM L) s
  have h3 := (h1.mul_const (opCLM A)).mul h2
  refine h3.congr_deriv ?_
  rw [← opCLM_expI, ← opCLM_expI_neg]
  have hc2 : L * NormedSpace.exp ((-(I * (s : ℂ))) • H) = NormedSpace.exp ((-(I * (s : ℂ))) • H) * L :=
    (commute_IH_expI H _).eq
  have hsm : (I : ℂ) • (H * dyn H s A - dyn H s A * H) = L * dyn H s A - dyn H s A * L := by
    rw [hL, Matrix.smul_mul, Matrix.mul_smul, smul_sub]
  have e : (I : ℂ) • (H * dyn H s A - dyn H s A * H) =
      L * NormedSpace.exp ((I * (s : ℂ)) • H) * A * NormedSpace.exp ((-(I * (s : ℂ))) • H) +
        NormedSpace.exp ((I * (s : ℂ)) • H) * A * (-L * NormedSpace.exp ((-(I * (s : ℂ))) • H)) := by
    rw [hsm, dyn, Matrix.neg_mul, hc2]
    noncomm_ring
  rw [e]
  simp only [opCLM_add', opCLM_mul', opCLM_neg']

/-- The product rule for `u ↦ opCLM (τ^H_u(Y(u)))`. -/
theorem hasDerivAt_opCLM_dyn_comp (H : Op S) {Y : ℝ → Op S} {Y' : Op S} {s : ℝ}
    (hY : HasDerivAt (fun u => opCLM (Y u)) (opCLM Y') s) :
    HasDerivAt (fun u => opCLM (dyn H u (Y u)))
      (opCLM (dyn H s ((I : ℂ) • (H * Y s - Y s * H) + Y'))) s := by
  set L : Op S := (I : ℂ) • H with hL
  have hfun : (fun u => opCLM (dyn H u (Y u))) =
      fun u => NormedSpace.exp (u • opCLM L) * opCLM (Y u) * NormedSpace.exp (u • (-opCLM L)) := by
    funext u; rw [dyn, opCLM_mul', opCLM_mul', opCLM_expI, opCLM_expI_neg]
  rw [hfun]
  have h1 := hasDerivAt_exp_smul_const' (𝕂 := ℝ) (opCLM L) s
  have h2 := hasDerivAt_exp_smul_const' (𝕂 := ℝ) (-opCLM L) s
  have h3 := (h1.mul hY).mul h2
  refine h3.congr_deriv ?_
  simp only [Pi.mul_apply]
  rw [← opCLM_expI, ← opCLM_expI_neg]
  have hc1 : L * NormedSpace.exp ((I * (s : ℂ)) • H) = NormedSpace.exp ((I * (s : ℂ)) • H) * L :=
    (commute_IH_expI H _).eq
  have hsm : (I : ℂ) • (H * Y s - Y s * H) = L * Y s - Y s * L := by
    rw [hL, Matrix.smul_mul, Matrix.mul_smul, smul_sub]
  have e : dyn H s ((I : ℂ) • (H * Y s - Y s * H) + Y') =
      (L * NormedSpace.exp ((I * (s : ℂ)) • H) * Y s + NormedSpace.exp ((I * (s : ℂ)) • H) * Y') *
          NormedSpace.exp ((-(I * (s : ℂ))) • H) +
        NormedSpace.exp ((I * (s : ℂ)) • H) * Y s * (-L * NormedSpace.exp ((-(I * (s : ℂ))) • H)) := by
    rw [hsm, dyn, hc1]
    noncomm_ring
  rw [e]
  simp only [opCLM_add', opCLM_mul', opCLM_neg']

theorem hasDerivAt_opCLM_dyn_sub (H A : Op S) (t s : ℝ) :
    HasDerivAt (fun u => opCLM (dyn H (t - u) A))
      (opCLM (-((I : ℂ) • (H * dyn H (t - s) A - dyn H (t - s) A * H)))) s := by
  have h := (hasDerivAt_opCLM_dyn H A (t - s)).scomp s ((hasDerivAt_id s).const_sub t)
  refine h.congr_deriv ?_
  rw [opCLM_neg', neg_one_smul]

theorem continuous_opCLM_dyn (H A : Op S) : Continuous fun u => opCLM (dyn H u A) :=
  continuous_iff_continuousAt.mpr fun u => (hasDerivAt_opCLM_dyn H A u).continuousAt

theorem isClosed_CARm (W : Finset (Mode S)) : IsClosed (CARm W : Set (Op S)) :=
  (Subalgebra.toSubmodule (CARm W).toSubalgebra).closed_of_finiteDimensional

theorem CARm_mono {W W' : Finset (Mode S)} (h : W ⊆ W') : CARm W ≤ CARm W' := by
  apply StarAlgebra.adjoin_mono
  rintro B ⟨μ, hμ, rfl⟩
  exact ⟨μ, h hμ, rfl⟩

theorem dyn_mem_CARm {W : Finset (Mode S)} {H A : Op S} (hH : H ∈ CARm W) (hA : A ∈ CARm W) (s : ℝ) :
    dyn H s A ∈ CARm W := by
  have e1 : NormedSpace.exp ((I * (s : ℂ)) • H) ∈ CARm W :=
    NormedSpace.exp_mem (R := ℂ) (isClosed_CARm W) (SMulMemClass.smul_mem _ hH)
  have e2 : NormedSpace.exp ((-(I * (s : ℂ))) • H) ∈ CARm W :=
    NormedSpace.exp_mem (R := ℂ) (isClosed_CARm W) (SMulMemClass.smul_mem _ hH)
  exact mul_mem (mul_mem e1 hA) e2

theorem mem_boundarySets {ι : Type*} [Fintype ι] [DecidableEq ι] {X Z : Finset ι} :
    Z ∈ boundarySets X ↔ (Z ∩ X).Nonempty ∧ (Z \ X).Nonempty := by
  simp [boundarySets]

end DynDevices

section OneStep

variable {S : Type*} [Fintype S] [DecidableEq S]

/-! ### Proof devices for Lemma B.3 (phase (b); not statements of the paper) -/

theorem hamOn_mem_CARm {Φ : Finset (Mode S) → Op S} (hΦ : IsEvenInteractionM Φ) (X : Finset (Mode S)) :
    hamOn Φ X ∈ CARm X :=
  sum_mem fun Z hZ => CARm_mono (Finset.mem_powerset.mp hZ) (hΦ Z).2.1

theorem isSelfAdjoint_hamOn {ι : Type*} [Fintype ι] [DecidableEq ι] {Φ : Finset ι → Op S}
    (hΦ : ∀ Z, IsSelfAdjoint (Φ Z)) (X : Finset ι) : IsSelfAdjoint (hamOn Φ X) :=
  isSelfAdjoint_sum _ fun Z _ => hΦ Z

/-- `[H_𝔐 − H_X, A'] = [Σ_{Z∈S(X)} Φ(Z), A']` for `A' ∈ CAR(X)`: the terms disjoint from `X` commute with `A'`. -/
theorem comm_hamOn_sub_eq {Φ : Finset (Mode S) → Op S} (hΦ : IsEvenInteractionM Φ) {X : Finset (Mode S)}
    {A' : Op S} (hA' : A' ∈ CARm X) :
    (hamOn Φ Finset.univ - hamOn Φ X) * A' - A' * (hamOn Φ Finset.univ - hamOn Φ X) =
      (∑ Z ∈ boundarySets X, Φ Z) * A' - A' * ∑ Z ∈ boundarySets X, Φ Z := by
  have hsplit : hamOn Φ Finset.univ - hamOn Φ X = ∑ Z ∈ Finset.univ \ X.powerset, Φ Z := by
    rw [hamOn, hamOn, Finset.powerset_univ, Finset.sum_sdiff_eq_sub (Finset.subset_univ _)]
  rw [hsplit, Finset.sum_mul, Finset.mul_sum, Finset.sum_mul, Finset.mul_sum, ← Finset.sum_sub_distrib,
    ← Finset.sum_sub_distrib]
  symm
  refine Finset.sum_subset ?_ ?_
  · intro Z hZ
    rw [mem_boundarySets] at hZ
    rw [Finset.mem_sdiff, Finset.mem_powerset]
    refine ⟨Finset.mem_univ _, fun hsub => ?_⟩
    obtain ⟨μ, hμ⟩ := hZ.2
    rw [Finset.mem_sdiff] at hμ
    exact hμ.2 (hsub hμ.1)
  · intro Z hZ hZn
    rw [Finset.mem_sdiff, Finset.mem_powerset] at hZ
    have hdisj : Disjoint Z X := by
      rw [Finset.disjoint_iff_inter_eq_empty]
      by_contra hne
      apply hZn
      rw [mem_boundarySets]
      refine ⟨Finset.nonempty_of_ne_empty hne, ?_⟩
      by_contra h2
      apply hZ.2
      intro μ hμ
      by_contra hμX
      exact h2 ⟨μ, Finset.mem_sdiff.mpr ⟨hμ, hμX⟩⟩
    rw [(commute_of_mem_CARmEven_of_mem_CARm hdisj (hΦ Z).2 hA').eq, sub_self]

/-- **Lemma B.3**: "`Let $\Phi$ be an even interaction on $\mathfrak M$, $X\subset\mathfrak M$, $A\in\CAR(X)$, $B\in\CAR(\mathfrak M)$ and $t\ge0$. Then`"
"`\bigl\lVert[\tau^{\mathfrak M}_t(A),B]\bigr\rVert\le\bigl\lVert[\tau^X_t(A),B]\bigr\rVert +2\norm A\sum_{Z\in S(X)}\int_0^t\bigl\lVert[\tau^{\mathfrak M}_u(\Phi(Z)),B]\bigr\rVert\,\dd u .`"
-/
theorem norm_comm_dyn_le_oneStep {Φ : Finset (Mode S) → Op S} (hΦ : IsEvenInteractionM Φ)
    {X : Finset (Mode S)} {A : Op S} (hA : A ∈ CARm X) (B : Op S) (hB : B ∈ CARm Finset.univ) {t : ℝ}
    (ht : 0 ≤ t) :
    ‖opCLM (dyn (hamOn Φ Finset.univ) t A * B - B * dyn (hamOn Φ Finset.univ) t A)‖ ≤
      ‖opCLM (dyn (hamOn Φ X) t A * B - B * dyn (hamOn Φ X) t A)‖ +
        2 * ‖opCLM A‖ * ∑ Z ∈ boundarySets X, ∫ u in (0 : ℝ)..t,
          ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z))‖ := by
  have hHsa : IsSelfAdjoint (hamOn Φ Finset.univ) := isSelfAdjoint_hamOn (fun Z => (hΦ Z).1) _
  have hHXsa : IsSelfAdjoint (hamOn Φ X) := isSelfAdjoint_hamOn (fun Z => (hΦ Z).1) _
  have hKsa : IsSelfAdjoint (∑ Z ∈ boundarySets X, Φ Z) := isSelfAdjoint_sum _ fun Z _ => (hΦ Z).1
  have hYmem : ∀ u, dyn (hamOn Φ X) (t - u) A ∈ CARm X := fun u =>
    dyn_mem_CARm (hamOn_mem_CARm hΦ X) hA _
  -- the matrices `Q(u) := τ_u(τ^X_{t−u}(A))` and `K(u) := τ_u(Σ_{Z∈S(X)} Φ(Z))`
  set Qm : ℝ → Op S := fun u => dyn (hamOn Φ Finset.univ) u (dyn (hamOn Φ X) (t - u) A) with hQm
  set Km : ℝ → Op S := fun u => dyn (hamOn Φ Finset.univ) u (∑ Z ∈ boundarySets X, Φ Z) with hKm
  have hQ : ∀ s, HasDerivAt (fun u => opCLM (Qm u)) (opCLM ((I : ℂ) • (Km s * Qm s - Qm s * Km s))) s := by
    intro s
    have h := hasDerivAt_opCLM_dyn_comp (hamOn Φ Finset.univ) (hasDerivAt_opCLM_dyn_sub (hamOn Φ X) A t s)
    refine h.congr_deriv ?_
    congr 1
    have e1 : (I : ℂ) • (hamOn Φ Finset.univ * dyn (hamOn Φ X) (t - s) A -
          dyn (hamOn Φ X) (t - s) A * hamOn Φ Finset.univ) +
        -((I : ℂ) • (hamOn Φ X * dyn (hamOn Φ X) (t - s) A - dyn (hamOn Φ X) (t - s) A * hamOn Φ X)) =
        (I : ℂ) • ((hamOn Φ Finset.univ - hamOn Φ X) * dyn (hamOn Φ X) (t - s) A -
          dyn (hamOn Φ X) (t - s) A * (hamOn Φ Finset.univ - hamOn Φ X)) := by
      rw [Matrix.sub_mul, Matrix.mul_sub]
      module
    rw [e1, comm_hamOn_sub_eq hΦ (hYmem s), dyn_smul, dyn_sub, dyn_mul, dyn_mul]
  set a : ℝ → (EuclideanSpace ℂ (Conf S) →L[ℂ] EuclideanSpace ℂ (Conf S)) := fun u => opCLM (Km u) with ha
  set q : ℝ → (EuclideanSpace ℂ (Conf S) →L[ℂ] EuclideanSpace ℂ (Conf S)) := fun u => opCLM (Qm u) with hq
  set b := opCLM B with hb
  set F : ℝ → (EuclideanSpace ℂ (Conf S) →L[ℂ] EuclideanSpace ℂ (Conf S)) := fun u => q u * b - b * q u with hF
  set Bf : ℝ → (EuclideanSpace ℂ (Conf S) →L[ℂ] EuclideanSpace ℂ (Conf S)) :=
    fun u => (I : ℂ) • ((a u * b - b * a u) * q u - q u * (a u * b - b * a u)) with hBf
  have hqc : Continuous q := continuous_iff_continuousAt.mpr fun u => (hQ u).continuousAt
  have hac : Continuous a := continuous_opCLM_dyn _ _
  have hFd : ∀ s, HasDerivAt F ((I : ℂ) • (a s * F s - F s * a s) + Bf s) s := by
    intro s
    have h := ((hQ s).mul_const b).sub ((hQ s).const_mul b)
    refine h.congr_deriv ?_
    simp only [ha, hq, hb, hF, hBf]
    rw [← opCLM_mul', ← opCLM_mul', ← opCLM_sub', ← opCLM_mul', ← opCLM_mul', ← opCLM_sub', ← opCLM_mul',
      ← opCLM_mul', ← opCLM_sub', ← opCLM_smul', ← opCLM_mul', ← opCLM_mul', ← opCLM_sub', ← opCLM_mul',
      ← opCLM_mul', ← opCLM_sub', ← opCLM_smul', ← opCLM_add']
    congr 1
    rw [Matrix.smul_mul, Matrix.mul_smul, ← smul_sub, ← smul_add]
    congr 1
    noncomm_ring
  have hBfc : Continuous Bf := by
    simp only [hBf]
    fun_prop
  have hasa : ∀ u, IsSelfAdjoint (a u) := fun u =>
    (isSelfAdjoint_dyn hHsa u hKsa).map (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ))
  have key := norm_le_of_hasDerivAt_comm hac hBfc hasa hFd t 0
  rw [min_eq_right ht, max_eq_left ht] at key
  have hFt : F t = opCLM (dyn (hamOn Φ Finset.univ) t A * B - B * dyn (hamOn Φ Finset.univ) t A) := by
    simp only [hF, hq, hQm, hb, sub_self, dyn_time_zero, opCLM_sub', opCLM_mul']
  have hF0 : F 0 = opCLM (dyn (hamOn Φ X) t A * B - B * dyn (hamOn Φ X) t A) := by
    simp only [hF, hq, hQm, hb, sub_zero, dyn_time_zero, opCLM_sub', opCLM_mul']
  rw [hFt, hF0] at key
  refine key.trans (add_le_add_right ?_ _)
  -- `‖Bf(u)‖ ≤ 2‖A‖ Σ_Z ‖[τ_u(Φ Z), B]‖`
  have hpt : ∀ u, ‖Bf u‖ ≤ 2 * ‖opCLM A‖ * ∑ Z ∈ boundarySets X,
      ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z))‖ := by
    intro u
    have hqn : ‖q u‖ = ‖opCLM A‖ := by
      simp only [hq, hQm]
      rw [norm_dyn hHsa, norm_dyn hHXsa]
    have hab : ‖a u * b - b * a u‖ ≤ ∑ Z ∈ boundarySets X,
        ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z))‖ := by
      have e : a u * b - b * a u = ∑ Z ∈ boundarySets X,
          opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z)) := by
        simp only [ha, hKm, hb]
        rw [← opCLM_mul', ← opCLM_mul', ← opCLM_sub', ← opCLM_sum', dyn_sum, Finset.sum_mul, Finset.mul_sum,
          ← Finset.sum_sub_distrib]
      rw [e]
      exact norm_sum_le _ _
    calc ‖Bf u‖ = ‖(a u * b - b * a u) * q u - q u * (a u * b - b * a u)‖ := by
          simp only [hBf]; rw [norm_smul, Complex.norm_I, one_mul]
      _ ≤ ‖(a u * b - b * a u) * q u‖ + ‖q u * (a u * b - b * a u)‖ := norm_sub_le _ _
      _ ≤ ‖a u * b - b * a u‖ * ‖q u‖ + ‖q u‖ * ‖a u * b - b * a u‖ :=
          add_le_add (norm_mul_le _ _) (norm_mul_le _ _)
      _ = 2 * ‖q u‖ * ‖a u * b - b * a u‖ := by ring
      _ ≤ 2 * ‖opCLM A‖ * ∑ Z ∈ boundarySets X,
          ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z))‖ := by
          rw [hqn]
          exact mul_le_mul_of_nonneg_left hab (by positivity)
  have hcZ : ∀ Z, Continuous fun u =>
      ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z))‖ := by
    intro Z
    have e : (fun u => ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z))‖) =
        fun u => ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z)) * opCLM B -
          opCLM B * opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z))‖ := by
      funext u; rw [opCLM_sub', opCLM_mul', opCLM_mul']
    rw [e]
    have hc := continuous_opCLM_dyn (hamOn Φ Finset.univ) (Φ Z)
    fun_prop
  calc ∫ u in (0 : ℝ)..t, ‖Bf u‖
      ≤ ∫ u in (0 : ℝ)..t, 2 * ‖opCLM A‖ * ∑ Z ∈ boundarySets X,
          ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z))‖ := by
        refine intervalIntegral.integral_mono_on ht (hBfc.norm.intervalIntegrable _ _) ?_ fun u _ => hpt u
        exact (continuous_const.mul (continuous_finsetSum _ fun Z _ => hcZ Z)).intervalIntegrable _ _
    _ = 2 * ‖opCLM A‖ * ∑ Z ∈ boundarySets X, ∫ u in (0 : ℝ)..t,
          ‖opCLM (dyn (hamOn Φ Finset.univ) u (Φ Z) * B - B * dyn (hamOn Φ Finset.univ) u (Φ Z))‖ := by
        rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_finsetSum]
        exact fun Z _ => (hcZ Z).intervalIntegrable _ _

end OneStep

/-! ## The proof of Theorem 5.2: slots and modes, the one-step estimate in slots (B.1), (B.2), the iteration -/

section SlotsAndModes

variable {S : Type*} [Fintype S] [DecidableEq S]

/-- The proof of Theorem 5.2: "`an even interaction $\Phi$ on $\mathfrak M$ in the sense of this appendix is defined by $\Phi(\widetilde Z):=\Psi(Z)$ for $Z\subset\Slots$ and $\Phi(W):=0$ for the subsets $W\subset\mathfrak M$ that are not of the form $\widetilde Z$`"
(`W` is of the form `Z̃` exactly when it is the `tilde` of its set of slots). -/
def liftInteraction (Ψ : Finset S → Op S) (W : Finset (Mode S)) : Op S :=
  if tilde (W.image Prod.fst) = W then Ψ (W.image Prod.fst) else 0

/-! ### Proof devices for the lift (phase (b); not statements of the paper) -/

theorem image_fst_tilde (Z : Finset S) : (tilde Z).image Prod.fst = Z :=
  Finset.product_image_fst ⟨Spin.up, Finset.mem_univ _⟩

theorem tilde_injective : Function.Injective (tilde (S := S)) := by
  intro Z Z' h
  rw [← image_fst_tilde Z, ← image_fst_tilde Z', h]

theorem mem_tilde {X : Finset S} {μ : Mode S} : μ ∈ tilde X ↔ μ.1 ∈ X := by
  simp [tilde]

/-- `Φ(Z̃) = Ψ(Z)`. -/
theorem liftInteraction_tilde (Ψ : Finset S → Op S) (Z : Finset S) : liftInteraction Ψ (tilde Z) = Ψ Z := by
  rw [liftInteraction, image_fst_tilde, ite_eq_left rfl]

/-- `Φ(W) = 0` for the `W` not of the form `Z̃`. -/
theorem liftInteraction_eq_zero (Ψ : Finset S → Op S) {W : Finset (Mode S)} (hW : ∀ Z : Finset S, tilde Z ≠ W) :
    liftInteraction Ψ W = 0 := by
  rw [liftInteraction, ite_eq_right (hW _)]

/-- The lift of an even interaction on `𝒮` is an even interaction on `𝔐` ("`an even interaction $\Phi$ on $\mathfrak M$ in the sense of this appendix`"). -/
theorem isEvenInteractionM_liftInteraction {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) :
    IsEvenInteractionM (liftInteraction Ψ) := by
  intro W
  by_cases h : tilde (W.image Prod.fst) = W
  · rw [liftInteraction, ite_eq_left h]
    obtain ⟨hsa, hmem⟩ := hΨ (W.image Prod.fst)
    refine ⟨hsa, ?_⟩
    have e : CARmEven W = CARmEven (tilde (W.image Prod.fst)) := by rw [h]
    rw [e, ← Alg_eq_CARmEven_tilde]
    exact hmem
  · rw [liftInteraction, ite_eq_right h]
    exact ⟨IsSelfAdjoint.zero _, zero_mem _, Commute.zero_left _⟩

/-- The proof of Theorem 5.2: "`For $X\subset\Slots$, $H_{\widetilde X}=\sum_{Z\subset X}\Psi(Z)=:H_X$`". -/
theorem hamOn_liftInteraction (Ψ : Finset S → Op S) (X : Finset S) :
    hamOn (liftInteraction Ψ) (tilde X) = hamOn Ψ X := by
  unfold hamOn
  have hsub : X.powerset.image tilde ⊆ (tilde X).powerset := by
    intro W hW
    obtain ⟨Z, hZ, rfl⟩ := Finset.mem_image.mp hW
    rw [Finset.mem_powerset] at hZ ⊢
    intro μ hμ
    rw [mem_tilde] at hμ ⊢
    exact hZ hμ
  rw [← Finset.sum_subset hsub ?_]
  · rw [Finset.sum_image fun Z _ Z' _ h => tilde_injective h]
    exact Finset.sum_congr rfl fun Z _ => liftInteraction_tilde Ψ Z
  · intro W hW hWn
    apply liftInteraction_eq_zero
    rintro Z rfl
    apply hWn
    refine Finset.mem_image.mpr ⟨Z, ?_, rfl⟩
    rw [Finset.mem_powerset] at hW ⊢
    intro s hs
    have : ((s, Spin.up) : Mode S) ∈ tilde Z := mem_tilde.mpr hs
    exact mem_tilde.mp (hW this)

/-- The proof of Theorem 5.2: "`in particular $H_{\mathfrak M}=H_\Psi$`". -/
theorem hamOn_liftInteraction_univ (Ψ : Finset S → Op S) :
    hamOn (liftInteraction Ψ) Finset.univ = hamTot Ψ := by
  have ht : tilde (Finset.univ : Finset S) = Finset.univ := Finset.univ_product_univ
  rw [← ht, hamOn_liftInteraction, hamOn_univ]

/-- The proof of Theorem 5.2: "`The sets of $S(\widetilde X)$ on which $\Phi$ does not vanish are the $\widetilde Z$ with $Z$ in`"
`S_Λ(X)` — the sets of `S(X̃)` where the lift does not vanish are of the form `Z̃` with `Z ∈ S_Λ(X)`, and every such
`Z̃` is in `S(X̃)`. -/
theorem boundarySets_liftInteraction (Ψ : Finset S → Op S) (X : Finset S) :
    (∀ W ∈ boundarySets (tilde X), liftInteraction Ψ W ≠ 0 → ∃ Z ∈ boundarySets X, W = tilde Z) ∧
      ∀ Z ∈ boundarySets X, tilde Z ∈ boundarySets (tilde X) := by
  constructor
  · intro W hW hne
    have h : tilde (W.image Prod.fst) = W := by
      by_contra h
      exact hne (by rw [liftInteraction, ite_eq_right h])
    refine ⟨W.image Prod.fst, ?_, h.symm⟩
    rw [mem_boundarySets] at hW ⊢
    obtain ⟨⟨μ, hμ⟩, ⟨ν, hν⟩⟩ := hW
    rw [Finset.mem_inter] at hμ
    rw [Finset.mem_sdiff] at hν
    refine ⟨⟨μ.1, Finset.mem_inter.mpr ⟨Finset.mem_image_of_mem _ hμ.1, mem_tilde.mp hμ.2⟩⟩,
      ⟨ν.1, Finset.mem_sdiff.mpr ⟨Finset.mem_image_of_mem _ hν.1, fun h' => hν.2 (mem_tilde.mpr h')⟩⟩⟩
  · intro Z hZ
    rw [mem_boundarySets] at hZ ⊢
    obtain ⟨⟨s, hs⟩, ⟨s', hs'⟩⟩ := hZ
    rw [Finset.mem_inter] at hs
    rw [Finset.mem_sdiff] at hs'
    refine ⟨⟨(s, Spin.up), Finset.mem_inter.mpr ⟨mem_tilde.mpr hs.1, mem_tilde.mpr hs.2⟩⟩,
      ⟨(s', Spin.up), Finset.mem_sdiff.mpr ⟨mem_tilde.mpr hs'.1, fun h' => hs'.2 (mem_tilde.mp h')⟩⟩⟩

/-! ### Proof devices for (B.1), (B.2) and the iteration (phase (b); not statements of the paper) -/

theorem opCLM_zero' : opCLM (0 : Op S) = 0 :=
  map_zero (Matrix.toEuclideanCLM (n := Conf S) (𝕜 := ℂ))

theorem CAR_mono' {X Y : Finset S} (h : X ⊆ Y) : CAR X ≤ CAR Y := by
  rw [CAR_eq_CARm_tilde, CAR_eq_CARm_tilde]
  exact CARm_mono fun μ hμ => mem_tilde.mpr (h (mem_tilde.mp hμ))

theorem dyn_mem_CAR {W : Finset S} {H A : Op S} (hH : H ∈ CAR W) (hA : A ∈ CAR W) (s : ℝ) :
    dyn H s A ∈ CAR W := by
  rw [CAR_eq_CARm_tilde] at hH hA ⊢
  exact dyn_mem_CARm hH hA s

theorem isEven_dyn {H A : Op S} (hH : IsEven H) (hA : IsEven A) (s : ℝ) : IsEven (dyn H s A) := by
  have h1 : IsEven (NormedSpace.exp ((I * (s : ℂ)) • H)) := (hH.smul_left _).exp_left
  have h2 : IsEven (NormedSpace.exp ((-(I * (s : ℂ))) • H)) := (hH.smul_left _).exp_left
  exact (h1.mul_left hA).mul_left h2

theorem hamOn_mem_CAR {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) (W : Finset S) : hamOn Ψ W ∈ CAR W :=
  sum_mem fun Z hZ => CAR_mono' (Finset.mem_powerset.mp hZ) (hΨ Z).2.1

theorem isEven_hamOn {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) (W : Finset S) : IsEven (hamOn Ψ W) :=
  Commute.sum_left _ _ _ fun Z _ => (hΨ Z).2.2

theorem isSelfAdjoint_hamTot {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) : IsSelfAdjoint (hamTot Ψ) :=
  isSelfAdjoint_sum _ fun Z _ => (hΨ Z).1

theorem continuous_norm_comm_dyn (H X B : Op S) :
    Continuous fun u => ‖opCLM (dyn H u X * B - B * dyn H u X)‖ := by
  have e : (fun u => ‖opCLM (dyn H u X * B - B * dyn H u X)‖) =
      fun u => ‖opCLM (dyn H u X) * opCLM B - opCLM B * opCLM (dyn H u X)‖ := by
    funext u; rw [opCLM_sub', opCLM_mul', opCLM_mul']
  rw [e]
  have hc := continuous_opCLM_dyn H X
  fun_prop

theorem norm_comm_dyn_le_two {H : Op S} (hH : IsSelfAdjoint H) (u : ℝ) (X B : Op S) :
    ‖opCLM (dyn H u X * B - B * dyn H u X)‖ ≤ 2 * ‖opCLM X‖ * ‖opCLM B‖ := by
  calc _ ≤ 2 * ‖opCLM (dyn H u X)‖ * ‖opCLM B‖ := norm_comm_le _ _
    _ = 2 * ‖opCLM X‖ * ‖opCLM B‖ := by rw [norm_dyn hH]

/-- **(B.1)**, the one-step estimate in terms of slots: "`Then Lemma~\ref{lem:nsy-onestep} says: for $X\subset\Slots$, $A\in\CAR(X)$, every operator $B$ on $\FockS$ and every $t\ge0$,`"
"`\norm{[\tau^\Psi_t(A),B]}\le\norm{[\tau^X_t(A),B]}+2\norm A\sum_{Z\in S_\Lambda(X)}\int_0^t\norm{[\tau^\Psi_u(\Psi(Z)),B]}\,\dd u .`"
-/
theorem norm_comm_dyn_le_oneStep_slots {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {X : Finset S}
    {A : Op S} (hA : A ∈ CAR X) (B : Op S) {t : ℝ} (ht : 0 ≤ t) :
    ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      ‖opCLM (dyn (hamOn Ψ X) t A * B - B * dyn (hamOn Ψ X) t A)‖ +
        2 * ‖opCLM A‖ * ∑ Z ∈ boundarySets X, ∫ u in (0 : ℝ)..t,
          ‖opCLM (dyn (hamTot Ψ) u (Ψ Z) * B - B * dyn (hamTot Ψ) u (Ψ Z))‖ := by
  have hΦ := isEvenInteractionM_liftInteraction hΨ
  have hA' : A ∈ CARm (tilde X) := by rw [← CAR_eq_CARm_tilde]; exact hA
  have hB' : B ∈ CARm (Finset.univ : Finset (Mode S)) := by rw [CARm_univ]; exact StarSubalgebra.mem_top
  have key := norm_comm_dyn_le_oneStep hΦ hA' B hB' ht
  rw [hamOn_liftInteraction_univ, hamOn_liftInteraction] at key
  obtain ⟨h1, h2⟩ := boundarySets_liftInteraction Ψ X
  have himg : (boundarySets X).image tilde ⊆ boundarySets (tilde X) := by
    intro W hW
    obtain ⟨Z, hZ, rfl⟩ := Finset.mem_image.mp hW
    exact h2 Z hZ
  have hsum : ∑ W ∈ boundarySets (tilde X), ∫ u in (0 : ℝ)..t,
        ‖opCLM (dyn (hamTot Ψ) u (liftInteraction Ψ W) * B - B * dyn (hamTot Ψ) u (liftInteraction Ψ W))‖ =
      ∑ Z ∈ boundarySets X, ∫ u in (0 : ℝ)..t,
        ‖opCLM (dyn (hamTot Ψ) u (Ψ Z) * B - B * dyn (hamTot Ψ) u (Ψ Z))‖ := by
    rw [← Finset.sum_subset himg ?_, Finset.sum_image (fun Z _ Z' _ h => tilde_injective h)]
    · simp only [liftInteraction_tilde]
    · intro W hW hWn
      by_cases h0 : liftInteraction Ψ W = 0
      · simp only [h0, dyn_zero_op, zero_mul, mul_zero, sub_zero, opCLM_zero', norm_zero,
          intervalIntegral.integral_zero]
      · obtain ⟨Z, hZ, rfl⟩ := h1 W hW h0
        exact absurd (Finset.mem_image_of_mem _ hZ) hWn
  rw [hsum] at key
  exact key

/-- **(B.2)**, the first term: "`Hence, by Proposition~\ref{prop:nsy-disjoint}, if either $A'\in\Alg(W)$ and $B\in\CAR(Y)$, or $A'\in\CAR(W)$ and $B\in\Alg(Y)$, then $[\tau^W_u(A'),B]=0$ whenever $W\cap Y=\emptyset$; and $\norm{[\tau^W_u(A'),B]}\le2\norm{A'}\norm B$ in all cases.`"
"`\norm{[\tau^W_u(A'),B]}\le2\norm{A'}\norm B\,[W\cap Y\ne\emptyset].`" (for every `u`; the paper's `u ≥ 0`). -/
theorem norm_comm_dyn_hamOn_le {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {W Y : Finset S} {A' B : Op S}
    (h : (A' ∈ Alg W ∧ B ∈ CAR Y) ∨ (A' ∈ CAR W ∧ B ∈ Alg Y)) (u : ℝ) :
    ‖opCLM (dyn (hamOn Ψ W) u A' * B - B * dyn (hamOn Ψ W) u A')‖ ≤
      2 * ‖opCLM A'‖ * ‖opCLM B‖ * (if (W ∩ Y).Nonempty then 1 else 0) := by
  have hHsa : IsSelfAdjoint (hamOn Ψ W) := isSelfAdjoint_hamOn (fun Z => (hΨ Z).1) W
  by_cases hWY : (W ∩ Y).Nonempty
  · rw [ite_eq_left hWY, mul_one]
    exact norm_comm_dyn_le_two hHsa u A' B
  · rw [ite_eq_right hWY, mul_zero]
    have hdisj : Disjoint W Y :=
      Finset.disjoint_iff_inter_eq_empty.mpr (Finset.not_nonempty_iff_eq_empty.mp hWY)
    have hHC := hamOn_mem_CAR hΨ W
    have hHE := isEven_hamOn hΨ W
    have hcomm : dyn (hamOn Ψ W) u A' * B = B * dyn (hamOn Ψ W) u A' := by
      rcases h with ⟨hA, hB⟩ | ⟨hA, hB⟩
      · exact (commute_of_mem_Alg_of_mem_CAR hdisj ⟨dyn_mem_CAR hHC hA.1 u, isEven_dyn hHE hA.2 u⟩ hB).eq
      · exact (commute_of_mem_Alg_of_mem_CAR hdisj.symm hB (dyn_mem_CAR hHC hA u)).eq.symm
    rw [hcomm, sub_self, opCLM_zero', norm_zero]

/-! ### Proof devices for the iteration (phase (b); not statements of the paper)

The iteration is run for any real matrix `N` with `M^Ψ ≤ N` entrywise (used with `N = M^Ψ` here, and in Theorem 5.2's
deletion clause), and in a chain-free form: the bound after `m` steps is kept per slot `s` of the set, as
`lrBound N Y m t s := Σ_{j<m} (2t)^j/j! Σ_{s'∈Y} (N^j)_{ss'} + (2t)^m/m! Σ_{s'} (N^m)_{ss'}`; the paper's chains do not
appear, their sums being the entries of the powers of `N` from the start. One step of the induction is (B.1), (B.2)
and the combinatorial inequality `Σ_{Z∈S_Λ(W)} ‖Ψ(Z)‖ Σ_{s''∈Z} f(s'') ≤ Σ_{s∈W} Σ_{s''} N_{ss''} f(s'')` for `f ≥ 0`. -/

/-- Device: the per-slot bound of the iteration after `m` steps. -/
def lrBound (N : Matrix S S ℝ) (Y : Finset S) (m : ℕ) (t : ℝ) (s : S) : ℝ :=
  ∑ j ∈ Finset.range m, (2 * t) ^ j / (j.factorial : ℝ) * ∑ s' ∈ Y, (N ^ j) s s' +
    (2 * t) ^ m / (m.factorial : ℝ) * ∑ s' : S, (N ^ m) s s'

theorem chainMatrix_nonneg (Ψ : Finset S → Op S) (s s' : S) : 0 ≤ chainMatrix Ψ s s' := by
  rw [chainMatrix, Matrix.of_apply]
  exact Finset.sum_nonneg fun Z _ => norm_nonneg _

theorem pow_apply_nonneg {N : Matrix S S ℝ} (hN : ∀ s s', 0 ≤ N s s') (j : ℕ) (s s' : S) :
    0 ≤ (N ^ j) s s' := by
  induction j generalizing s s' with
  | zero => rw [pow_zero, Matrix.one_apply]; split_ifs <;> norm_num
  | succ j ih =>
    rw [pow_succ, Matrix.mul_apply]
    exact Finset.sum_nonneg fun x _ => mul_nonneg (ih _ _) (hN _ _)

theorem one_apply_nonneg' (s s' : S) : 0 ≤ (1 : Matrix S S ℝ) s s' := by
  rw [Matrix.one_apply]; split_ifs <;> norm_num

theorem sum_mul_sum_pow (N : Matrix S S ℝ) (T : Finset S) (j : ℕ) (s : S) :
    ∑ s'' : S, N s s'' * ∑ s' ∈ T, (N ^ j) s'' s' = ∑ s' ∈ T, (N ^ (j + 1)) s s' := by
  simp only [pow_succ', Matrix.mul_apply, Finset.mul_sum]
  exact Finset.sum_comm

theorem ite_le_sum_one (W Y : Finset S) :
    (if (W ∩ Y).Nonempty then (1 : ℝ) else 0) ≤ ∑ s ∈ W, ∑ s' ∈ Y, (1 : Matrix S S ℝ) s s' := by
  split_ifs with h
  · obtain ⟨x, hx⟩ := h
    rw [Finset.mem_inter] at hx
    have hx1 : ∑ s' ∈ Y, (1 : Matrix S S ℝ) x s' = 1 := by
      rw [Finset.sum_eq_single x (fun b _ hb => Matrix.one_apply_ne' hb) (fun h => absurd hx.2 h),
        Matrix.one_apply_eq]
    calc (1 : ℝ) = ∑ s' ∈ Y, (1 : Matrix S S ℝ) x s' := hx1.symm
      _ ≤ ∑ s ∈ W, ∑ s' ∈ Y, (1 : Matrix S S ℝ) s s' :=
        Finset.single_le_sum (f := fun s => ∑ s' ∈ Y, (1 : Matrix S S ℝ) s s')
          (fun s _ => Finset.sum_nonneg fun s' _ => one_apply_nonneg' s s') hx.1
  · exact Finset.sum_nonneg fun s _ => Finset.sum_nonneg fun s' _ => one_apply_nonneg' s s'

/-- Device: the combinatorial inequality of one step of the iteration. -/
theorem sum_boundarySets_le {Ψ : Finset S → Op S} {N : Matrix S S ℝ} (hN : ∀ s s', chainMatrix Ψ s s' ≤ N s s')
    (W : Finset S) {f : S → ℝ} (hf : ∀ s, 0 ≤ f s) :
    ∑ Z ∈ boundarySets W, ‖opCLM (Ψ Z)‖ * ∑ s'' ∈ Z, f s'' ≤ ∑ s ∈ W, ∑ s'' : S, N s s'' * f s'' := by
  set c : Finset S → ℝ := fun Z => ‖opCLM (Ψ Z)‖ * ∑ s'' ∈ Z, f s'' with hc
  have hc0 : ∀ Z, 0 ≤ c Z := fun Z => mul_nonneg (norm_nonneg _) (Finset.sum_nonneg fun s _ => hf s)
  have e1 : ∀ s s'', chainMatrix Ψ s s'' * f s'' =
      ∑ Z : Finset S, if s ∈ Z ∧ s'' ∈ Z then ‖opCLM (Ψ Z)‖ * f s'' else 0 := by
    intro s s''
    rw [chainMatrix, Matrix.of_apply, Finset.sum_mul, Finset.sum_filter]
  have e2 : ∀ (Z : Finset S) (s : S), (∑ s'' : S, if s ∈ Z ∧ s'' ∈ Z then ‖opCLM (Ψ Z)‖ * f s'' else 0) =
      if s ∈ Z then c Z else 0 := by
    intro Z s
    by_cases hs : s ∈ Z
    · simp only [hs, true_and, ite_true, hc]
      rw [Finset.mul_sum, ← Finset.sum_filter, Finset.filter_mem_eq_inter, Finset.univ_inter]
    · simp [hs]
  have hM : ∑ s ∈ W, ∑ s'' : S, chainMatrix Ψ s s'' * f s'' = ∑ Z : Finset S, ((W ∩ Z).card : ℝ) * c Z := by
    calc ∑ s ∈ W, ∑ s'' : S, chainMatrix Ψ s s'' * f s''
        = ∑ s ∈ W, ∑ s'' : S, ∑ Z : Finset S,
            (if s ∈ Z ∧ s'' ∈ Z then ‖opCLM (Ψ Z)‖ * f s'' else 0) := by simp_rw [e1]
      _ = ∑ s ∈ W, ∑ Z : Finset S, ∑ s'' : S,
            (if s ∈ Z ∧ s'' ∈ Z then ‖opCLM (Ψ Z)‖ * f s'' else 0) :=
          Finset.sum_congr rfl fun s _ => Finset.sum_comm
      _ = ∑ Z : Finset S, ∑ s ∈ W, ∑ s'' : S,
            (if s ∈ Z ∧ s'' ∈ Z then ‖opCLM (Ψ Z)‖ * f s'' else 0) := Finset.sum_comm
      _ = ∑ Z : Finset S, ((W ∩ Z).card : ℝ) * c Z := by
          refine Finset.sum_congr rfl fun Z _ => ?_
          simp_rw [e2]
          rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, Finset.filter_mem_eq_inter]
  calc ∑ Z ∈ boundarySets W, c Z ≤ ∑ Z ∈ boundarySets W, ((W ∩ Z).card : ℝ) * c Z := by
        refine Finset.sum_le_sum fun Z hZ => ?_
        rw [mem_boundarySets] at hZ
        have h1 : (1 : ℝ) ≤ (W ∩ Z).card := by
          rw [Finset.inter_comm]; exact_mod_cast Finset.card_pos.mpr hZ.1
        exact le_mul_of_one_le_left (hc0 Z) h1
    _ ≤ ∑ Z : Finset S, ((W ∩ Z).card : ℝ) * c Z :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) fun Z _ _ =>
          mul_nonneg (Nat.cast_nonneg _) (hc0 Z)
    _ = ∑ s ∈ W, ∑ s'' : S, chainMatrix Ψ s s'' * f s'' := hM.symm
    _ ≤ ∑ s ∈ W, ∑ s'' : S, N s s'' * f s'' :=
        Finset.sum_le_sum fun s _ => Finset.sum_le_sum fun s'' _ => mul_le_mul_of_nonneg_right (hN s s'') (hf s'')

theorem integral_two_mul_pow_div (t : ℝ) (j : ℕ) :
    ∫ u in (0 : ℝ)..t, (2 * u) ^ j / (j.factorial : ℝ) = (2 * t) ^ (j + 1) / (2 * ((j + 1).factorial : ℝ)) := by
  have h : (fun u : ℝ => (2 * u) ^ j / (j.factorial : ℝ)) = fun u => (2 ^ j / (j.factorial : ℝ)) * u ^ j := by
    funext u; rw [mul_pow]; ring
  rw [h, intervalIntegral.integral_const_mul, integral_pow, zero_pow (Nat.succ_ne_zero j), sub_zero,
    Nat.factorial_succ]
  have hf : (j.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero j)
  push_cast
  field_simp
  ring

theorem continuous_lrBound (N : Matrix S S ℝ) (Y : Finset S) (m : ℕ) (s : S) :
    Continuous fun u => lrBound N Y m u s := by
  unfold lrBound
  exact (continuous_finsetSum _ fun j _ => by fun_prop).add (by fun_prop)

theorem lrBound_nonneg {N : Matrix S S ℝ} (hN : ∀ s s', 0 ≤ N s s') (Y : Finset S) (m : ℕ) {t : ℝ} (ht : 0 ≤ t)
    (s : S) : 0 ≤ lrBound N Y m t s := by
  unfold lrBound
  have h2t : 0 ≤ 2 * t := by linarith
  exact add_nonneg (Finset.sum_nonneg fun j _ => mul_nonneg (div_nonneg (pow_nonneg h2t _) (Nat.cast_nonneg _))
      (Finset.sum_nonneg fun s' _ => pow_apply_nonneg hN _ _ _))
    (mul_nonneg (div_nonneg (pow_nonneg h2t _) (Nat.cast_nonneg _))
      (Finset.sum_nonneg fun s' _ => pow_apply_nonneg hN _ _ _))

theorem integral_lrBound (N : Matrix S S ℝ) (Y : Finset S) (m : ℕ) (t : ℝ) (s : S) :
    ∫ u in (0 : ℝ)..t, lrBound N Y m u s =
      ∑ j ∈ Finset.range m, (2 * t) ^ (j + 1) / (2 * ((j + 1).factorial : ℝ)) * ∑ s' ∈ Y, (N ^ j) s s' +
        (2 * t) ^ (m + 1) / (2 * ((m + 1).factorial : ℝ)) * ∑ s' : S, (N ^ m) s s' := by
  unfold lrBound
  have hint : ∀ (k : ℕ) (c : ℝ),
      IntervalIntegrable (fun u : ℝ => (2 * u) ^ k / (k.factorial : ℝ) * c) MeasureTheory.volume 0 t :=
    fun k c => (by fun_prop : Continuous fun u : ℝ => (2 * u) ^ k / (k.factorial : ℝ) * c).intervalIntegrable _ _
  have hc1 : Continuous fun u : ℝ => ∑ j ∈ Finset.range m, (2 * u) ^ j / (j.factorial : ℝ) * ∑ s' ∈ Y, (N ^ j) s s' :=
    continuous_finsetSum _ fun j _ => by fun_prop
  rw [intervalIntegral.integral_add (hc1.intervalIntegrable 0 t) (hint m _),
    intervalIntegral.integral_finsetSum (fun j _ => hint j _)]
  simp only [intervalIntegral.integral_mul_const, integral_two_mul_pow_div]

theorem two_mul_sum_mul_lin (N : Matrix S S ℝ) (s : S) (m : ℕ) (c : ℕ → ℝ) (e : ℝ) (F : ℕ → S → ℝ)
    (G : S → ℝ) :
    2 * ∑ s'' : S, N s s'' * (∑ j ∈ Finset.range m, c j * F j s'' + e * G s'') =
      ∑ j ∈ Finset.range m, (2 * c j) * ∑ s'' : S, N s s'' * F j s'' + (2 * e) * ∑ s'' : S, N s s'' * G s'' := by
  simp only [mul_add, Finset.mul_sum, Finset.sum_add_distrib]
  rw [Finset.sum_comm]
  congr 1
  · exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun s'' _ => by ring
  · exact Finset.sum_congr rfl fun s'' _ => by ring

theorem lrBound_succ (N : Matrix S S ℝ) (Y : Finset S) (m : ℕ) (t : ℝ) (s : S) :
    lrBound N Y (m + 1) t s =
      ∑ s' ∈ Y, (1 : Matrix S S ℝ) s s' + 2 * ∑ s'' : S, N s s'' * ∫ u in (0 : ℝ)..t, lrBound N Y m u s'' := by
  simp only [integral_lrBound]
  have h := two_mul_sum_mul_lin N s m (fun j => (2 * t) ^ (j + 1) / (2 * ((j + 1).factorial : ℝ)))
    ((2 * t) ^ (m + 1) / (2 * ((m + 1).factorial : ℝ))) (fun j s'' => ∑ s' ∈ Y, (N ^ j) s'' s')
    (fun s'' => ∑ s' : S, (N ^ m) s'' s')
  beta_reduce at h
  rw [h]
  simp only [sum_mul_sum_pow]
  have hc : ∀ j : ℕ, 2 * ((2 * t) ^ (j + 1) / (2 * ((j + 1).factorial : ℝ))) =
      (2 * t) ^ (j + 1) / ((j + 1).factorial : ℝ) := fun j => by ring
  simp only [hc]
  rw [lrBound, Finset.sum_range_succ']
  simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, div_one, one_mul]
  ring

/-- Device: one step of the iteration — (B.1), (B.2) and a bound `G` on the commutators of the terms. -/
theorem norm_comm_dyn_le_step {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {W Y : Finset S} {A' B : Op S}
    (h : (A' ∈ CAR W ∧ B ∈ Alg Y) ∨ (A' ∈ Alg W ∧ B ∈ CAR Y)) {t : ℝ} (ht : 0 ≤ t)
    (G : Finset S → ℝ → ℝ) (hGc : ∀ Z, Continuous (G Z))
    (hG : ∀ Z ∈ boundarySets W, ∀ u ∈ Set.Icc (0 : ℝ) t,
      ‖opCLM (dyn (hamTot Ψ) u (Ψ Z) * B - B * dyn (hamTot Ψ) u (Ψ Z))‖ ≤ 2 * ‖opCLM (Ψ Z)‖ * ‖opCLM B‖ * G Z u) :
    ‖opCLM (dyn (hamTot Ψ) t A' * B - B * dyn (hamTot Ψ) t A')‖ ≤
      2 * ‖opCLM A'‖ * ‖opCLM B‖ * ((if (W ∩ Y).Nonempty then 1 else 0) +
        2 * ∑ Z ∈ boundarySets W, ‖opCLM (Ψ Z)‖ * ∫ u in (0 : ℝ)..t, G Z u) := by
  have hA'C : A' ∈ CAR W := by
    rcases h with ⟨hA, _⟩ | ⟨hA, _⟩
    · exact hA
    · exact hA.1
  have h1 := norm_comm_dyn_le_oneStep_slots hΨ hA'C B ht
  have h2 := norm_comm_dyn_hamOn_le hΨ h.symm t
  have h3 : ∑ Z ∈ boundarySets W, ∫ u in (0 : ℝ)..t,
        ‖opCLM (dyn (hamTot Ψ) u (Ψ Z) * B - B * dyn (hamTot Ψ) u (Ψ Z))‖ ≤
      ∑ Z ∈ boundarySets W, 2 * ‖opCLM (Ψ Z)‖ * ‖opCLM B‖ * ∫ u in (0 : ℝ)..t, G Z u := by
    refine Finset.sum_le_sum fun Z hZ => ?_
    rw [← intervalIntegral.integral_const_mul]
    exact intervalIntegral.integral_mono_on ht ((continuous_norm_comm_dyn _ _ _).intervalIntegrable _ _)
      ((continuous_const.mul (hGc Z)).intervalIntegrable _ _) fun u hu => hG Z hZ u hu
  have h4 : 2 * ‖opCLM A'‖ * ∑ Z ∈ boundarySets W, 2 * ‖opCLM (Ψ Z)‖ * ‖opCLM B‖ * ∫ u in (0 : ℝ)..t, G Z u =
      2 * ‖opCLM A'‖ * ‖opCLM B‖ * (2 * ∑ Z ∈ boundarySets W, ‖opCLM (Ψ Z)‖ * ∫ u in (0 : ℝ)..t, G Z u) := by
    simp only [Finset.mul_sum]
    exact Finset.sum_congr rfl fun Z _ => by ring
  calc _ ≤ _ := h1
    _ ≤ 2 * ‖opCLM A'‖ * ‖opCLM B‖ * (if (W ∩ Y).Nonempty then 1 else 0) +
        2 * ‖opCLM A'‖ * ∑ Z ∈ boundarySets W, 2 * ‖opCLM (Ψ Z)‖ * ‖opCLM B‖ * ∫ u in (0 : ℝ)..t, G Z u :=
      add_le_add h2 (mul_le_mul_of_nonneg_left h3 (by positivity))
    _ = _ := by rw [h4, ← mul_add]

/-- Device: the induction step of the iteration, for any set `W`. -/
theorem norm_comm_dyn_le_lrBound_succ {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {N : Matrix S S ℝ}
    (hN : ∀ s s', chainMatrix Ψ s s' ≤ N s s') {W Y : Finset S} {A' B : Op S}
    (h : (A' ∈ CAR W ∧ B ∈ Alg Y) ∨ (A' ∈ Alg W ∧ B ∈ CAR Y)) {t : ℝ} (ht : 0 ≤ t) (m : ℕ)
    (ih : ∀ Z : Finset S, Z.Nonempty → ∀ u : ℝ, 0 ≤ u →
      ‖opCLM (dyn (hamTot Ψ) u (Ψ Z) * B - B * dyn (hamTot Ψ) u (Ψ Z))‖ ≤
        2 * ‖opCLM (Ψ Z)‖ * ‖opCLM B‖ * ∑ s ∈ Z, lrBound N Y m u s) :
    ‖opCLM (dyn (hamTot Ψ) t A' * B - B * dyn (hamTot Ψ) t A')‖ ≤
      2 * ‖opCLM A'‖ * ‖opCLM B‖ * ∑ s ∈ W, lrBound N Y (m + 1) t s := by
  have hN0 : ∀ s s', 0 ≤ N s s' := fun s s' => (chainMatrix_nonneg Ψ s s').trans (hN s s')
  have hstep := norm_comm_dyn_le_step hΨ h ht (fun Z u => ∑ s ∈ Z, lrBound N Y m u s)
    (fun Z => continuous_finsetSum _ fun s _ => continuous_lrBound N Y m s)
    (fun Z hZ u hu => ih Z ((mem_boundarySets.mp hZ).1.mono Finset.inter_subset_left) u hu.1)
  beta_reduce at hstep
  refine hstep.trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
  have hint : ∀ Z : Finset S, ∫ u in (0 : ℝ)..t, ∑ s ∈ Z, lrBound N Y m u s =
      ∑ s ∈ Z, ∫ u in (0 : ℝ)..t, lrBound N Y m u s := fun Z =>
    intervalIntegral.integral_finsetSum fun s _ => (continuous_lrBound N Y m s).intervalIntegrable _ _
  simp only [hint]
  have hnn : ∀ s, 0 ≤ ∫ u in (0 : ℝ)..t, lrBound N Y m u s := fun s =>
    intervalIntegral.integral_nonneg ht fun u hu => lrBound_nonneg hN0 Y m hu.1 s
  have hcomb := sum_boundarySets_le hN W hnn
  calc (if (W ∩ Y).Nonempty then (1 : ℝ) else 0) +
        2 * ∑ Z ∈ boundarySets W, ‖opCLM (Ψ Z)‖ * ∑ s ∈ Z, ∫ u in (0 : ℝ)..t, lrBound N Y m u s
      ≤ ∑ s ∈ W, ∑ s' ∈ Y, (1 : Matrix S S ℝ) s s' +
          2 * ∑ s ∈ W, ∑ s'' : S, N s s'' * ∫ u in (0 : ℝ)..t, lrBound N Y m u s'' :=
        add_le_add (ite_le_sum_one W Y) (mul_le_mul_of_nonneg_left hcomb (by norm_num))
    _ = ∑ s ∈ W, lrBound N Y (m + 1) t s := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun s _ => (lrBound_succ N Y m t s).symm

/-- Device: the iteration for the terms of the interaction (nonempty sets), by induction on `m`. -/
theorem norm_comm_dyn_le_lrBound_of_nonempty {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ)
    {N : Matrix S S ℝ} (hN : ∀ s s', chainMatrix Ψ s s' ≤ N s s') {Y : Finset S} {B : Op S} (hB : B ∈ CAR Y)
    (m : ℕ) :
    ∀ Z : Finset S, Z.Nonempty → ∀ u : ℝ, 0 ≤ u →
      ‖opCLM (dyn (hamTot Ψ) u (Ψ Z) * B - B * dyn (hamTot Ψ) u (Ψ Z))‖ ≤
        2 * ‖opCLM (Ψ Z)‖ * ‖opCLM B‖ * ∑ s ∈ Z, lrBound N Y m u s := by
  induction m with
  | zero =>
    intro Z hZ u _
    have h0 : ∀ s, lrBound N Y 0 u s = 1 := by
      intro s
      simp [lrBound, Matrix.one_apply]
    simp only [h0, Finset.sum_const, nsmul_eq_mul, mul_one]
    calc _ ≤ 2 * ‖opCLM (Ψ Z)‖ * ‖opCLM B‖ := norm_comm_dyn_le_two (isSelfAdjoint_hamTot hΨ) u _ _
      _ ≤ 2 * ‖opCLM (Ψ Z)‖ * ‖opCLM B‖ * (Z.card : ℝ) := by
        have h1 : (1 : ℝ) ≤ Z.card := by exact_mod_cast Finset.card_pos.mpr hZ
        exact le_mul_of_one_le_right (by positivity) h1
  | succ m ih =>
    intro Z _ u hu
    exact norm_comm_dyn_le_lrBound_succ hΨ hN (Or.inr ⟨(hΨ Z).2, hB⟩) hu m ih

theorem rowSum_pow_le (Ψ : Finset S → Op S) (k : ℕ) (s : S) :
    ∑ s' : S, (chainMatrix Ψ ^ k) s s' ≤ chainRowMax Ψ ^ k := by
  have hμ : 0 ≤ chainRowMax Ψ :=
    Real.iSup_nonneg fun s => Finset.sum_nonneg fun s' _ => chainMatrix_nonneg Ψ s s'
  induction k generalizing s with
  | zero =>
    rw [pow_zero, pow_zero]
    rw [Finset.sum_eq_single s (fun b _ hb => Matrix.one_apply_ne' hb) (fun h => absurd (Finset.mem_univ s) h),
      Matrix.one_apply_eq]
  | succ k ih =>
    rw [← sum_mul_sum_pow]
    calc ∑ s'' : S, chainMatrix Ψ s s'' * ∑ s' : S, (chainMatrix Ψ ^ k) s'' s'
        ≤ ∑ s'' : S, chainMatrix Ψ s s'' * chainRowMax Ψ ^ k :=
          Finset.sum_le_sum fun s'' _ => mul_le_mul_of_nonneg_left (ih s'') (chainMatrix_nonneg _ _ _)
      _ = (∑ s'' : S, chainMatrix Ψ s s'') * chainRowMax Ψ ^ k := by rw [Finset.sum_mul]
      _ ≤ chainRowMax Ψ * chainRowMax Ψ ^ k :=
          mul_le_mul_of_nonneg_right (le_ciSup (f := fun s => ∑ s' : S, chainMatrix Ψ s s')
            (Finite.bddAbove_range _) s) (pow_nonneg hμ k)
      _ = chainRowMax Ψ ^ (k + 1) := by rw [pow_succ']

/-- **The iteration (B.3) with the chain sums bounded by powers of the chain matrix** — the proof's steps
"Iteration" (`\eqref{eq:LR-iterate}` for every `n`) and "Chains and powers of the chain matrix"
("`a_n\le\sum_{s\in X,\ s'\in Y}(M^n)_{ss'},\qquad b_n\le\sum_{s\in X,\ s'\in\Slots}(M^n)_{ss'}\le\abs X\mu^n .`"), combined as
the step "The first bound" uses them: "`R_n(t)\le2\norm A\norm B\,\frac{(2t)^{n+1}}{(n+1)!}\,b_{n+1}.`" So, for `t ≥ 0` and
every `n`, `‖[τ^Ψ_t(A), B]‖ ≤ 2‖A‖‖B‖ Σ_{j ≤ n} (2t)^j/j! Σ_{s∈X, s'∈Y} (M^j)_{ss'} + 2‖A‖‖B‖ |X| (2tμ)^{n+1}/(n+1)!`. The
chains themselves are the proof's device and are not stated. -/
theorem norm_comm_dyn_le_partialSum {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {X Y : Finset S}
    {A B : Op S} (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) {t : ℝ} (ht : 0 ≤ t) (n : ℕ) :
    ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      2 * ‖opCLM A‖ * ‖opCLM B‖ * ∑ j ∈ Finset.range (n + 1),
          (2 * t) ^ j / (j.factorial : ℝ) * ∑ s ∈ X, ∑ s' ∈ Y, (chainMatrix Ψ ^ j) s s' +
        2 * ‖opCLM A‖ * ‖opCLM B‖ * (X.card : ℝ) * (2 * t * chainRowMax Ψ) ^ (n + 1) /
          ((n + 1).factorial : ℝ) := by
  have hB : B ∈ CAR Y := by
    rcases hAB with ⟨_, hB⟩ | ⟨_, hB⟩
    · exact hB.1
    · exact hB
  have hN : ∀ s s', chainMatrix Ψ s s' ≤ chainMatrix Ψ s s' := fun _ _ => le_rfl
  have key := norm_comm_dyn_le_lrBound_succ hΨ hN hAB ht n (norm_comm_dyn_le_lrBound_of_nonempty hΨ hN hB n)
  refine key.trans ?_
  have hsplit : ∑ s ∈ X, lrBound (chainMatrix Ψ) Y (n + 1) t s =
      ∑ j ∈ Finset.range (n + 1), (2 * t) ^ j / (j.factorial : ℝ) * ∑ s ∈ X, ∑ s' ∈ Y, (chainMatrix Ψ ^ j) s s' +
        (2 * t) ^ (n + 1) / ((n + 1).factorial : ℝ) * ∑ s ∈ X, ∑ s' : S, (chainMatrix Ψ ^ (n + 1)) s s' := by
    simp only [lrBound, Finset.sum_add_distrib, Finset.mul_sum]
    rw [Finset.sum_comm]
  have hrow : ∑ s ∈ X, ∑ s' : S, (chainMatrix Ψ ^ (n + 1)) s s' ≤ (X.card : ℝ) * chainRowMax Ψ ^ (n + 1) := by
    calc _ ≤ ∑ s ∈ X, chainRowMax Ψ ^ (n + 1) := Finset.sum_le_sum fun s _ => rowSum_pow_le Ψ (n + 1) s
      _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]
  have hc0 : 0 ≤ (2 * t) ^ (n + 1) / ((n + 1).factorial : ℝ) :=
    div_nonneg (pow_nonneg (by linarith) _) (Nat.cast_nonneg _)
  have hK0 : 0 ≤ 2 * ‖opCLM A‖ * ‖opCLM B‖ := by positivity
  rw [hsplit, mul_add]
  refine add_le_add le_rfl ?_
  calc 2 * ‖opCLM A‖ * ‖opCLM B‖ *
        ((2 * t) ^ (n + 1) / ((n + 1).factorial : ℝ) * ∑ s ∈ X, ∑ s' : S, (chainMatrix Ψ ^ (n + 1)) s s')
      ≤ 2 * ‖opCLM A‖ * ‖opCLM B‖ *
        ((2 * t) ^ (n + 1) / ((n + 1).factorial : ℝ) * ((X.card : ℝ) * chainRowMax Ψ ^ (n + 1))) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hrow hc0) hK0
    _ = _ := by ring

/-! ### Theorem 5.2, the matrix bounds -/

/-! ### Proof devices for Theorem 5.2 (phase (b); not statements of the paper)

The partial sums of the iteration converge to the entries of `e^{2tN}` and the remainders to `0` (the terms of a
convergent series); `t < 0` is reduced to `−t > 0` by `τ^Ψ_t = τ^{−Ψ}_{−t}`, `−Ψ` being an even interaction with the same
chain matrix. Everything is proved for any real matrix `N ≥ M^Ψ` entrywise, which gives the deletion clause. -/

theorem hasSum_exp_matrix (x : Matrix S S ℝ) :
    HasSum (fun n : ℕ => ((n.factorial : ℝ)⁻¹) • x ^ n) (NormedSpace.exp x) := by
  let : NormedRing (Matrix S S ℝ) := Matrix.linftyOpNormedRing
  let : NormedAlgebra ℝ (Matrix S S ℝ) := Matrix.linftyOpNormedAlgebra
  exact NormedSpace.exp_series_hasSum_exp' (𝕂 := ℝ) x

theorem hasSum_exp_matrix_apply (x : Matrix S S ℝ) (s s' : S) :
    HasSum (fun n : ℕ => ((n.factorial : ℝ)⁻¹) * (x ^ n) s s') (NormedSpace.exp x s s') := by
  have h1 := Pi.hasSum.mp (hasSum_exp_matrix x) s
  have h2 := Pi.hasSum.mp h1 s'
  simpa only [Matrix.smul_apply, smul_eq_mul] using h2

open Filter Topology in
theorem lieb_robinson_gen_nonneg {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {N : Matrix S S ℝ}
    (hN : ∀ s s', chainMatrix Ψ s s' ≤ N s s') {X Y : Finset S} {A B : Op S}
    (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) {t : ℝ} (ht : 0 ≤ t) :
    ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      2 * ‖opCLM A‖ * ‖opCLM B‖ * ∑ s ∈ X, ∑ s' ∈ Y, NormedSpace.exp ((2 * t) • N) s s' := by
  have hB : B ∈ CAR Y := by
    rcases hAB with ⟨_, hB⟩ | ⟨_, hB⟩
    · exact hB.1
    · exact hB
  have hbound : ∀ m : ℕ, ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      2 * ‖opCLM A‖ * ‖opCLM B‖ * ∑ s ∈ X, lrBound N Y (m + 1) t s := fun m =>
    norm_comm_dyn_le_lrBound_succ hΨ hN hAB ht m (norm_comm_dyn_le_lrBound_of_nonempty hΨ hN hB m)
  have hterm : ∀ (j : ℕ) (s s' : S), ((j.factorial : ℝ)⁻¹) * (((2 * t) • N) ^ j) s s' =
      (2 * t) ^ j / (j.factorial : ℝ) * (N ^ j) s s' := by
    intro j s s'
    rw [smul_pow, Matrix.smul_apply, smul_eq_mul]
    ring
  have hs : ∀ s s', HasSum (fun j : ℕ => (2 * t) ^ j / (j.factorial : ℝ) * (N ^ j) s s')
      (NormedSpace.exp ((2 * t) • N) s s') := by
    intro s s'
    have h := hasSum_exp_matrix_apply ((2 * t) • N) s s'
    simp only [hterm] at h
    exact h
  have hT : ∀ (T : Finset S) (s : S), HasSum (fun j : ℕ => (2 * t) ^ j / (j.factorial : ℝ) * ∑ s' ∈ T, (N ^ j) s s')
      (∑ s' ∈ T, NormedSpace.exp ((2 * t) • N) s s') := by
    intro T s
    have h := hasSum_sum (s := T) fun s' _ => hs s s'
    simpa only [Finset.mul_sum] using h
  have hlim : ∀ s, Tendsto (fun m : ℕ => lrBound N Y (m + 1) t s) atTop
      (𝓝 (∑ s' ∈ Y, NormedSpace.exp ((2 * t) • N) s s')) := by
    intro s
    have h1 := ((hT Y s).tendsto_sum_nat).comp (tendsto_add_atTop_nat 1)
    have h2 : Tendsto (fun m : ℕ => (2 * t) ^ (m + 1) / ((m + 1).factorial : ℝ) * ∑ s' : S, (N ^ (m + 1)) s s')
        atTop (𝓝 0) :=
      ((hT Finset.univ s).summable.tendsto_atTop_zero).comp (tendsto_add_atTop_nat 1)
    have h3 := h1.add h2
    rw [add_zero] at h3
    refine h3.congr fun m => ?_
    simp only [Function.comp_apply, lrBound]
  have hlimX : Tendsto (fun m : ℕ => 2 * ‖opCLM A‖ * ‖opCLM B‖ * ∑ s ∈ X, lrBound N Y (m + 1) t s) atTop
      (𝓝 (2 * ‖opCLM A‖ * ‖opCLM B‖ * ∑ s ∈ X, ∑ s' ∈ Y, NormedSpace.exp ((2 * t) • N) s s')) :=
    (tendsto_finsetSum _ fun s _ => hlim s).const_mul _
  exact ge_of_tendsto' hlimX hbound

theorem dyn_neg_neg (H : Op S) (t : ℝ) (A : Op S) : dyn (-H) (-t) A = dyn H t A := by
  simp only [dyn, smul_neg, Complex.ofReal_neg, mul_neg, neg_neg, neg_smul]

theorem hamTot_neg (Ψ : Finset S → Op S) : hamTot (fun Z => -Ψ Z) = -hamTot Ψ := by
  simp only [hamTot, Finset.sum_neg_distrib]

theorem chainMatrix_neg (Ψ : Finset S → Op S) : chainMatrix (fun Z => -Ψ Z) = chainMatrix Ψ := by
  ext s s'
  simp only [chainMatrix, Matrix.of_apply, opCLM_neg', norm_neg]

theorem isEvenInteraction_neg {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) :
    IsEvenInteraction (fun Z => -Ψ Z) := fun Z =>
  ⟨(hΨ Z).1.neg, neg_mem (hΨ Z).2.1, (hΨ Z).2.2.neg_left⟩

/-- Device: Theorem 5.2's first bound for any `N ≥ M^Ψ` entrywise. -/
theorem lieb_robinson_gen {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {N : Matrix S S ℝ}
    (hN : ∀ s s', chainMatrix Ψ s s' ≤ N s s') {X Y : Finset S} {A B : Op S}
    (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) (t : ℝ) :
    ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      2 * ‖opCLM A‖ * ‖opCLM B‖ * ∑ s ∈ X, ∑ s' ∈ Y, NormedSpace.exp ((2 * |t|) • N) s s' := by
  rcases le_or_gt 0 t with ht | ht
  · rw [abs_of_nonneg ht]
    exact lieb_robinson_gen_nonneg hΨ hN hAB ht
  · rw [abs_of_neg ht]
    have hN' : ∀ s s', chainMatrix (fun Z => -Ψ Z) s s' ≤ N s s' := by
      intro s s'
      rw [chainMatrix_neg]
      exact hN s s'
    have h := lieb_robinson_gen_nonneg (isEvenInteraction_neg hΨ) hN' hAB (neg_nonneg.mpr ht.le)
    rwa [hamTot_neg, dyn_neg_neg] at h

theorem sum_sum_one_eq_zero {X Y : Finset S} (hXY : Disjoint X Y) :
    ∑ s ∈ X, ∑ s' ∈ Y, (1 : Matrix S S ℝ) s s' = 0 := by
  refine Finset.sum_eq_zero fun s hs => Finset.sum_eq_zero fun s' hs' => ?_
  refine Matrix.one_apply_ne ?_
  rintro rfl
  exact Finset.disjoint_left.mp hXY hs hs'

theorem sum_sum_exp_sub_one {X Y : Finset S} (hXY : Disjoint X Y) (x : Matrix S S ℝ) :
    ∑ s ∈ X, ∑ s' ∈ Y, (NormedSpace.exp x - 1) s s' = ∑ s ∈ X, ∑ s' ∈ Y, NormedSpace.exp x s s' := by
  simp only [Matrix.sub_apply, Finset.sum_sub_distrib, sum_sum_one_eq_zero hXY, sub_zero]

/-- **Theorem 5.2**: "`Let $\Psi$ be an even interaction on $\Slots$, let $X,Y\subset\Slots$, and let $A\in\CAR(X)$, $B\in\Alg(Y)$ (or $A\in\Alg(X)$, $B\in\CAR(Y)$). Then for every $t\in\R$`"
"`\norm{[\tau^\Psi_t(A),B]}\le2\norm A\norm B\sum_{s\in X,\ s'\in Y}\bigl[e^{2\abs t M^\Psi}\bigr]_{ss'},`" -/
theorem lieb_robinson {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {X Y : Finset S} {A B : Op S}
    (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) (t : ℝ) :
    ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      2 * ‖opCLM A‖ * ‖opCLM B‖ * ∑ s ∈ X, ∑ s' ∈ Y, NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) s s' := by
  exact lieb_robinson_gen hΨ (fun _ _ => le_rfl) hAB t

/-- **Theorem 5.2**: "`and the matrix $e^{2\abs tM^\Psi}$ may be replaced by $e^{2\abs tM^\Psi}-\one$ if $X\cap Y=\emptyset$.`" -/
theorem lieb_robinson_of_disjoint {Ψ : Finset S → Op S} (hΨ : IsEvenInteraction Ψ) {X Y : Finset S} {A B : Op S}
    (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) (hXY : Disjoint X Y) (t : ℝ) :
    ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      2 * ‖opCLM A‖ * ‖opCLM B‖ *
        ∑ s ∈ X, ∑ s' ∈ Y, (NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) - 1) s s' := by
  rw [sum_sum_exp_sub_one hXY]
  exact lieb_robinson hΨ hAB t

/-- **Theorem 5.2**, the last sentence, for the matrix bounds: "`Both bounds remain valid, with the same matrix $M^\Psi$, for the dynamics of any interaction obtained from $\Psi$ by setting some of its terms to zero.`"
— for every `Ψ'` with `Ψ'(Z) ∈ {Ψ(Z), 0}`. -/
theorem lieb_robinson_of_terms_zero {Ψ Ψ' : Finset S → Op S} (hΨ : IsEvenInteraction Ψ)
    (hΨ' : ∀ Z : Finset S, Ψ' Z = Ψ Z ∨ Ψ' Z = 0) {X Y : Finset S} {A B : Op S}
    (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) (t : ℝ) :
    ‖opCLM (dyn (hamTot Ψ') t A * B - B * dyn (hamTot Ψ') t A)‖ ≤
        2 * ‖opCLM A‖ * ‖opCLM B‖ * ∑ s ∈ X, ∑ s' ∈ Y, NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) s s' ∧
      (Disjoint X Y → ‖opCLM (dyn (hamTot Ψ') t A * B - B * dyn (hamTot Ψ') t A)‖ ≤
        2 * ‖opCLM A‖ * ‖opCLM B‖ *
          ∑ s ∈ X, ∑ s' ∈ Y, (NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) - 1) s s') := by
  have hΨe : IsEvenInteraction Ψ' := by
    intro Z
    rcases hΨ' Z with h | h
    · rw [h]; exact hΨ Z
    · rw [h]; exact ⟨IsSelfAdjoint.zero _, zero_mem _, Commute.zero_left _⟩
  have hN : ∀ s s', chainMatrix Ψ' s s' ≤ chainMatrix Ψ s s' := by
    intro s s'
    simp only [chainMatrix, Matrix.of_apply]
    refine Finset.sum_le_sum fun Z _ => ?_
    rcases hΨ' Z with h | h
    · rw [h]
    · rw [h, opCLM_zero', norm_zero]; exact norm_nonneg _
  have h := lieb_robinson_gen hΨe hN hAB t
  refine ⟨h, fun hXY => ?_⟩
  rw [sum_sum_exp_sub_one hXY]
  exact h

end SlotsAndModes

/-! ## The slot lattice: distances to sets, `C(Ψ, λ)`, (B.4), Theorem 5.2's weighted bounds -/

section SlotLattice

variable {δ₀ : ℝ} {T : Torus}

/-- **Definition 3.1**: "`$d(X,Y):=\min\{d(s,s'):s\in X,\ s'\in Y\}$`" for sets of slots, in `ℝ≥0∞`, with the minimum
over the empty set `⊤` (block B's convention for the fattening; the module docstring). `d(s, Y)` is
`slotSetDist {s} Y`. -/
def slotSetDist (X Y : Finset (Slot δ₀ T)) : ℝ≥0∞ :=
  (X ×ˢ Y).inf fun p => ENNReal.ofReal (slotDist δ₀ T p.1 p.2)

/-- The weight `e^{−d/λ}` of a distance `d ∈ [0, ∞]`, with `e^{−∞} := 0`. -/
def expNegDiv (d : ℝ≥0∞) (lam : ℝ) : ℝ :=
  if d = ⊤ then 0 else Real.exp (-d.toReal / lam)

/-- **Theorem 5.2**: "`For $\lambda>0$ let $C(\Psi,\lambda):=\max_s\sum_{s'}M^\Psi_{ss'}e^{d(s,s')/\lambda}$.`" (a real
supremum over the finite slot set). -/
def chainWeight (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) (lam : ℝ) : ℝ :=
  ⨆ s : Slot δ₀ T, ∑ s' : Slot δ₀ T, chainMatrix Ψ s s' * Real.exp (slotDist δ₀ T s s' / lam)

/-- For nonempty sets, `slotSetDist` is the real minimum `min{d(s, s') : s ∈ X, s' ∈ Y}`. -/
theorem slotSetDist_eq_inf' {X Y : Finset (Slot δ₀ T)} (hX : X.Nonempty) (hY : Y.Nonempty) :
    slotSetDist X Y = ENNReal.ofReal ((X ×ˢ Y).inf' (hX.product hY) fun p => slotDist δ₀ T p.1 p.2) := by
  rw [slotSetDist, ← Finset.inf'_eq_inf (hX.product hY),
    Finset.apply_inf'_eq_inf'_comp (hX.product hY) ENNReal.ofReal fun x y => (ENNReal.ofReal_mono).map_min]
  rfl

/-- The distance from the empty set is `⊤`. -/
theorem slotSetDist_empty_left (Y : Finset (Slot δ₀ T)) : slotSetDist (∅ : Finset (Slot δ₀ T)) Y = ⊤ := by
  simp [slotSetDist]

/-- The distance to the empty set is `⊤`. -/
theorem slotSetDist_empty_right (X : Finset (Slot δ₀ T)) : slotSetDist X (∅ : Finset (Slot δ₀ T)) = ⊤ := by
  simp [slotSetDist]

/-- The fattening is `X^{(r)} = {s : d(s, X) ≤ r}` (**Definition 3.7**: "`For $r\ge0$ the \emph{$r$-fattening} of $X$ is $\fat Xr:=\{s\in\Slots:d(s,X)\le r\}$`"),
for every `X`, the empty set included. -/
theorem mem_fat_iff_slotSetDist {X : Finset (Slot δ₀ T)} {r : ℝ} (hr : 0 ≤ r) (s : Slot δ₀ T) :
    s ∈ fat X r ↔ slotSetDist {s} X ≤ ENNReal.ofReal r := by
  rw [mem_fat, slotSetDist, Finset.inf_le_iff ENNReal.ofReal_lt_top]
  constructor
  · rintro ⟨s', hs', hd⟩
    exact ⟨(s, s'), Finset.mem_product.mpr ⟨Finset.mem_singleton_self s, hs'⟩, ENNReal.ofReal_le_ofReal hd⟩
  · rintro ⟨⟨a, b⟩, hab, hd⟩
    obtain ⟨ha, hb⟩ := Finset.mem_product.mp hab
    rw [Finset.mem_singleton] at ha
    subst ha
    exact ⟨b, hb, (ENNReal.ofReal_le_ofReal_iff hr).mp hd⟩

/-- For a finite distance `d ≥ 0`, `expNegDiv` is `e^{−d/λ}`. -/
theorem expNegDiv_ofReal {d : ℝ} (hd : 0 ≤ d) (lam : ℝ) :
    expNegDiv (ENNReal.ofReal d) lam = Real.exp (-d / lam) := by
  rw [expNegDiv, ite_eq_right ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hd]

/-! ### Proof devices for (B.4) and the weighted bounds (phase (b); not statements of the paper)

The weighted matrix `M^w_{ss'} := M_{ss'} e^{d(s,s')/λ}` (`weightedChainMatrix`): by the triangle inequality
`(M^n)_{ss'} ≤ e^{−d(s,s')/λ} ((M^w)^n)_{ss'}`, and the row sums of `(M^w)^n` are at most `C(Ψ, λ)^n`; summing the
exponential series gives (B.4). -/

theorem rowSum_pow_le_of {S : Type*} [Fintype S] [DecidableEq S] {N : Matrix S S ℝ} (hN : ∀ s s', 0 ≤ N s s')
    {c : ℝ} (hc : 0 ≤ c) (hrow : ∀ s, ∑ s' : S, N s s' ≤ c) (k : ℕ) (s : S) :
    ∑ s' : S, (N ^ k) s s' ≤ c ^ k := by
  induction k generalizing s with
  | zero =>
    rw [pow_zero, pow_zero, Finset.sum_eq_single s (fun b _ hb => Matrix.one_apply_ne' hb)
      (fun h => absurd (Finset.mem_univ s) h), Matrix.one_apply_eq]
  | succ k ih =>
    rw [← sum_mul_sum_pow]
    calc ∑ s'' : S, N s s'' * ∑ s' : S, (N ^ k) s'' s'
        ≤ ∑ s'' : S, N s s'' * c ^ k :=
          Finset.sum_le_sum fun s'' _ => mul_le_mul_of_nonneg_left (ih s'') (hN _ _)
      _ = (∑ s'' : S, N s s'') * c ^ k := by rw [Finset.sum_mul]
      _ ≤ c * c ^ k := mul_le_mul_of_nonneg_right (hrow s) (pow_nonneg hc k)
      _ = c ^ (k + 1) := by rw [pow_succ']

theorem slotDist_nonneg' (s s' : Slot δ₀ T) : 0 ≤ slotDist δ₀ T s s' :=
  Real.sqrt_nonneg _

/-- Device: the weighted chain matrix `M_{ss'} e^{d(s,s')/λ}`, whose row sums define `C(Ψ, λ)`. -/
def weightedChainMatrix (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) (lam : ℝ) :
    Matrix (Slot δ₀ T) (Slot δ₀ T) ℝ :=
  Matrix.of fun s s' => chainMatrix Ψ s s' * Real.exp (slotDist δ₀ T s s' / lam)

theorem weightedChainMatrix_nonneg (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) (lam : ℝ) (s s' : Slot δ₀ T) :
    0 ≤ weightedChainMatrix Ψ lam s s' := by
  rw [weightedChainMatrix, Matrix.of_apply]
  exact mul_nonneg (chainMatrix_nonneg Ψ s s') (Real.exp_pos _).le

theorem chainWeight_nonneg (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) (lam : ℝ) : 0 ≤ chainWeight Ψ lam :=
  Real.iSup_nonneg fun s => Finset.sum_nonneg fun s' _ => mul_nonneg (chainMatrix_nonneg Ψ s s') (Real.exp_pos _).le

theorem rowSum_weightedChainMatrix_le (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) (lam : ℝ) (s : Slot δ₀ T) :
    ∑ s' : Slot δ₀ T, weightedChainMatrix Ψ lam s s' ≤ chainWeight Ψ lam := by
  simp only [weightedChainMatrix, Matrix.of_apply]
  exact le_ciSup (f := fun s => ∑ s' : Slot δ₀ T, chainMatrix Ψ s s' * Real.exp (slotDist δ₀ T s s' / lam))
    (Finite.bddAbove_range _) s

theorem pow_apply_le_weighted (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) {lam : ℝ} (hlam : 0 < lam) (n : ℕ)
    (s s' : Slot δ₀ T) :
    (chainMatrix Ψ ^ n) s s' ≤ Real.exp (-slotDist δ₀ T s s' / lam) * (weightedChainMatrix Ψ lam ^ n) s s' := by
  induction n generalizing s with
  | zero =>
    simp only [pow_zero, Matrix.one_apply]
    split_ifs with h
    · subst h
      rw [slotDist_self, neg_zero, zero_div, Real.exp_zero, one_mul]
    · simp
  | succ n ih =>
    rw [pow_succ', pow_succ', Matrix.mul_apply, Matrix.mul_apply, Finset.mul_sum]
    refine Finset.sum_le_sum fun s'' _ => ?_
    have hX := pow_apply_nonneg (weightedChainMatrix_nonneg Ψ lam) n s'' s'
    have hM := chainMatrix_nonneg Ψ s s''
    have htri := slotDist_triangle s s'' s'
    have hexp : Real.exp (-slotDist δ₀ T s'' s' / lam) ≤
        Real.exp (slotDist δ₀ T s s'' / lam) * Real.exp (-slotDist δ₀ T s s' / lam) := by
      rw [← Real.exp_add]
      apply Real.exp_le_exp.mpr
      rw [← add_div, div_le_div_iff_of_pos_right hlam]
      linarith
    calc chainMatrix Ψ s s'' * (chainMatrix Ψ ^ n) s'' s'
        ≤ chainMatrix Ψ s s'' * (Real.exp (-slotDist δ₀ T s'' s' / lam) * (weightedChainMatrix Ψ lam ^ n) s'' s') :=
          mul_le_mul_of_nonneg_left (ih s'') hM
      _ ≤ chainMatrix Ψ s s'' * (Real.exp (slotDist δ₀ T s s'' / lam) * Real.exp (-slotDist δ₀ T s s' / lam) *
            (weightedChainMatrix Ψ lam ^ n) s'' s') :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hexp hX) hM
      _ = Real.exp (-slotDist δ₀ T s s' / lam) *
            (weightedChainMatrix Ψ lam s s'' * (weightedChainMatrix Ψ lam ^ n) s'' s') := by
          rw [weightedChainMatrix, Matrix.of_apply]
          ring

theorem expNegDiv_nonneg (d : ℝ≥0∞) (lam : ℝ) : 0 ≤ expNegDiv d lam := by
  unfold expNegDiv
  split_ifs
  · exact le_rfl
  · exact (Real.exp_pos _).le

theorem exp_le_expNegDiv {lam : ℝ} (hlam : 0 < lam) (s : Slot δ₀ T) {W : Finset (Slot δ₀ T)} {s' : Slot δ₀ T}
    (hs' : s' ∈ W) : Real.exp (-slotDist δ₀ T s s' / lam) ≤ expNegDiv (slotSetDist {s} W) lam := by
  have hW : W.Nonempty := ⟨s', hs'⟩
  rw [slotSetDist_eq_inf' (Finset.singleton_nonempty s) hW]
  have hinf : 0 ≤ ({s} ×ˢ W).inf' ((Finset.singleton_nonempty s).product hW)
      (fun p => slotDist δ₀ T p.1 p.2) :=
    Finset.le_inf' _ _ fun p _ => slotDist_nonneg' _ _
  rw [expNegDiv_ofReal hinf]
  apply Real.exp_le_exp.mpr
  apply div_le_div_of_nonneg_right _ hlam.le
  apply neg_le_neg
  have hmem : ((s, s') : Slot δ₀ T × Slot δ₀ T) ∈ ({s} : Finset (Slot δ₀ T)) ×ˢ W :=
    Finset.mem_product.mpr ⟨Finset.mem_singleton_self s, hs'⟩
  exact Finset.inf'_le (fun p : Slot δ₀ T × Slot δ₀ T => slotDist δ₀ T p.1 p.2) hmem

theorem sum_pow_le_weighted (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) {lam : ℝ} (hlam : 0 < lam) (n : ℕ)
    (s : Slot δ₀ T) (W : Finset (Slot δ₀ T)) :
    ∑ s' ∈ W, (chainMatrix Ψ ^ n) s s' ≤ chainWeight Ψ lam ^ n * expNegDiv (slotSetDist {s} W) lam := by
  have hE0 := expNegDiv_nonneg (slotSetDist {s} W) lam
  have hP : ∀ s', 0 ≤ (weightedChainMatrix Ψ lam ^ n) s s' := fun s' =>
    pow_apply_nonneg (weightedChainMatrix_nonneg Ψ lam) n s s'
  calc ∑ s' ∈ W, (chainMatrix Ψ ^ n) s s'
      ≤ ∑ s' ∈ W, expNegDiv (slotSetDist {s} W) lam * (weightedChainMatrix Ψ lam ^ n) s s' :=
        Finset.sum_le_sum fun s' hs' => (pow_apply_le_weighted Ψ hlam n s s').trans
          (mul_le_mul_of_nonneg_right (exp_le_expNegDiv hlam s hs') (hP s'))
    _ = expNegDiv (slotSetDist {s} W) lam * ∑ s' ∈ W, (weightedChainMatrix Ψ lam ^ n) s s' := by
        rw [Finset.mul_sum]
    _ ≤ expNegDiv (slotSetDist {s} W) lam * ∑ s' : Slot δ₀ T, (weightedChainMatrix Ψ lam ^ n) s s' :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          fun s' _ _ => hP s') hE0
    _ ≤ expNegDiv (slotSetDist {s} W) lam * chainWeight Ψ lam ^ n :=
        mul_le_mul_of_nonneg_left (rowSum_pow_le_of (weightedChainMatrix_nonneg Ψ lam) (chainWeight_nonneg Ψ lam)
          (rowSum_weightedChainMatrix_le Ψ lam) n s) hE0
    _ = _ := mul_comm _ _

/-- **(B.4)**: "`Summing the exponential series, for every $t\in\R$,`"
"`\sum_{s'\in W}\bigl[e^{2\abs tM}\bigr]_{ss'}\le e^{2\abs tC}e^{-d(s,W)/\lambda},\qquad \sum_{s'\in W}\bigl[e^{2\abs tM}-\one\bigr]_{ss'}\le\bigl(e^{2\abs tC}-1\bigr)e^{-d(s,W)/\lambda}.`"
— with `M = M^Ψ`, `C = C(Ψ, λ)`, "`for every slot $s$, every $W\subset\Slots$`". -/
theorem rowSum_exp_chainMatrix_le (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) {lam : ℝ} (hlam : 0 < lam)
    (s : Slot δ₀ T) (W : Finset (Slot δ₀ T)) (t : ℝ) :
    ∑ s' ∈ W, NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) s s' ≤
        Real.exp (2 * |t| * chainWeight Ψ lam) * expNegDiv (slotSetDist {s} W) lam ∧
      ∑ s' ∈ W, (NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) - 1) s s' ≤
        (Real.exp (2 * |t| * chainWeight Ψ lam) - 1) * expNegDiv (slotSetDist {s} W) lam := by
  have hx : 0 ≤ 2 * |t| := by positivity
  have hterm : ∀ (j : ℕ) (s' : Slot δ₀ T), ((j.factorial : ℝ)⁻¹) * (((2 * |t|) • chainMatrix Ψ) ^ j) s s' =
      (2 * |t|) ^ j / (j.factorial : ℝ) * (chainMatrix Ψ ^ j) s s' := by
    intro j s'
    rw [smul_pow, Matrix.smul_apply, smul_eq_mul]
    ring
  have hf : HasSum (fun j : ℕ => (2 * |t|) ^ j / (j.factorial : ℝ) * ∑ s' ∈ W, (chainMatrix Ψ ^ j) s s')
      (∑ s' ∈ W, NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) s s') := by
    have h := hasSum_sum (s := W) fun s' _ => hasSum_exp_matrix_apply ((2 * |t|) • chainMatrix Ψ) s s'
    simp only [hterm, ← Finset.mul_sum] at h
    exact h
  have hg0 : HasSum (fun j : ℕ => ((j.factorial : ℝ)⁻¹) • (2 * |t| * chainWeight Ψ lam) ^ j)
      (Real.exp (2 * |t| * chainWeight Ψ lam)) := by
    rw [Real.exp_eq_exp_ℝ]
    exact NormedSpace.exp_series_hasSum_exp' (𝕂 := ℝ) (2 * |t| * chainWeight Ψ lam)
  have hg : HasSum (fun j : ℕ => (2 * |t|) ^ j / (j.factorial : ℝ) *
        (chainWeight Ψ lam ^ j * expNegDiv (slotSetDist {s} W) lam))
      (Real.exp (2 * |t| * chainWeight Ψ lam) * expNegDiv (slotSetDist {s} W) lam) := by
    convert hg0.mul_right (expNegDiv (slotSetDist {s} W) lam) using 1
    funext j
    rw [smul_eq_mul, mul_pow]
    ring
  have hle : ∀ j : ℕ, (2 * |t|) ^ j / (j.factorial : ℝ) * ∑ s' ∈ W, (chainMatrix Ψ ^ j) s s' ≤
      (2 * |t|) ^ j / (j.factorial : ℝ) * (chainWeight Ψ lam ^ j * expNegDiv (slotSetDist {s} W) lam) := fun j =>
    mul_le_mul_of_nonneg_left (sum_pow_le_weighted Ψ hlam j s W) (div_nonneg (pow_nonneg hx _) (Nat.cast_nonneg _))
  refine ⟨hasSum_le hle hf hg, ?_⟩
  have hf1 := (hasSum_nat_add_iff' 1).mpr hf
  have hg1 := (hasSum_nat_add_iff' 1).mpr hg
  have h1 := hasSum_le (fun j => hle (j + 1)) hf1 hg1
  simp only [Finset.sum_range_one, pow_zero, Nat.factorial_zero, Nat.cast_one, div_one, one_mul] at h1
  have e : ∑ s' ∈ W, (NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) - 1) s s' =
      ∑ s' ∈ W, NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) s s' -
        ∑ s' ∈ W, (1 : Matrix (Slot δ₀ T) (Slot δ₀ T) ℝ) s s' := by
    simp only [Matrix.sub_apply, Finset.sum_sub_distrib]
  rw [e]
  calc _ ≤ Real.exp (2 * |t| * chainWeight Ψ lam) * expNegDiv (slotSetDist {s} W) lam -
        expNegDiv (slotSetDist {s} W) lam := h1
    _ = _ := by ring

/-! ### Proof device for the weighted bounds (phase (b); not a statement of the paper) -/

theorem weighted_of_matrix (Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)) {lam : ℝ} (hlam : 0 < lam)
    (X Y : Finset (Slot δ₀ T)) (t : ℝ) {K : ℝ} (hK : 0 ≤ K) :
    K * ∑ s ∈ X, ∑ s' ∈ Y, NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) s s' ≤
        K * Real.exp (2 * |t| * chainWeight Ψ lam) * ∑ s ∈ X, expNegDiv (slotSetDist {s} Y) lam ∧
      K * ∑ s ∈ X, ∑ s' ∈ Y, (NormedSpace.exp ((2 * |t|) • chainMatrix Ψ) - 1) s s' ≤
        K * (Real.exp (2 * |t| * chainWeight Ψ lam) - 1) * ∑ s ∈ X, expNegDiv (slotSetDist {s} Y) lam := by
  constructor
  · calc _ ≤ K * ∑ s ∈ X, Real.exp (2 * |t| * chainWeight Ψ lam) * expNegDiv (slotSetDist {s} Y) lam :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun s _ => (rowSum_exp_chainMatrix_le Ψ hlam s Y t).1) hK
      _ = _ := by rw [← Finset.mul_sum]; ring
  · calc _ ≤ K * ∑ s ∈ X, (Real.exp (2 * |t| * chainWeight Ψ lam) - 1) * expNegDiv (slotSetDist {s} Y) lam :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun s _ => (rowSum_exp_chainMatrix_le Ψ hlam s Y t).2) hK
      _ = _ := by rw [← Finset.mul_sum]; ring

/-- **Theorem 5.2**: "`Then`" "`\norm{[\tau^\Psi_t(A),B]}\le2\norm A\norm B\,e^{2\abs tC(\Psi,\lambda)}\sum_{s\in X}e^{-d(s,Y)/\lambda},`" -/
theorem lieb_robinson_weighted {Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)} (hΨ : IsEvenInteraction Ψ)
    {X Y : Finset (Slot δ₀ T)} {A B : Op (Slot δ₀ T)}
    (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) {lam : ℝ} (hlam : 0 < lam) (t : ℝ) :
    ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      2 * ‖opCLM A‖ * ‖opCLM B‖ * Real.exp (2 * |t| * chainWeight Ψ lam) *
        ∑ s ∈ X, expNegDiv (slotSetDist {s} Y) lam := by
  exact (lieb_robinson hΨ hAB t).trans (weighted_of_matrix Ψ hlam X Y t (by positivity)).1

/-- **Theorem 5.2**: "`and $e^{2\abs tC(\Psi,\lambda)}$ may be replaced by $e^{2\abs tC(\Psi,\lambda)}-1$ if $X\cap Y=\emptyset$.`" -/
theorem lieb_robinson_weighted_of_disjoint {Ψ : Finset (Slot δ₀ T) → Op (Slot δ₀ T)} (hΨ : IsEvenInteraction Ψ)
    {X Y : Finset (Slot δ₀ T)} {A B : Op (Slot δ₀ T)}
    (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) (hXY : Disjoint X Y) {lam : ℝ} (hlam : 0 < lam)
    (t : ℝ) :
    ‖opCLM (dyn (hamTot Ψ) t A * B - B * dyn (hamTot Ψ) t A)‖ ≤
      2 * ‖opCLM A‖ * ‖opCLM B‖ * (Real.exp (2 * |t| * chainWeight Ψ lam) - 1) *
        ∑ s ∈ X, expNegDiv (slotSetDist {s} Y) lam := by
  exact (lieb_robinson_of_disjoint hΨ hAB hXY t).trans (weighted_of_matrix Ψ hlam X Y t (by positivity)).2

/-- **Theorem 5.2**, the last sentence, for the weighted bounds: "`Both bounds remain valid, with the same matrix $M^\Psi$, for the dynamics of any interaction obtained from $\Psi$ by setting some of its terms to zero.`"
— with `C(Ψ, λ)` of `Ψ` (the proof: "`and $C(\Psi',\lambda)\le C(\Psi,\lambda)$`"). -/
theorem lieb_robinson_weighted_of_terms_zero {Ψ Ψ' : Finset (Slot δ₀ T) → Op (Slot δ₀ T)}
    (hΨ : IsEvenInteraction Ψ) (hΨ' : ∀ Z : Finset (Slot δ₀ T), Ψ' Z = Ψ Z ∨ Ψ' Z = 0)
    {X Y : Finset (Slot δ₀ T)} {A B : Op (Slot δ₀ T)}
    (hAB : (A ∈ CAR X ∧ B ∈ Alg Y) ∨ (A ∈ Alg X ∧ B ∈ CAR Y)) {lam : ℝ} (hlam : 0 < lam) (t : ℝ) :
    ‖opCLM (dyn (hamTot Ψ') t A * B - B * dyn (hamTot Ψ') t A)‖ ≤
        2 * ‖opCLM A‖ * ‖opCLM B‖ * Real.exp (2 * |t| * chainWeight Ψ lam) *
          ∑ s ∈ X, expNegDiv (slotSetDist {s} Y) lam ∧
      (Disjoint X Y → ‖opCLM (dyn (hamTot Ψ') t A * B - B * dyn (hamTot Ψ') t A)‖ ≤
        2 * ‖opCLM A‖ * ‖opCLM B‖ * (Real.exp (2 * |t| * chainWeight Ψ lam) - 1) *
          ∑ s ∈ X, expNegDiv (slotSetDist {s} Y) lam) := by
  obtain ⟨h1, h2⟩ := lieb_robinson_of_terms_zero hΨ hΨ' hAB t
  exact ⟨h1.trans (weighted_of_matrix Ψ hlam X Y t (by positivity)).1,
    fun hXY => (h2 hXY).trans (weighted_of_matrix Ψ hlam X Y t (by positivity)).2⟩

end SlotLattice

end HRTorus.Locality
